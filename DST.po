msgstr "Мне лучше подвести лодку поближе к стартовой вышке."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_YOTD_NOCHECKPOINTS
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_YOTD_NOCHECKPOINTS"
