msgstr "Давай, Берни!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERNIE_INACTIVE.BROKEN"
