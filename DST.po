msgstr "Ещё один вид дёрна."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_MUD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_MUD"
msgid "Yet another ground type."
msgstr "Ещё один вид дёрна."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_PEBBLEBEACH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_PEBBLEBEACH"
msgid "A chunk of beach."
msgstr "Кусок пляжа."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_ROAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_ROAD"
msgid "Hastily cobbled stones."
msgstr "Небрежно отёсанные камни."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_ROCKY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_ROCKY"
msgid "A chunk of ground."
msgstr "Пласт земли."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_RUINSBRICK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_RUINSBRICK"
msgid "Yet another ground type."
msgstr "Ещё один вид дёрна."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_RUINSBRICK_GLOW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_RUINSBRICK_GLOW"
msgid "Yet another ground type."
msgstr "Ещё один вид дёрна."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_RUINSTILES
