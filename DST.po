msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.4
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.4"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.5
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.5"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.6
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.6"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.7
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.7"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.8
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.8"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.9
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.9"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_COLD"
msgid "I am chilled to the bone."
msgstr "Я продрогла до костей."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_COMPASS_OUT"
msgid "It feels the force of the earth no more."
msgstr "Он более не в силах поддержать ничтожную ту силу, что с землёй связует."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_COZY_SLEEP"
msgid "Such a peaceful slumber... but now I must wake."
msgstr "Такой мирный сон... но теперь я должна проснуться."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_CRAFTING_FAIL"
msgid "I lack the necessary materials."
msgstr "Мне не хватает некоторых материалов."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DAMP"
msgid "Soggy and sad."
msgstr "Сыро и уныло."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DEERCLOPS"
msgid "That could be bad."
msgstr "Это может плохо закончиться."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DESPAWN"
msgid "Abigail?"
msgstr "Абигейл?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "My strength is fading."
msgstr "Мои силы покидают меня."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "The storm has passed."
msgstr "Буря прошла."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "Once more I'm left defenseless against the elements."
msgstr "И снова я остаюсь беззащитной перед стихией."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "Ah. It couldn't last."
msgstr "Ах. Долго оно не продержалось."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE"
msgid "I'm sorry... I'm getting so tired..."
msgstr "Простите... Я начинаю уставать..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "It seems my zeal was short-lived."
msgstr "Похоже, моё рвение было недолгим."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "Your death has been delayed another day."
msgstr "Смерть придёт за тобой в другой раз."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DUSK"
msgid "The sickly sweet scent of roses fills the air..."
msgstr "Скоро всё охватит тьма. Я должна подготовиться."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.GENERIC"
msgid "Yum!"
msgstr "Ням!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.INVALID"
msgid "I would never."
msgstr "Никогда."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.PAINFUL"
msgid "That was not edible."
msgstr "Это было несъедобно."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.SPOILED"
msgid "That food was nearing the end of its lifetime."
msgstr "Эта еда заканчивает своё существование."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.STALE"
msgid "Was that stale?"
msgstr "Оно было несвежее?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.YUCKY"
msgid "I fear consuming that."
msgstr "Я боюсь есть это."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EATING_NOT_FEASTING"
msgid "Maybe I could... join in the feast..."
msgstr "Может, я могла бы... присоединиться к банкету..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ELIXIR_BOOSTED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ELIXIR_BOOSTED"
msgid "All comfort is fleeting."
msgstr "Любой комфорт мимолётен."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ELIXIR_GHOSTVISION
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ELIXIR_GHOSTVISION"
msgid "My world is just as cold and dark without you, Abby."
msgstr "Без тебя мой мир такой же тёмный и холодный, Абби."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ELIXIR_PLAYER_SPEED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ELIXIR_PLAYER_SPEED"
msgid "My heart is still heavy."
msgstr "Тяжесть на моём сердце никуда не уйдёт."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ELIXIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ELIXIR_TOO_SUPER"
msgid "It's too much."
msgstr "Это перебор."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.1"
msgid "I must carry... my own burden..."
msgstr "Я должна нести... своё собственное бремя..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.2"
msgid "I don't... need help..."
msgstr "Мне не... нужна помощь..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.3"
msgid "Life... is a trial..."
msgstr "Жизнь... - испытание..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.4"
msgid "...huff..."
msgstr "...бесит..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.5"
msgid "Hhnnfg..."
msgstr "Хм..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.6"
msgid "...Suffering..."
msgstr "...Страдание..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.7"
msgid "I'm... okay..."
msgstr "Я... в порядке..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.8"
msgid "Don't worry... Abby... I got it..."
msgstr "Не волнуйся... Абби... Я понесу..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.9"
msgid "My heart is heavy enough... without this..."
msgstr "На моём сердце тяжело... и без этого..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENGINEERING_CAN_UPGRADE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENGINEERING_CAN_UPGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENTER_DARK"
msgid "The darkness has swallowed me."
msgstr "Тьма поглотила меня."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENTER_LIGHT"
msgid "And there was light!"
msgstr "И стал свет!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EXIT_GELBLOB"
msgid "I don't prefer a slow death."
msgstr "Вся моя жизнь пронеслась перед глазами... но я всё ещё здесь."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "The abyss gazes into me!"
msgstr "Бездна смотрит на меня в ответ!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "It's gone. And alas, I'm still here."
msgstr "Ушёл. И увы, я всё ещё здесь."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "There is never an end to the madness."
msgstr "Безумию никогда не будет конца."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FAN_OUT"
msgid "The fan has breathed its last."
msgstr "Вертушка сделала свой последний выдох."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "I suppose we will all be nourishment for plants one day."
msgstr "Полагаю, когда-нибудь мы все станем пищей для растений."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "Why should my life be anything other than pain..."
msgstr "Почему моя жизнь должна быть так полна боли..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "What a terrible poison... I feel as though I might burn up."
msgstr "Какой ужасный яд... Я будто сейчас сгорю."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "Alas, I still live."
msgstr "К сожалению, я выжила."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FLARE_SEEN"
msgid "Someone just shot a flare..."
msgstr "Кто-то только что выстрелил сигнальной ракетой..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FLOATER_HELD"
msgid "What now?"
msgstr "Что теперь?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FLOATER_LETGO"
msgid "It's time."
msgstr "Время пришло."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FLOAT_SWIM_TIRED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FLOAT_SWIM_TIRED"
msgid "Just need a rest."
msgstr "Мне нужно передохнуть."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FOODMEMORY"
msgid "only_used_by_warly"
msgstr "only_used_by_warly"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FREEDOM"
msgid "Freedom. Great."
msgstr "Свобода. Прекрасно."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GATHER_MERM"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOSTDRAIN"
msgid "The ghosts... Want to play..."
msgstr "Призраки... Хотят поиграть..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOSTLYBOND_LEVELUP.LEVEL2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOSTLYBOND_LEVELUP.LEVEL2"
msgid "You seem to have brightened up a bit, Abigail."
msgstr "Кажется, ты повеселела, Абигейл."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOSTLYBOND_LEVELUP.LEVEL3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOSTLYBOND_LEVELUP.LEVEL3"
msgid "Abigail has always been my guiding light in the darkness..."
msgstr "Абигейл всегда была моим светом в кромешной тьме..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_HINT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_HINT"
msgid "Are you showing me the way?"
msgstr "Ты указываешь мне путь?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_QUEST"
msgid "You need me to... find something you've lost?"
msgstr "Мне нужно найти что-то... что ты потерял?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.1"
msgid "It's close... I can feel it..."
msgstr "Оно близко... я чувствую..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.2"
msgid "It's calling to me... it's nearby..."
msgstr "Оно зовёт меня... оно близко..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.3"
msgid "We're almost there..."
msgstr "Мы почти на месте..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.4
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.4"
msgid "Your journey is almost over."
msgstr "Твоё приключение почти подошло к концу."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.5
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.5"
msgid "Am I getting warmer?"
msgstr "Теплее?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "The acid rain may burn my flesh once more."
msgstr "Кислотный дождь теперь снова может прожечь мою плоть."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE"
msgid "Here we are."
msgstr "Вот и мы."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT"
msgid "I'm still here..."
msgstr "Я всё ещё здесь..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HIGHRESEARCH"
msgid "I have seen the void and it is deep and dark."
msgstr "Я видела бездну и она была глубока и темна."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HOT"
msgid "I am miserably hot."
msgstr "Жара отчаянно меня снедает."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HOUNDS"
msgid "The hounds are baying."
msgstr "Гончие лают."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNGRY"
msgid "I am full of emptiness."
msgstr "В моём желудке, как и в сердце, пустота."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_AVOID_FORK"
msgid "I suppose this trail would be safer. Sigh."
msgstr "Полагаю, этот путь будет безопаснее. Вздох."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "I sense the beast's presence nearby."
msgstr "Я чувствую присутствие зверя поблизости."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "This trail leads nowhere."
msgstr "Этот след ведёт в никуда."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "No trail, just a bunch of muck."
msgstr "Следов не видно, лишь кучи грязи."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_START_FORK"
msgid "This path reeks of danger and death. Shall we?"
msgstr "От этого пути несёт опасностью и смертью. Продолжим?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "The creature hasn't seen me yet..."
msgstr "Существо пока меня не увидело..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_WRONG_FORK"
msgid "Abigail? Was that you...?"
msgstr "Абигейл? Это была ты...?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It could use a bit more."
msgstr "Ему надо бы подкинуть ещё."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_INV_FULL"
msgid "I can carry no more."
msgstr "Я не могу больше унести."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_IS_FEASTING"
msgid "This is... nice."
msgstr "Это... приятно."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "They've lost their way. Poor thing."
msgstr "Сбился с пути. Бедняжка."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "A lost soul, now found."
msgstr "Потерянная душа, теперь найдена."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "We found them, Abigail!"
msgstr "Мы нашли их, Абигейл!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "Much like death, I'll always find you."
msgstr "Я всегда найду тебя, словно твоя смерть."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "You only have yourself to blame. And your tail."
msgstr "Ты должен винить только себя. И твой хвост."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "We found them all, heeheehee!"
msgstr "Мы нашли их всех, хи-хи-хи!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "And just like that, the game is over."
msgstr "И вот так просто игра окончена."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "Do you think we'll win this, Abigail?"
msgstr "Ты думаешь, мы выиграем, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "I wasted time, and now doth time waste me"
msgstr "Я потратила время впустую, и теперь время потратит меня впустую"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "Tick tock, goes the clock."
msgstr "Тик-так, часы идут."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "No, they wouldn't have come this far..."
msgstr "Нет, они бы не зашли так далеко..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "I return from life's edge."
msgstr "Я возвращаюсь с обочины жизни."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Abigail, they're playing hide and seek. Let's go!"
msgstr "Абигейл, они играют в прятки. Пошли!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "Let the games begin."
msgstr "Да начнется игра!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Your pleas will fall on deaf ears."
msgstr "Ваши просьбы не будут услышаны."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KLAUS_ENRAGE"
msgid "Death walks among us."
msgstr "Смерть ходит среди нас."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KLAUS_UNCHAINED"
msgid "The beast returns unchained."
msgstr "Зверь сорвался с цепи."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KNOCKEDOUT"
msgid "Yet, again I wake to life. Sigh."
msgstr "Эх, опять я проснулась."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "So close to death, yet so far."
msgstr "А смерть была так близко. Однако недостаточно."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_LIGHTSOUT_SHADOWHAND
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_LIGHTSOUT_SHADOWHAND"
msgid "Like the death's own hand, come to snuff our fragile flame."
msgstr "Словно рука самой смерти, она пришла задуть наше хрупкое пламя."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_LOWRESEARCH"
msgid "Pithy knowledge..."
msgstr "Коротко и ясно..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "It remembers."
msgstr "Мы прогневали великую сущность, и скоро поплатимся за это жизнями."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_LUNARHAIL_BIRD_CORPSES
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_LUNARHAIL_BIRD_CORPSES"
msgid "Birds of a feather fall together."
msgstr "Птицы одного полёта падают вместе."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS"
msgid "Those birds are singing their last."
msgstr "Птицы поют в свой последний раз."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "I can see a light..."
msgstr "Я вижу свет..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MAX_CLOCKWORKS"
msgid "This one will be left behind."
msgstr "Его мы предадим забвению."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "The poor soul who shot that flare... they've sealed their own fate."
msgstr "Бедняга, который выстрелил этой ракетой... сам решил свою судьбу."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MONKEY_CURSE_1"
msgid "I feel... strange..."
msgstr "Чувствую себя... странно..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "Don't laugh at me Abigail! It's not funny!"
msgstr "Перестань смеяться, Абигейл! Это не смешно!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "I never imagined being glad to be myself..."
msgstr "Даже не представляла, что буду так рада снова быть собой..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "Almost."
msgstr "Почти."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "I'll get you out..."
msgstr "Я вытащу тебя..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "There."
msgstr "Вот так."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Almost."
msgstr "Почти."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "I'll get you out..."
msgstr "Я вытащу тебя..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "There."
msgstr "Вот так."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Almost."
msgstr "Почти."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "I'll get you out..."
msgstr "Я вытащу тебя..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "There."
msgstr "Вот так."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONPOTION_FAILED"
msgid "Sigh... I didn't really expect that to work."
msgstr "Эх... я и не ожидала, что это сработает."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOSQUITOS"
msgid "Mosquitoes! Let my veins be a feast!"
msgstr "Комары! Устройте пир на моих венах!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "This beast... is not long for this world."
msgstr "Эта зверюга... ей долго не протянуть."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "Buzzards. Something off about them."
msgstr "Канюки. С ними что-то не так."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODANGERGIFT"
msgid "There's no time for presents, death has finally come for me!"
msgstr "Нет времени для подарков, смерть наконец-то пришла за мной!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODANGERSIESTA"
msgid "I couldn't possibly nap. Death is nigh."
msgstr "Я не в силах уснуть, смерть приближается."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODANGERSLEEP"
msgid "I can't sleep, there's death to be had."
msgstr "Мне не до сна, я чувствую дыханье смерти."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODAYSLEEP"
msgid "The sun upsets me. I couldn't possibly sleep."
msgstr "Солнце расстраивает меня. Я не могу спать."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "I'm not tired yet."
msgstr "Я ещё не устала."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOHUNGERSIESTA"
msgid "My stomach is as empty as my heart. I can't nap now."
msgstr "Мой желудок пуст, как и моё сердце. Я не могу спать."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOHUNGERSLEEP"
msgid "My stomach is as empty as my heart. I can't sleep now."
msgstr "Мой желудок пуст, как и моё сердце. Я не могу спать."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOMOUNTEDGIFT"
msgid "Can someone help me down... I have a present to open."
msgstr "Может кто-нибудь мне помочь слезть?\n Мне подарок открыть нужно."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NONIGHTSIESTA"
msgid "I'd really rather be in a tent."
msgstr "Я бы предпочла быть сейчас в палатке."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "I'd really rather be in a tent."
msgstr "Я бы предпочла быть сейчас в палатке."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "Oh well."
msgstr "Ну что ж."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "I can't sleep if I'm not surrounded by darkness."
msgstr "Я не могу заснуть, если меня не окружает тьма."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOSLEEPONFIRE"
msgid "That'd be quite the way to go out."
msgstr "Это было бы отличным решением, если бы мне захотелось умереть."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOWARDROBEONFIRE"
msgid "Sadly, it is ablaze."
msgstr "К несчастью, весь в огне."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "I need Abby's flower to pour it on."
msgstr "Мне нужен цветок Абби, чтобы вылить это на него."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NO_TRAP"
msgid "I was expecting great difficulty."
msgstr "Думала, что будет сложнее."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Sigh. Of course."
msgstr "Эх. Естественно."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "It can't evade death forever."
msgstr "Она не сможет бежать вечно."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "It's not like I have anything better to do."
msgstr "Как будто заняться мне не чем."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "I suppose I'll just starve."
msgstr "Мне остается только голодать."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "Perhaps I will be standing here forever."
msgstr "Возможно, я буду стоять здесь вечно."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "Fishing is rather dull, I don't know why people enjoy it."
msgstr "Рыбалка довольно скучная, не понимаю, что люди в ней нашли."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Ah. Predictable."
msgstr "Ах. Предсказуемо."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "My line is too loose."
msgstr "Леска провисла."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "Death casts its black shadow upon us."
msgstr "Смерть бросает на нас свою черную тень."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OFF_SCRIPT"
msgid "Just one little mistake..."
msgstr "Всего одна маленькая ошибка..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "Everything is falling apart. Like usual."
msgstr "Всё разваливается на части. Как обычно."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "It won't survive these rough waters... perhaps I won't either."
msgstr "Оно не выживет в этих водах... возможно, и я тоже."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_PECKED"
msgid "You try my patience."
msgstr "Ты испытываешь моё терпение."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_PETRIFED_TREES"
msgid "A wave of sadness just washed over me...?"
msgstr "Что это, уж не волна ли печали только что омыла меня...?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Smells like death."
msgstr "Пахнет смертью."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_PIRATES_ARRIVE"
msgid "Nowhere to run... they're here."
msgstr "Некуда бежать... Они здесь."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_PLANT_RANDOMSEED"
msgid "It is buried. I wonder what will grow."
msgstr "Он погребён. Интересно, что вырастет?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "Well, I've learned a little more. Even if it won't do me any good."
msgstr "Что ж, сегодня я узнала что-то новое. Даже если мне это никак не понадобится."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "It looks like I survived the journey. Oh well, there's always next time."
msgstr "Похоже, я пережила это путешествие. Что ж, всегда можно попробовать снова."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_PREFALLINVOID"
msgid "It's fine..."
msgstr "Всё нормально..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_QUAKE"
msgid "The ground shakes. Will it swallow me whole?"
msgstr "Земля дрожит. Она проглотит меня целиком?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Not here."
msgstr "Не здесь."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "Something clawing it's way back from the grave?"
msgstr "Что-то пробивается обратно из могилы?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKING_LUCKY"
msgid "That's an unusual rabbit."
msgstr "Это необычный кролик."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "Got it!"
msgstr "Поймала!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKING_PASSIVE"
msgid "A gentle creature approaches."
msgstr "Приближается нежное создание."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_REPELLED"
msgid "It has spirits to protect it..."
msgstr "У него есть духи, чтобы защитить его..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_RESEARCH"
msgid "I now possess greater knowledge of this terrible world."
msgstr "Теперь я знаю больше об этом жутком мире."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "Thank-you..."
msgstr "Спасибо..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "All done."
msgstr "Всё сделано."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_REVIVING_CORPSE"
msgid "You'll not glimpse death today..."
msgstr "Ты не увидишь смерть сегодня..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY.1"
msgid "Your Majesty."
msgstr "Ваше Величество."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY.2"
msgid "Your Highness."
msgstr "Ваше Высочество."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY.3"
msgid "My kingdom for another day with her."
msgstr "Полцарства... нет, всё царство за ещё хотя бы день с ней."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY_JOKER.1"
msgid "I'm not in the mood for jokes."
msgstr "Я не в настроении для шуток."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY_JOKER.2"
msgid "Thanks for trying."
msgstr "Спасибо за попытку."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY_JOKER.3"
msgid "I only laugh to be polite."
msgstr "Я смеюсь только из вежливости."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_RUINS_RESET"
msgid "The dead are risen."
msgstr "Мертвые воскресают."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SACREDCHEST_NO"
msgid "We failed... again..."
msgstr "Мы потерпели неудачу... снова..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SACREDCHEST_YES"
msgid "It accepted our items."
msgstr "Он принял наши предметы."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SCRAPBOOK_FULL"
msgid "Nothing more will fit in my scrapbook."
msgstr "Больше ничего не поместится в моих заметках."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "Show yourself. I've seen worse."
msgstr "Покажись уже. Я видела вещи и похуже."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "That glow... does it lead to my doom?"
msgstr "Это сияние... ведет ли оно к моей гибели?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SHELTER"
msgid "Nature is good for something after all."
msgstr "В конце-то концов должна же природа как-то приносить пользу."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SISTURN_FULL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SISTURN_FULL"
msgid "Now Abigail can find her way back to me faster."
msgstr "Теперь Абигейл сможет быстрее найти дорогу обратно ко мне."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "This might be as close as we've ever come, Abigail."
msgstr "Наверное, мы ещё никогда не были так близки, Абигейл."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "This gives me goosebumps. I hope it was worth it."
msgstr "У меня от этого мурашки по коже. Надеюсь, оно того стоило."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SNARED"
msgid "I am caged!"
msgstr "Я в клетке!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SNARED_IVY"
msgid "I suppose this is how it ends..."
msgstr "Похоже, так всё и кончится..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "The ground lies barren, stripped of its winter coat."
msgstr "Земля здесь лишена своего зимнего покрова."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "There's no use rolling it more."
msgstr "Нет смысла катать его дальше."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SOAKED"
msgid "A veritable apocalypse of water."
msgstr "Настоящая водная катастрофа."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SPOOKED"
msgid "Yuck!"
msgstr "Ты видела это, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "Abigail was the one who loved the garden. She would have been better at this than me."
msgstr "Абигейл нравился огород. Она бы была лучше в этом, чем я."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "Go on then, grow if you must."
msgstr "Ну, давай расти, если хочешь."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "I'll try to make your fleeting time in this world as comfortable as I can."
msgstr "Я попытаюсь сделать твоё бренное существование в этом мире настолько удобным, насколько смогу."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "It must be so lonely, being stuck in the ground..."
msgstr "Наверное, так одиноко торчать в земле..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "Shall I stay and talk with you for a while?"
msgstr "Стоит ли мне остаться здесь и немного поговорить с тобой?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_THORNS"
msgid "Ow! Prickly, like me."
msgstr "Ай! Колючее, прям как я."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_THURIBLE_OUT"
msgid "A blessing in disguise."
msgstr "Нет худа без добра."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_ABANDONED"
msgid "This must be where we part ways. Goodbye."
msgstr "Должно быть, здесь наши пути разойдутся. Прощай."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_DEAD"
msgid "No, don't leave me...!"
msgstr "Нет, не оставляй меня...!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "He would like me to follow, so I shall."
msgstr "Он хочет, чтобы я последовала за ним, так я и сделаю."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "I've arrived a moment too late. Sigh..."
msgstr "Я пришла слишком поздно. Эх..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "I don't think we're alone here."
msgstr "Не думаю, что мы здесь одни."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "Their scent lingers here no longer."
msgstr "Их запах здесь больше не витает."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_START_TRACKING"
msgid "He knows where they are, we should follow."
msgstr "Он знает, где они, мы должны следовать за ним."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "He waits in gloom for me, I should return."
msgstr "Он ждет меня во мраке, я должна вернуться."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOADESCAPED"
msgid "It's gone. The earth swallowed it whole..."
msgstr "Земля полностью её поглотила."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOADESCAPING"
msgid "I hope it doesn't try to escape..."
msgstr "Я надеюсь, она не пытается сбежать..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOOL_SLIP"
msgid "Oh well, I didn't need it anyways."
msgstr "Оу... Всё равно мне это не нужно."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOOL_TOOWEAK"
msgid "It's not strong enough... like me..."
msgstr "Недостаточно силён... как и я..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TORCH_OUT"
msgid "Darkness has returned!"
msgstr "Тьма возвратилась!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "Did I die?"
msgstr "Я умерла?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TRAP_WENT_OFF"
msgid "Oh, goodness."
msgstr "Боже мой!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_UNIMPLEMENTED"
msgid "Ouch. That was unnecessary."
msgstr "Ай. Это было лишним."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING"
msgid "What now?"
msgstr "Не работает? Вот и всё, поджигай."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WASHED_ASHORE"
msgid "Oh good... I lived."
msgstr "О, прекрасно... я выжила."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WEAK_RAT"
msgid "The poor creature is too far gone."
msgstr "Бедное создание зашло слишком далеко."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WEAPON_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WEAPON_TOOWEAK"
msgid "This is futile. I need something stronger."
msgstr "Бесполезно. Нужно что-то мощнее."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "Вес: {weight}"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nBurdened with yet another terrible weight..."
msgstr "Вес: {weight}\nЕщё один ужасный груз на душе..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WENDY_BABYSITTER_SET
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WENDY_BABYSITTER_SET"
msgid "I'll come back for you, Abby."
msgstr "Я вернусь за тобой, Абби."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WENDY_BABYSITTER_STOP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WENDY_BABYSITTER_STOP"
msgid "Abby, let's go!"
msgstr "Пойдём, Абби!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WET"
msgid "Even wetter than when I cry myself to sleep."
msgstr "Влажнее, чем от моих слёз во сне."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WETTER"
msgid "An eternity of moisture and sorrow."
msgstr "Вечность во влаге и тоске."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WINCH_CLAW_MISS"
msgid "Everything always seems just out of my grasp..."
msgstr "Всё всегда кажется вне моей досягаемости..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "Just emptiness."
msgstr "Просто пустота."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "I feel... warm..."
msgstr "Я чувствую себя... теплее..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "Everything fades."
msgstr "Всё исчезает."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_BEGIN_COACHING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_BEGIN_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_END_COACHING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_END_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_MIGHTY_COACHING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_MIGHTY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_NOTEAM.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_NOTEAM.1"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_NOTEAM.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_NOTEAM.2"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_NOTEAM.3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_NOTEAM.3"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_WIMPY_COACHING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_WIMPY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WORMHOLE"
msgid "I emerge into this world once more."
msgstr "Я оказалась в этом мире снова."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WORMS"
msgid "Uh-oh. I think we should leave."
msgstr "Ой-ой. Я думаю, что мы должны уйти."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WORMS_BOSS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WORMS_BOSS"
msgid "We need to go. Now."
msgstr "Надо уходить. Сейчас же."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT"
msgid "That got us nowhere."
msgstr "И куда это меня привело? Никуда."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WX_SCANNER_NEW_FOUND
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WX_SCANNER_NEW_FOUND"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTB_LEARN_NEW_PATTERN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTB_LEARN_NEW_PATTERN"
msgid "Oh. Maybe I could try making this new costume..."
msgstr "О. Может, я могла бы попробовать сделать этот новый костюм..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTD_NOBOATS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTD_NOBOATS"
msgid "The starting point is too far away..."
msgstr "Начальная точка слишком далеко..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTD_NOCHECKPOINTS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTD_NOCHECKPOINTS"
msgid "No checkpoints... I suppose I can't do anything right."
msgstr "Без контрольных точек... Я не могу ничего сделать правильно."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTD_NOTENOUGHBOATS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTD_NOTENOUGHBOATS"
msgid "This place is too cluttered... there's hardly room to breathe..."
msgstr "Это место слишком забито... не продохнуть..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTH_ONCOOLDOWN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTH_ONCOOLDOWN"
msgid "The knights must not be ready to return yet."
msgstr "Похоже, рыцари пока не готовы вернуться."

#. STRINGS.CHARACTERS.WENDY.ANOUNCE_MUTATED_BIRD_ATTACK
msgctxt "STRINGS.CHARACTERS.WENDY.ANOUNCE_MUTATED_BIRD_ATTACK"
msgid "Let them come."
msgstr "Пускай подходят."

#. STRINGS.CHARACTERS.WENDY.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WENDY.BATTLECRY.DEER"
msgid "Your life is mine!"
msgstr "Твоя жизнь моя!"

#. STRINGS.CHARACTERS.WENDY.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.BATTLECRY.GENERIC"
msgid "Death will find you!"
msgstr "Смерть настигнет тебя!"

#. STRINGS.CHARACTERS.WENDY.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WENDY.BATTLECRY.PIG"
msgid "Let death embrace you!"
msgstr "Отправляйся в объятия смерти!"

#. STRINGS.CHARACTERS.WENDY.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WENDY.BATTLECRY.PREY"
msgid "Suffer, worm!"
msgstr "Страдай, ничтожный червь!"

#. STRINGS.CHARACTERS.WENDY.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WENDY.BATTLECRY.SPIDER"
msgid "I shall send you to the other side!"
msgstr "Я отправлю тебя на тот свет!"

#. STRINGS.CHARACTERS.WENDY.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WENDY.BATTLECRY.SPIDER_WARRIOR"
msgid "I will be your end!"
msgstr "Я стану твоей смертью!"

#. STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.GENERIC"
msgid "You shall live. For now."
msgstr "Можешь жить. Пока что."

#. STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.PIG"
msgid "You've eluded death today, beast."
msgstr "На этот раз ты избежал смерти, зверь."

#. STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.PREY"
msgid "You'll appreciate the gift of life better now."
msgstr "Теперь ты будешь сильнее ценить дар жизни."

#. STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.SPIDER"
msgid "You should be thankful I'm sparing you."
msgstr "Ты должен быть благодарен за то, что я пощадила тебя."

#. STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "I won't forget this."
msgstr "Я этого не забуду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "It was so lonely without you here."
msgstr "Без тебя здесь было так одиноко."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "That's my twin sister, Abigail."
msgstr "Это моя сестра-близнец, Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "We'll never be apart again."
msgstr "Мы никогда больше не расстанемся."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "That's my twin sister, Abigail."
msgstr "Это моя сестра-близнец, Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "Let's play, Abigail!"
msgstr "Давай поиграем, Абигейл!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "That's my twin sister, Abigail."
msgstr "Это моя сестра-близнец, Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "It's still so pretty."
msgstr "Он всё ещё так красив."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "I need to show Abigail how to play."
msgstr "Мне нужно научить Абигейл играть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "Abigail is ready to play, but she needs some space."
msgstr "Абигейл готова поиграть, но ей нужно много места."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "It was my sister's flower. She's gone far away."
msgstr "Это был цветок моей сестры. Она ушла... далеко."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "I can sense Abigail's spirit growing stronger."
msgstr "Я чувствую, как дух Абигейл становится сильнее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "Abigail! Are you ready to play?"
msgstr "Абигейл! Ты готова играть?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid ""
msgstr "<пусто>"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "I can sense Abigail's presence growing stronger."
msgstr "Я чувствую всё возрастающее присутствие Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "Abigail is almost here!"
msgstr "Абигейл уже почти тут!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED"
msgid "It follows."
msgstr "Оно следует."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABYSSPILLAR_MINION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABYSSPILLAR_MINION.GENERIC"
msgid "A lifeless statue."
msgstr "Безжизненная статуя."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABYSSPILLAR_TRIAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABYSSPILLAR_TRIAL"
msgid "Shall we?"
msgstr "Вперёд?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "I've never much cared for metaphor."
msgstr "В голову не приходит ни одной достойной метафоры..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ACORN"
msgid "A tiny life, ensconced in brittle death."
msgstr "Крохотная жизнь приютилась в хрупкой смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ACORN_COOKED"
msgid "Roasted dead."
msgstr "Зажаренные покойники."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ACORN_SAPLING"
msgid "A tree will grow soon."
msgstr "Скоро вырастет дерево."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ADVENTURE_PORTAL"
msgid "What technological terror is this?"
msgstr "Что это за технологический ужас?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIANHAT"
msgid "When I wear it, i-it's harder to see Abigail..."
msgstr "В ней становится т-так трудно различить Абигейл..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "It broke apart."
msgstr "Она раскололась на части."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "It's draining the life from that creature..."
msgstr "Он высасывает жизнь из этого существа..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Even the mighty must fall."
msgstr "Даже самые могущественные должны пасть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "We've brought on our own demise."
msgstr "Мы сами навлекли на себя гибель."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "The ball of death burns brighter than ever."
msgstr "Он всё помнит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "It was so beautiful at its core."
msgstr "В своей сути он был так прекрасен."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "Will it rise again, I wonder?"
msgstr "Поднимется ли он снова, интересно?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "It is not through yet."
msgstr "Это ещё не конец."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "Oh... it missed."
msgstr "О... он промахнулся."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "It's beautiful..."
msgstr "Он прекрасен..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "Nothing can escape death for long."
msgstr "Ничто не сможет избежать смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "Perhaps now death has finally claimed it."
msgstr "Возможно, теперь смерть, наконец, забрала его."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "It beckons me with the promise of endless slumber..."
msgstr "Она манит меня обещанием бесконечного сна..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "So much pain."
msgstr "Сколько боли."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.AMULET"
msgid "I wonder who used to own this."
msgstr "Гадаю, кому он мог принадлежать..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCHOR"
msgid "For when I feel I can go no further."
msgstr "Когда пойму, что дальше пути нет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCHOR_ITEM"
msgid "It's for a burdensome boat anchor."
msgstr "Для обременительного лодочного якоря."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "A fruit that offers no sweetness."
msgstr "Фрукт, в котором нет сладости."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "It's still beating..."
msgstr "Всё ещё бьётся..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "It beats no more."
msgstr "Она больше не бьётся."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "Burning from the inside... it must be agony."
msgstr "Горит изнутри... должно быть, это настоящая агония."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "It's been put out of its misery."
msgstr "Оно было избавлено от страданий."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "It is touched by darkness."
msgstr "К нему прикоснулась тьма."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "This tree was put to rest."
msgstr "Это дерево было похоронено."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "Maybe if you're lucky, you'll get the chance to grow up."
msgstr "Может, если тебе повезёт, у тебя будет шанс вырасти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "Perhaps it will grow next season. I can wait."
msgstr "Может, оно вырастет в другое время. Я могу подождать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "This doesn't feel like its final resting place."
msgstr "Это не похоже на место его последнего упокоения."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "Don't worry. I'll bury you."
msgstr "Не волнуйся. Я тебя похороню."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SEED"
msgid "Its future is unknown. Much like the rest of us."
msgstr "Его будущее неизвестно. Как и у всех нас."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENT_ALTAR"
msgid "It is full of the echoes of the dead."
msgstr "От неё доносится призрачный шёпот мёртвых."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "I hear the painful echoes of the dead."
msgstr "Здесь слышны голоса мёртвых."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENT_HUSK"
msgid "That's dark even for me."
msgstr "Мрачно, даже для меня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENT_STATUE"
msgid "Not very attractive."
msgstr "Не слишком привлекательно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANIMAL_TRACK"
msgid "Signs of the beast."
msgstr "Знаки зверя."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTCHOVIES"
msgid "Death would be a kindness."
msgstr "Смерть стала бы любезностью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLION.GENERIC"
msgid "Do you know any riddles?"
msgstr "Знаете ли вы какие-нибудь загадки?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLION.UNHAPPY"
msgid "A deep rage brews within..."
msgstr "Глубокая ярость варится внутри..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLION.VERYHAPPY"
msgid "The gifts made it happier..."
msgstr "Подарки сделали его счастливее..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLIONHAT"
msgid "A crown fit for a queen of dirt."
msgstr "Корона, достойная королевы грязи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLIONTRINKET"
msgid "If only I could kick it."
msgstr "Если бы я могла его разбить."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "I suppose I'm to be crushed by a bug... an ironic end."
msgstr "Похоже, мне уготовано быть раздавленной жуком... ироничный конец."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "It's dead."
msgstr "Она мертва."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "Burnt to a crisp."
msgstr "Сожжено дотла."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "Whatever's in there isn't dead yet."
msgstr "Что бы там ни варилось, оно ещё не до конца умерло."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "It needs to boil."
msgstr "Оно должно закипеть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Finally, food."
msgstr "Наконец-то, еда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "It's covered in dust."
msgstr "Покрыт пылью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "How am I to get it open? Perhaps the key is nearby."
msgstr "И как мне его открыть? Может, где-то рядом есть ключ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "All the knowledge in the world won't bring Abigail back."
msgstr "Все знания в мире не смогут вернуть Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "Devoid of life. Like everything in this place."
msgstr "Лишён жизни. Как и всё в этом месте."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "This place feels rather like a tomb."
msgstr "Это место больше похоже на гробницу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "Abigail was better at these things."
msgstr "Абигейл лучше в таком разбиралась."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "Not everything can come back so easily."
msgstr "Не всё можно вернуть так просто."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "It's long dead."
msgstr "Давно мёртв."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "All paths lead to suffering."
msgstr "Все пути ведут к страданиям."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "There's nothing left to look for."
msgstr "Нечего больше искать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "The ones who designed it are long dead."
msgstr "Те, кто создали его, давно мертвы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "Words of a dead language."
msgstr "Слова мёртвого языка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "It was important enough to carve into stone, but we'll never know the meaning."
msgstr "Это было что-то достаточно важное, чтобы быть высеченным на камне, но мы никогда не поймём его значение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "What a pity."
msgstr "Как жаль."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "It was important enough to carve into stone, but we'll never know the meaning."
msgstr "Это было что-то достаточно важное, чтобы быть высеченным на камне, но мы никогда не поймём его значение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "What a pity."
msgstr "Как жаль."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "How sad... there's nobody left to guard."
msgstr "Как грустно... некого больше охранять."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "There's no life in it."
msgstr "В нём нет жизни."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "Where are you going?"
msgstr "Куда ты направляешься?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "It's not yet whole."
msgstr "Оно ещё не цело."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "It already has its treasure."
msgstr "У него уже есть своё сокровище."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORDRAGONFLY"
msgid "I'd wear it inside-out."
msgstr "Я хотела бы надеть это шиворот-навыворот."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORDREADSTONE"
msgid "Let the darkness surround me."
msgstr "Пусть тьма окружает меня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORGRASS"
msgid "To prolong the inevitable."
msgstr "Я лишь оттягиваю неизбежное."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORMARBLE"
msgid "Could stop the daggers that stab at mine heart."
msgstr "Остановит кинжалы, направленные в моё сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORRUINS"
msgid "A reprieve from death."
msgstr "Это немного отсрочит мою смерть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORSKELETON"
msgid "I shall wrap myself in death's sweet embrace."
msgstr "Я обернусь в сладкие объятия смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORSLURPER"
msgid "A clinging, dreary, living suit."
msgstr "Облегающий, мрачный, живой пояс."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORSNURTLESHELL"
msgid "A suit to hide from one's problems."
msgstr "Теперь я могу прятаться от своих проблем."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORWAGPUNK"
msgid "Even the thickest metal couldn't protect my heart."
msgstr "Даже самый плотный металл не защитит моё сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORWOOD"
msgid "To hold off the inevitable a bit longer."
msgstr "Этим можно лишь чуточку отсрочить неизбежное."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_BRAMBLE"
msgid "So my outside matches my inside."
msgstr "Теперь моя внешность совпадает с моим внутренним миром."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_CARROTLURE"
msgid "I assume it only comes in orange."
msgstr "Полагаю, она бывает только оранжевого цвета."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_LUNARPLANT"
msgid "Shining armor, but no knight to save us."
msgstr "Сияющая броня, но никакой рыцарь нас не спасёт."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "I'd find it useful if I feared death."
msgstr "Я бы нашла это полезным, если бы я боялась смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_SANITY"
msgid "A perfectly safe way to go insane."
msgstr "Самый безопасный способ сойти с ума."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "This ragged cloak will either protect me, or be my shroud."
msgstr "Этот рваный плащ либо защитит меня, либо станет моей пеленой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "It's beautiful armor."
msgstr "Красивые доспехи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Transient, indeed."
msgstr "Ненадолго, увы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "A mark is made, however transient."
msgstr "Мой след оставлен, впрочем ненадолго."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "Its blank face shall soon offer a secret."
msgstr "Пустое место так и тянет начертать секреты."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Transient, indeed."
msgstr "Ненадолго, увы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "A mark is made, however transient."
msgstr "Мой след оставлен, впрочем ненадолго."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "Its blank face shall soon offer a secret."
msgstr "Пустое место так и тянет начертать секреты."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASH.GENERIC"
msgid "All that's left after another beautiful fire."
msgstr "Всё, что осталось от ещё одного прекрасного огня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "The eyebone was incinerated in the teleportation!"
msgstr "Костеглаз был кремирован, когда я телепортировалась!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "The flower was incinerated in the teleportation!"
msgstr "Цветок был кремирован, когда я телепортировалась!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "This was once some thing before it got burned..."
msgstr "Это было чем-то нужным, до того как оно сгорело..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUS"
msgid "Vegetables are good for you, but what do I care?"
msgstr "Овощи полезны для организма, но разве мне не всё равно?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUSSOUP"
msgid "Soup."
msgstr "Суп."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUS_COOKED"
msgid "If I ever feel like eating anything, I'll eat it."
msgstr "Если мне когда-нибудь захочется что-нибудь съесть, я это съем."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "Sigh. I suppose all these vegetables will keep my strength up..."
msgstr "Эх. Похоже, все эти овощи поддержат во мне силы..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUS_SEEDS"
msgid "Will I live to see this grow?"
msgstr "Доживу ли я, когда они вырастут?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "Take us far from here."
msgstr "Уберите нас далеко отсюда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "We can't do that again for awhile."
msgstr "Мы не можем сделать это снова в ближайшее время."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "Oh well. I hope it's a quick death."
msgstr "Ну что ж. Надеюсь, это быстрая смерть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.OFF"
msgid "A beacon of hope left unlit... How fitting."
msgstr "Маяк надежды остался неосвещённым... Как уместно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.ON"
msgid "Hope springs infernal."
msgstr "Надеюсь, это побег в ад."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_KEY"
msgid "I think I know where it goes..."
msgstr "Кажется, я знаю, куда это подходит..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "There is no light to be found."
msgstr "Нет света, который можно найти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "A deathly light dances across the room."
msgstr "Смертельный свет танцует по комнате."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "Scrawlings of a tongue lost to time."
msgstr "Царапины на языке, утерянном во времени."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "A people struck by famine and sorrow."
msgstr "Люди, сражённые горем и голодом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "A piece of their story, lost to time."
msgstr "Кусочек их истории, затерянный во времени."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "They are consumed by darkness."
msgstr "Их поглотила тьма."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "Then, rebirth."
msgstr "Затем возрождение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "Finally, a city, full of life."
msgstr "Наконец, город, полный жизни."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_STATUE"
msgid "A tortured soul."
msgstr "Измученная душа."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.AXE"
msgid "An instrument for industry and murder."
msgstr "Инструмент для труда и убийства."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "Enjoy your youth. Soon you will learn the terrors of the real world."
msgstr "Наслаждайся своей молодостью. Скоро ты познаешь ужасы реального мира."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "Don't wake up."
msgstr "Не просыпайся."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BACKPACK"
msgid "A spacious sack to increase one's burden."
msgstr "Просторный мешок для большего количества предметов."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BACONEGGS"
msgid "A balanced breakfast to start another miserable day."
msgstr "Сбалансированный завтрак, подходящий для начала очередного унылого дня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BALATRO_MACHINE"
msgid "What more can I lose?"
msgstr "Что ещё я могу потерять?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOON"
msgid "A colorful reminder that my childhood is no more."
msgstr "Красочное напоминание о том, что у меня нет детства."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONHAT"
msgid "Can he make one for Abigail?"
msgstr "А он может сделать такую для Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONPARTY"
msgid "What is the point of celebrating in a place such as this?"
msgstr "Какой смысл праздновать в таком месте?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "Sail far away from here, little balloon."
msgstr "Лети далеко отсюда, маленький воздушный шарик."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "Will it make me swift enough to outrun my problems?"
msgstr "Сделает ли он меня достаточно быстрой, чтобы я смогла убежать от своих проблем?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONS_EMPTY"
msgid "These look as deflated as I feel..."
msgstr "Они кажутся такими же пустыми внутри, как мои чувства..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONVEST"
msgid "Why try to prolong the inevitable?"
msgstr "Зачем пытаться продлить неизбежное?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BANANABUSH"
msgid "Bananas that grow in the sun... how unnatural."
msgstr "Бананы, которые растут под солнцем... как непривычно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BANANAJUICE"
msgid "I... like it."
msgstr "Мне... нравится."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BANANAPOP"
msgid "I used to eat these with Abigail..."
msgstr "Я ела их вместе с Абигейл..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BANDAGE"
msgid "There's no salve for the pain of existence."
msgstr "В конечном итоге боль повторится."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "An ephemeral remedy woven from vanitas itself."
msgstr "Эфемерное средство, сотканное из бренности всего земного."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLE"
msgid "We pried it from its home."
msgstr "Мы украли их из их собственного дома."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLEPITA"
msgid "My pita is filled with disappointment."
msgstr "Полно разочарования. Как и моя жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "They make starving seem almost appealing..."
msgstr "От них хочется голодать..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLESUSHI"
msgid "It's cold..."
msgstr "Холодное..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLE_COOKED"
msgid "It's... chewy."
msgstr "Они... жёсткие."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLINGUINE"
msgid "I like my noodles plain, with butter."
msgstr "Мне больше нравится обычная лапша с маслом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BASALT"
msgid "Trying to break it would be pointless."
msgstr "Попытка сломать его была бессмысленной."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BAT"
msgid "A creature of the night."
msgstr "Порождение ночи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATBAT"
msgid "An enchanted weapon. How exciting!"
msgstr "Зачарованное оружие. Какая прелесть!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATCAVE"
msgid "They're just lurking in there..."
msgstr "Они там просто притаились..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATHBOMB"
msgid "To mask the smell of sorrow and death."
msgstr "Чтобы спрятать запах горечи и смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATNOSE"
msgid "It won't be bothering us anymore."
msgstr "Больше оно не будет нам надоедать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATNOSEHAT"
msgid "This feels silly."
msgstr "Это как-то глупо."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATNOSE_COOKED"
msgid "It doesn't look more appetizing now."
msgstr "Они не стали более аппетитными."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_CONTAINER"
msgid "A hollow container."
msgstr "Пустой сосуд."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_DURABILITY"
msgid "My heart has no desire to sing."
msgstr "У моего сердца нет желания петь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "My heart has no desire to sing."
msgstr "У моего сердца нет желания петь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "My heart has no desire to sing."
msgstr "У моего сердца нет желания петь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "I only like tragedies."
msgstr "Мне нравятся только трагедии."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "My heart has no desire to sing."
msgstr "Моë сердце не желает петь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "I only like tragedies."
msgstr "Мне нравятся только трагедии."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "My heart has no desire to sing."
msgstr "Моë сердце не желает петь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "My heart has no desire to sing."
msgstr "У моего сердца нет желания петь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "My heart has no desire to sing."
msgstr "У моего сердца нет желания петь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "My heart has no desire to sing."
msgstr "Моë сердце не желает петь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATWING"
msgid "If only I could fly away."
msgstr "Ах, вот бы мне улететь отсюда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATWING_COOKED"
msgid "They once held such great potential."
msgstr "Прежде они дарили хозяину столько свободы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARDHAIR"
msgid "That's just nasty."
msgstr "Это просто гадко."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGER"
msgid "It could crush me in one blow. I wish it would."
msgstr "Он мог бы переломить меня пополам одним ударом. Было бы неплохо..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "Reduced to ashes, scattered on the wind."
msgstr "Низведён до праха, развеян по ветру."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "Laid to rest."
msgstr "Ушёл на покой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "Is this what you really want?"
msgstr "Это правда то, чего ты хочешь?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERFUR_SACK"
msgid "I already carry the coldness within."
msgstr "Я уже несу в своей душе холод."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERVEST"
msgid "Death surrounds us. Well, our torsos anyhow."
msgstr "Смерть окружает нас. Ну, во всяком случае, наши тела."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGER_FUR"
msgid "It smells like death."
msgstr "Она пахнет смертью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEAST_BLUEPRINT"
msgid "May it give my beefalo more luck than I've had."
msgstr "Пусть моему бифало повезёт больше, чем мне."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEDROLL_FURRY"
msgid "For veiling oneself in the fuzzy skins of the fallen."
msgstr "Я оберну себя пушистыми шкурами павших."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEDROLL_STRAW"
msgid "Sleep is but a temporary death."
msgstr "Сон не что иное, как временная смерть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEE.GENERIC"
msgid "I'd steer clear of that stinger."
msgstr "Я бы держалась подальше от её жала."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEE.HELD"
msgid "Be still, little one."
msgstr "Успокойся, малышка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.BURNT"
msgid "Burnt honey."
msgstr "Жжёный мёд."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.FULLHONEY"
msgid "Their toils have been fruitful!"
msgstr "Их труды оказались плодотворны!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.GENERIC"
msgid "Their stolen labor tastes so sweet."
msgstr "Их украденный труд является таким сладким."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.NOHONEY"
msgid "Work, bees!"
msgstr "Работать, пчёлы!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.READY"
msgid "Their toils have been fruitful!"
msgstr "Их труды оказались плодотворны!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "Toil on."
msgstr "Трудитесь больше."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "Burnt honey."
msgstr "Жжёный мёд."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "Their toils have been fruitful!"
msgstr "Их труды оказались плодотворны!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "There are only memories of sweetness here."
msgstr "От сладости здесь только воспоминания."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "Work, bees!"
msgstr "Работать, пчёлы!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "Their toils have been fruitful!"
msgstr "Их труды оказались плодотворны!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "Toil on."
msgstr "Работайте усерднее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.DEAD"
msgid "Dead, but perhaps not departed."
msgstr "Мёртв, но, может, не окончательно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "Not you too..."
msgstr "Неужели и ты тоже..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "I wonder if it misses its old family?"
msgstr "Я всё гадаю, думает ли он о своих диких родичах?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.FOLLOWER"
msgid "He follows me unto his doom."
msgstr "Он следует за мной к своей гибели."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.GENERIC"
msgid "What demented thoughts must lie behind those eyes."
msgstr "Какие приземлённые мысли должно быть скрываются за этими глазами."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.MYPARTNER"
msgid "At least we have each other for company."
msgstr "По крайней мере, мы есть друг у друга."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.NAKED"
msgid "His nakedness is now on display."
msgstr "Теперь его нагота выставлена напоказ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.ORNERY"
msgid "The world has wronged you."
msgstr "Мир был так несправедлив с тобой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.PUDGY"
msgid "More of the world is within the beast than without."
msgstr "Его внутренний мир очевидно больше, чем наружный."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.RIDER"
msgid "Together we can venture far."
msgstr "Совместно мы можем зайти далеко."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.SLEEPING"
msgid "To sleep, perchance to dream."
msgstr "Уснуть, и видеть сны, быть может?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALOFEED"
msgid "I wouldn't want my beefalo to starve."
msgstr "Я бы не хотела, чтобы мой бифало голодал."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALOHAT"
msgid "To cover one's head."
msgstr "Я покрою свою голову."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALOTREAT"
msgid "Oh to be able to find joy in such a simple thing..."
msgstr "О, уметь находить радость в такой простой вещи..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALOWOOL"
msgid "Somewhere, a beefalo is naked and cold."
msgstr "Где-то бродит бифало, голый и замёрзший."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "Burned to ashes."
msgstr "Сгорела дотла."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "Beauty, like all things, will fade and be forgotten."
msgstr "Красота, как и всё остальное, исчезнет и будет забыта."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "I can change its appearance, but it will always just be a beefalo."
msgstr "Я могу изменить его внешность, но внутри он так и останется бифало."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "Sigh. Endless toil."
msgstr "Эх. Бесконечный труд."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEF_BELL"
msgid "Alas, not a death knell."
msgstr "Увы, не похоронный звон."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEGUARD"
msgid "Their devotion knows no bounds."
msgstr "Их преданность не знает границ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEHAT"
msgid "This will protect me from those happy buzzing sounds. Oh, and stings."
msgstr "Она защитит меня от всех этих жизнерадостных жужжаний.\n А, ну и от жал, конечно, тоже."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEHIVE"
msgid "A wretched hive of scum and pollen."
msgstr "Жалкий улей из отбросов и пыльцы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEMINE"
msgid "They're still alive in there. Poor things."
msgstr "Они там до сих пор живы. Бедолаги."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEMINE_MAXWELL"
msgid "The furious creatures appreciate their freedom in retrospect."
msgstr "Эти разъярённые существа когда-то наслаждались свободой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEQUEEN"
msgid "As regal as she is ruthless..."
msgstr "Такая величественная и такая безжалостная..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "The bees left their sweet mark upon the earth."
msgstr "Пчёлы оставили свой след на земле."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "It is not a danger... yet..."
msgstr "Он не опасен... пока..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "Dripping with enmity. And honey."
msgstr "Из него так и сочится недружелюбие. И мёд."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEESWAX"
msgid "It's useless on its own, just like me."
msgstr "Сам по себе он бесполезен, как и я."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEESWAX_SPRAY"
msgid "The bottled scent of fear."
msgstr "Запах страха в бутылках."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEETLETAUR"
msgid "You are a prisoner of your own doomed destiny."
msgstr "Ты в заключении своей обречённой судьбы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BELL"
msgid "Ring in the dead."
msgstr "По ком он плачет сегодня?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERNIE_ACTIVE"
msgid "It dances to forget the pain."
msgstr "Он танцует, чтобы забыть о болит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERNIE_BIG"
msgid "Wow... What a big stuffy."
msgstr "Вау ... Какой большой и сердитый."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "It has passed."
msgstr "Он отошёл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "It's had a rough life."
msgstr "Жизнь его потрепала."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRIES"
msgid "These berries are tart."
msgstr "Эти ягоды кислые."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRIES_COOKED"
msgid "More balanced flavor, but they won't last long."
msgstr "Более сбалансированный привкус, но их надолго не хватит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRIES_JUICY"
msgid "I'd better consume these before death does."
msgstr "Лучше я доберусь до них раньше, чем смерть сделает это."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "This hasn't halted the decay, merely stalled it."
msgstr "Это не остановило их разложение, а лишь немного замедлило."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.BARREN"
msgid "It is barren."
msgstr "Он засох."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.BURNING"
msgid "Its suffering will end soon."
msgstr "Его страдания скоро закончатся."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.DISEASED"
msgid "It's not long for this world..."
msgstr "Недолго для этого мира..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.DISEASING"
msgid "It is on the precipice..."
msgstr "Он находится на грани..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.GENERIC"
msgid "A snack, perchance?"
msgstr "Отведать их, быть может?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.PICKED"
msgid "The wait begins."
msgstr "Мне следует подождать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.WITHERED"
msgid "It succumbed to the heat."
msgstr "Он покорился роковой жаре."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "There's no life to be had here..."
msgstr "В нём нет никакой жизни..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Its suffering will end soon."
msgstr "Его страдания скоро закончатся."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "It's not long for this world..."
msgstr "Недолго для этого мира..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "It is on the precipice..."
msgstr "Он находится на грани..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "I could strip it clean, if I so chose..."
msgstr "Можно собрать урожай, если нужно..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "It's given all it had to give."
msgstr "Он отдал всё, что мог."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "It has crumpled under the heat."
msgstr "Он засох от жары."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYSAUCE"
msgid "Abigail would love this..."
msgstr "Абигейл бы понравилось..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIBINGKA"
msgid "This bread has a most curious texture."
msgstr "Этот хлеб имеет самую необычную текстуру."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIGFOOT"
msgid "Harbinger of doom."
msgstr "Роковой вестник."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRCHNUTDRAKE"
msgid "Balls of battle!"
msgstr "Боевые шарики!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.DEAD"
msgid "Bereft of life, he rests in pieces."
msgstr "Лишившись жизни, покойся с миром."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.GENERIC"
msgid "Few of us can see our cages."
msgstr "Некоторые из нас могут видеть свои клетки."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "Must be hungry."
msgstr "Изголодалась."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "He is happier now."
msgstr "Теперь она счастливее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.SKELETON"
msgid "That... is an ex-bird."
msgstr "Это... всё, что осталось от некогда величавого создания."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "Dead? No. Just sleeping."
msgstr "Мертва? Нет. Просто спит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.STARVING"
msgid "The emptiness is eating him from the inside out."
msgstr "Пустота ест её изнутри."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCORPSE.BURNING"
msgid "Now it is truly free."
msgstr "Теперь она по-настоящему свободна."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCORPSE.GENERIC"
msgid "Poor bird."
msgstr "Есть судьба гораздо хуже смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCORPSE.REVIVING"
msgid "There can be a fate worse than death."
msgstr "Бедная пташка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDTRAP"
msgid "Sticks and silk turned lethal."
msgstr "Палки и паутина стали смертоносными."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRD_EGG"
msgid "So much hope, dashed."
msgstr "Так много надежд, млин."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRD_EGG_COOKED"
msgid "No bird will ever come of it."
msgstr "И больше никогда не вылупиться птице из него."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRD_MUTANT"
msgid "Mr. Crow, you don't look well."
msgstr "Мистер Ворон, вы сегодня плохо выглядите."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "Something is terribly wrong with that bird."
msgstr "Что-то ужасающе не так с этой птицей."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BISHOP"
msgid "What does he pray for?"
msgstr "О чём он молится?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Ouch..."
msgstr "Ой..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BISHOP_NIGHTMARE"
msgid "Time wins all battles."
msgstr "Время выигрывает все сражения."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLACKFLAG"
msgid "Black, like a mourning shroud."
msgstr "Тёмный, будто утренний туман."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_FIRE"
msgid "Shall we set the world on fire?"
msgstr "Не сжечь ли мне весь мир?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_LAVA"
msgid "To pierce the hearts of my foes..."
msgstr "Чтобы пронзить сердца моих врагов..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_LAVA2"
msgid "To burn and pierce!"
msgstr "Сжечь и пронзить!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_PIPE"
msgid "Blow in one end, pain comes out the other."
msgstr "Я дуну с этой стороны, а боль и страдания выйдут с той."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_SLEEP"
msgid "Not the big sleep, just a temporary one."
msgstr "Небольшой сон, просто на время."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_YELLOW"
msgid "Airborne lightning and death."
msgstr "Молния с воздуха и смерть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEAMULET"
msgid "A familiar, chilling embrace."
msgstr "Хорошо знакомые, леденящие объятия."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEGEM"
msgid "Blue like... er... a sad bird?"
msgstr "Синий как... эм... грустная птица?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEMOONEYE"
msgid "Such an icy gaze..."
msgstr "Такой ледяной взгляд..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEPRINT.COMMON"
msgid "Whoever drew this is probably dead."
msgstr "Тот, кто нарисовал это, вероятно, мертв."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEPRINT.RARE"
msgid "I'm surprised we didn't die trying to get this."
msgstr "Удивительно, что мы ещё не умерли."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_CAP"
msgid "A fungus to preserve the monotony."
msgstr "Ещё один унылый гриб в подтверждение тщетности бытия."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_CAP_COOKED"
msgid "All is malleable."
msgstr "Всему приходит конец."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "Musty."
msgstr "Это он с плесенью, что ли?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "I would hide too, if I could."
msgstr "Я бы тоже спряталась, если бы могла."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Harvested."
msgstr "Он уже собран."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOARDS"
msgid "Even scarier for the trees."
msgstr "Этого деревья боятся ещё больше."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOARON"
msgid "A shame you have to perish."
msgstr "Жаль, что вам нужно погибнуть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOARRIOR"
msgid "Your death will be swift."
msgstr "Твоя смерть будет быстрой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATFRAGMENT03"
msgid "Wreckage is all that remains."
msgstr "Обломки — всё, что осталось."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATFRAGMENT04"
msgid "Wreckage is all that remains."
msgstr "Обломки — всё, что осталось."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATFRAGMENT05"
msgid "Wreckage is all that remains."
msgstr "Обломки — всё, что осталось."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATPATCH"
msgid "To mend what the cruel seas have crushed."
msgstr "Чтобы исправить то, что сокрушили жестокие моря."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATPATCH_KELP"
msgid "It will probably fall apart before I can reach shore. If I'm lucky."
msgstr "Скорее всего, лодка развалится прежде, чем я доберусь до берега. Если мне повезёт."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "Where do we go from here?"
msgstr "Ну и что нам делать дальше?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "I should throw this in the water."
msgstr "Мне стоит выбросить это в воду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "We are all just racing to the end."
msgstr "Мы все просто стремимся к концу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SEASTACK"
msgid "Why try to avoid the inevitable?"
msgstr "Зачем пытаться избежать неизбежного?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Why try to avoid the inevitable?"
msgstr "Зачем пытаться избежать неизбежного?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "A useful guide, or a marker for a watery grave..."
msgstr "Полезный гид, или указатель морской могилы..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "A useful guide, or a marker for a watery grave..."
msgstr "Полезный гид, или указатель морской могилы..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Will you silently bear witness to what befalls us?"
msgstr "Ты просто будешь тихо наблюдать за тем, что с нами станет?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_START"
msgid "Is this the start or the end? Or the start of the end?"
msgstr "Это начало или конец? Или начало конца?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Does it matter where? It's all a game isn't it?"
msgstr "Разве важно, куда его ставить? Это же всего лишь игра?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "I could put things in there. I guess."
msgstr "Туда можно что-нибудь сложить. Наверное."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "It looks like it will be quite sturdy. Oh well."
msgstr "Похоже, она будет довольно прочной. Ну что ж."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "Looks strong. Are we afraid to die?"
msgstr "Выглядит прочным. Боимся ли мы умереть?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "I suppose I should make myself useful."
msgstr "Полагаю, я могу хоть раз побыть полезной."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_KELP"
msgid "It will only prolong the inevitable."
msgstr "Он лишь отсрочит неизбежное."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "I suppose I should make myself useful."
msgstr "Полагаю, я могу хоть раз побыть полезной."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "It will only prolong the inevitable."
msgstr "Он лишь отсрочит неизбежное."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "I suppose I should make myself useful."
msgstr "Полагаю, я могу хоть раз побыть полезной."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "My boat is baring its teeth."
msgstr "Моя лодка показывает свои зубы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "I suppose I should make myself useful."
msgstr "Полагаю, мне стоит побыть полезной."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "What irreparable damage will it cause?"
msgstr "Какой неисправимый урон она может нанести?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "It's empty inside..."
msgstr "Пуста внутри..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "I have nothing that can fill the void... of this empty cannon."
msgstr "У меня нет ничего, что могло бы заполнить пустоту... этой пустой пушки."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_CANNON_KIT"
msgid "A creation of destruction."
msgstr "Создано для разрушения."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_GRASS_ITEM"
msgid "It will make a rather flimsy boat. I'll likely drown."
msgstr "Сделает довольно слабую лодку. Скорее всего, она утонет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ITEM"
msgid "It's for making a boat."
msgstr "Для создания лодки."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_LEAK"
msgid "I always knew the ocean floor would be my final resting place."
msgstr "Всегда знала, что морское дно станет моей могилой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "Will it draw me toward safety or destruction?"
msgstr "Приведёт меня к опасности или к разрушению?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "It looks so... silly."
msgstr "Выглядит так... глупо."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "Oh. I suppose it's working."
msgstr "Оу. Полагаю, оно всё же работает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "It will draw others near."
msgstr "Привлечёт других."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET_KIT"
msgid "I'm left to pick up the pieces..."
msgstr "Я всегда остаюсь крайней..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ROTATOR"
msgid "If only I could turn everything around so easily."
msgstr "Я уже и так свернула не туда..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "I could build a rudder, I suppose..."
msgstr "Я могу построить поворотник, наверное..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "This one is just right. Except for the smell."
msgstr "Эта в самый раз. За исключением запаха."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BODYPILLOW_KELP"
msgid "This one is too... kelpy."
msgstr "Эта слишком... жидкая."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BODYPILLOW_PETALS"
msgid "This one is too soft."
msgstr "Этот слишком мягкая."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "This one is too hard."
msgstr "Это слишком жёсткая."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOMB_LUNARPLANT"
msgid "An instrument of destruction."
msgstr "Орудие разрушения."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "It's far deadlier than before."
msgstr "Оно гораздо более смертоносное, чем раньше."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BONESHARD"
msgid "Choking hazard."
msgstr "Жалкие остатки некогда беззаботных существ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BONESOUP"
msgid "Supper looks good."
msgstr "Ужин выглядит хорошо."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BONESTEW"
msgid "You'd be surprised how much life can be gleaned from death and bones."
msgstr "Они умерли. А затем я положила их в похлёбку."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOKSTATION.BURNT"
msgid "It's all burned away."
msgstr "Сгорел дотла."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOKSTATION.GENERIC"
msgid "How I miss my poetry books."
msgstr "Как я скучаю по своим поэтическим книгам."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_BEES"
msgid "Bees live such short, unremarkable lives."
msgstr "Пчёлы живут такой короткой, ничем не примечательной жизнью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_BIRDS"
msgid "Will it teach me to fly away from here?"
msgstr "Она поможет мне улететь отсюда?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_BRIMSTONE"
msgid "The tome to end it all..."
msgstr "Книга о том, как всё закончить..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_ELEMENTAL"
msgid "I would not want such power."
msgstr "Я бы не хотела такой власти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_FIRE"
msgid "What if we let this world fall to ash?"
msgstr "Что, если мы позволим этому миру стать пеплом?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_FISH"
msgid "Poor fish, so easily murdered."
msgstr "Бедная рыбка, её так легко убить."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_FOSSIL"
msgid "There is power in words."
msgstr "В словах есть сила."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_GARDENING"
msgid "Imagine, a rolling field of red flowers..."
msgstr "Представь себе, бескрайние поля красных цветов..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_HORTICULTURE"
msgid "I'm not very good at keeping things alive."
msgstr "Я не очень хорошо умею поддерживать жизнь кого-то."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "We help the plants grow, only to cull them in their prime."
msgstr "Мы помогаем растениям расти только для того, чтобы собрать их в самом расцвете сил."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_LIGHT"
msgid "It won't save us from the darkness forever."
msgstr "Это не спасет нас от тьмы навсегда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "The brighter the light, the deeper the shadows..."
msgstr "Чем ярче свет, тем глубже тени..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_MOON"
msgid "Let the moon turn its cold gaze on us once again."
msgstr "Пусть луна снова обратит на нас свой холодный взор."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_RAIN"
msgid "Oh... I suppose I was hoping it might involve more candles and chanting."
msgstr "Эх... Наверное, я надеялась, что это будет включать в себя больше свечей и песнопений."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "It looks so... boring..."
msgstr "Это выглядит так... скучно..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_SILVICULTURE"
msgid "What secrets lie deep in the forest?"
msgstr "Какие тайны таятся глубоко в лесу?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_SLEEP"
msgid "Does it impart an eternal slumber?"
msgstr "Она приводит к вечному оцепенению?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_TEMPERATURE"
msgid "What does it matter? I'll always feel cold inside."
msgstr "Какое это имеет значение? Я всегда буду чувствовать холод внутри."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_TENTACLES"
msgid "Does this world need more beasts?"
msgstr "Неужели этому миру недостаточно страшилищ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_WEB"
msgid "I'm not afraid of spiders."
msgstr "Я не боюсь пауков."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOMERANG"
msgid "Death returns to the sender."
msgstr "Смерть возвращается к отправителю."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOTLEG"
msgid "It will just take me from one unpleasant place to another."
msgstr "Она просто перенесëт меня из одного неприятного места в другое."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BROKEN_FORGEDITEM"
msgid "A broken mockery of what it once was."
msgstr "Разбитая насмешка над тем, чем это когда-то было."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BRUSH"
msgid "Oh, to rid the world of fluff."
msgstr "Избавит мир от пуха."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUGNET"
msgid "A prison for tiny insects."
msgstr "Тюрьма для маленьких насекомых."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "It's just seaweed."
msgstr "Это просто водоросли."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "There's no more seaweed here."
msgstr "Здесь больше нет водорослей."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BULLKELP_ROOT"
msgid "It's like a very slimy whip."
msgstr "Это как очень скользкий хлыст."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUNDLE"
msgid "I don't even remember what's within anymore..."
msgstr "Я даже не помню, что дальше..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUNDLEWRAP"
msgid "Abigail always helped me tie the bow."
msgstr "Абигейл всегда помогала мне завязывать бант."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUNNYMAN"
msgid "What tormented inner lives they must have."
msgstr "Их внутренний мир, должно быть, полон мучений."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUNNYSTEW"
msgid "You were fast, little rabbit, but death is faster."
msgstr "Ты был быстр, маленький кролик, но смерть быстрее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BURNT_MARSH_BUSH"
msgid "It's unspeakably burnt."
msgstr "Не передать словами, как он сгорел."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUSHHAT"
msgid "I'm already practically invisible..."
msgstr "Я уже почти невидимая..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTER"
msgid "I wasn't expecting that."
msgstr "Такого я не ожидала."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTERFLY.GENERIC"
msgid "Pretty, but short-lived."
msgstr "Красивая, но живёт не долго."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTERFLY.HELD"
msgid "I hold its life in my hands."
msgstr "Её жизнь в моих руках."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Let's see you get out of this sugary trap!"
msgstr "Посмотрим, как ты теперь выберешься из этой сахарной ловушки!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTERFLYWINGS"
msgid "No more can the butterfly soar."
msgstr "Этой бабочке больше не порхать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUZZARD"
msgid "I hear they feed on the dead."
msgstr "Я слышала, они кормятся мертвячиной."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "Now it is truly free."
msgstr "Теперь она действительно свободна."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "Poor bird."
msgstr "Есть судьба гораздо хуже смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "There can be a fate worse than death."
msgstr "Бедная пташка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CABBAGEROLLS"
msgid "I wouldn't mind rolling up in a blanket and forgetting my troubles..."
msgstr "Не отказалась бы завернуться в одеяло и забыть о всех своих печалях..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS.GENERIC"
msgid "Knives out."
msgstr "Выпустил свои ножи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS.PICKED"
msgid "Flattened."
msgstr "Раздавлен."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS_FLOWER"
msgid "Even the knife-plant has a flower. Ugh."
msgstr "Даже у такого игольчатого растения есть цветок. Бр-р-р."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS_MEAT"
msgid "It's still dangerous."
msgstr "Оно всё ещё опасно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "Its defenses have been stripped away."
msgstr "Я повысмыкивала все его шипы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CALIFORNIAROLL"
msgid "A cold fish, dressed up in a seaweed jacket."
msgstr "Холодная рыба, одетая в водорослевую жилетку."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.EMBERS"
msgid "Darkness is looming."
msgstr "Тьма приближается."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.GENERIC"
msgid "I might survive this night!"
msgstr "Теперь я, возможно, и переживу эту ночь!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.HIGH"
msgid "A vision of Hell!"
msgstr "Видение Ада!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.LOW"
msgid "The gloom encroaches."
msgstr "Мрак подступает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.NORMAL"
msgid "It's a fire."
msgstr "Это костёр."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.OUT"
msgid "That is not a good sign."
msgstr "Нехороший знак."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CANARY.GENERIC"
msgid "Such a cheery yellow... I can't stand it."
msgstr "Такая радостная, жёлтая... не выношу её."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CANARY.HELD"
msgid "You're at my mercy, bird."
msgstr "Ты в моей власти, птичка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CANARY_POISONED"
msgid "Pestilence and death will soon claim you."
msgstr "Мор и смерть скоро настигнут тебя."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CANDYBAG"
msgid "It's for putting nice things in..."
msgstr "Для того, чтобы складывать сюда хорошие вещи..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CANE"
msgid "To explore to the ends of this wretched world."
msgstr "С ней я вмиг домчу куда угодно!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "I must carry this weight... to the cannon, at least."
msgstr "Я обязана нести этот груз... пока не дойду до пушки, по крайней мере."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "Heehee...!"
msgstr "Хи-хи...!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "Oh. That might be... f-fun..."
msgstr "Оу. Это может быть... в-весело..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALCANNON_KIT"
msgid "I suppose I should try to be useful..."
msgstr "Наверное, мне стоит попробовать быть полезной..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "Such a simple thing, but somehow watching it makes my heart lighter."
msgstr "Такая простая вещь, но почему-то когда я смотрю на него, на сердце немного легче."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "I suppose I should try to be useful..."
msgstr "Наверное, мне стоит попробовать быть полезной..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "I doubt those eggs will ever hatch."
msgstr "Сомневаюсь, что эти яйца когда-нибудь вылупятся."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "I suppose I should try to be useful..."
msgstr "Наверное, мне стоит попробовать быть полезной..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "Oh. It's a little wooden statue."
msgstr "Оу. Это маленькая деревянная статуя."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "Here it shall rest, forever."
msgstr "Здесь она будет покоиться, вечно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "The colors are so cheery, yet I don't despise it. How odd."
msgstr "Цвета такие радостные, но я не презираю её. Как странно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "What secrets does it hide?"
msgstr "Какие секреты она таит?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "What secrets does it hide?"
msgstr "Какие секреты она таит?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "It can't hold back the darkness forever."
msgstr "Он не сможет сдерживать тьму вечно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "I suppose I should try to be useful..."
msgstr "Наверное, мне стоит попробовать быть полезной..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "A small reminder of... a nice day."
msgstr "Маленькая память... о хорошем дне."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "I suppose I should try to be useful..."
msgstr "Наверное, мне стоит попробовать быть полезной..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "Oh. There really is corn in it..."
msgstr "Оу. Там и вправду есть кукуруза..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "At least they're not real worms."
msgstr "По крайней мере, это ненастоящие черви."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "Can I... help set up the carnival?"
msgstr "Можно мне... помочь обустроить карнавал?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "It's a little door."
msgstr "Это маленькая дверь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "It wants something first... something shiny."
msgstr "Для начала оно хочет что-то... блестящее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "What a funny game."
msgstr "Какая забавная игра."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "You can't outrun the inevitable."
msgstr "Нельзя убежать от неизбежного."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "Can I... help set up the carnival?"
msgstr "Можно мне... помочь обустроить карнавал?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "It wants something first... something shiny."
msgstr "Для начала оно хочет что-то... блестящее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "They look so silly running about."
msgstr "Они выглядят так смешно, когда бегают вокруг."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "It's a little door."
msgstr "Это маленькая дверь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "Abigail, do you remember which one it was?"
msgstr "Абигейл, помнишь, какая правильная?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "Can I... help set up the carnival?"
msgstr "Можно мне... помочь обустроить карнавал?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "It wants something first... something shiny."
msgstr "Для начала оно хочет что-то... блестящее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "I'm very good at remembering... aren't I, Abigail?"
msgstr "Я всё очень хорошо помню... не так ли, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "Can I... help set up the carnival?"
msgstr "Можно мне... помочь обустроить карнавал?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "It wants something first... something shiny."
msgstr "Для начала оно хочет что-то... блестящее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "The outcome is as unpredictable as life itself."
msgstr "Результат настолько же непредсказуем, как и сама жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "It wants something first... something shiny."
msgstr "Для начала оно хочет что-то... блестящее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "What a pretty button."
msgstr "Какая красивая кнопка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "Can I... help set up the carnival?"
msgstr "Можно мне... помочь обустроить карнавал?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "It wants something first... something shiny."
msgstr "Для начала оно хочет что-то... блестящее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "I think... I'd like to try to play..."
msgstr "Думаю... я бы попробовала поиграть..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "It's a little door."
msgstr "Это маленькая дверь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "They were created only to suffer."
msgstr "Созданы чтобы страдать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "Can I... help set up the carnival?"
msgstr "Можно мне... помочь обустроить карнавал?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "It wants something first... something shiny."
msgstr "Для начала оно хочет что-то... блестящее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "Oh... I think I'm doing... well?"
msgstr "Оу... кажется у меня... получается?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_BALL"
msgid "Won't you play with me, Abigail?"
msgstr "Не хочешь сыграть со мной, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_CROWKID"
msgid "A murder has flown in."
msgstr "Убийство спустилось с небес."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "It gleams in the light."
msgstr "Сверкает при свете."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_HOST"
msgid "How do you do, Mr. Raven?"
msgstr "Как у вас дела, Мистер Ворон?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "Abigail thinks it needs some decorations around it."
msgstr "Абигейл думает, что нужно поставить вокруг него больше украшений."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "The ravens seem quite drawn to the decorations."
msgstr "Похоже, воронов тянет к украшениям."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "It does look quite pretty, doesn't it?"
msgstr "Выглядит довольно красиво, не так ли?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "Perhaps I might enjoy its shade one day."
msgstr "Возможно, однажды я смогу насладиться его тенью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "Maybe I'll just take a peek..."
msgstr "Может, я просто разок посмотрю..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "I wonder what kind of prizes they have..."
msgstr "Интересно, какие призы у них есть..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "I... won something?"
msgstr "Я... что-то выиграла?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "M-maybe I'll take a look at the prizes...!"
msgstr "М-может, я взгляну на призы...!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "I've collected quite a few now."
msgstr "Я уже собрала несколько."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "It tastes like disappointment."
msgstr "На вкус как разочарование."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_A"
msgid "I wish you could try it on Abigail, I think it would suit you."
msgstr "Если бы только ты могла надеть его, Абигейл, думаю, он бы тебе подошёл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_B"
msgid "I find a curious comfort in the sound of dead, rustling leaves."
msgstr "Я нахожу странное умиротворение в звуке мёртвых, шуршащих листьев."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_C"
msgid "Perhaps I could join the ravens and fly far, far away..."
msgstr "Может, я смогу присоединиться к воронам и улететь далеко-далеко..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "Pretty. If it was smaller I'd wear it around my neck."
msgstr "Мило. Будь оно поменьше, я бы носила его на шее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "...Perhaps not."
msgstr "...Что ж, видимо нет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "Perhaps I could make something nice."
msgstr "Видимо, я смогу сделать что-нибудь приятное."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.DEAD"
msgid "It is no more."
msgstr "Её больше нет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.GENERIC"
msgid "I despise how it skitters..."
msgstr "Я презираю то, как она носится..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.HELD"
msgid "Freedom is not for you."
msgstr "Свобода не для тебя."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.SLEEPING"
msgid "It is arrested by deepest sleep."
msgstr "Её останавливает глубочайший сон."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT_GHOSTRACER"
msgid "It's merely a shade."
msgstr "Это всего лишь тень."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT"
msgid "It's a carrot."
msgstr "Это морковка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_COOKED"
msgid "It's a carrot that's gone through a gauntlet of fire."
msgstr "Это морковка, прошедшая испытание огнём."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_OVERSIZED"
msgid "A clump of giant, gnarled roots for eating."
msgstr "Пучок гигантских извилистых корней для еды."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_PLANTED"
msgid "It's a carrot that's in the ground."
msgstr "Это морковка, которую воткнули в землю."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_SEEDS"
msgid "It's a plant that's waiting to be."
msgstr "Это растение, которое ждёт своего часа."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Well, old maps always do look burnt at the edges..."
msgstr "Ну, старые карты всегда немного обожжены по краям..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "No more mapmaking, then."
msgstr "Значит, никаких карт больше."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "Maps are best with monsters drawn on the borders."
msgstr "Было бы лучше, нарисуй по краям монстров."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOON"
msgid "I wonder if it had a twin, too."
msgstr "Интересно, у него тоже был близнец?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONDEN.EMPTY"
msgid "All cats must die."
msgstr "Все кошки должны умереть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONDEN.GENERIC"
msgid "I could curl up and die in there."
msgstr "Я могла бы свернуться в клубок и умереть здесь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONHAT"
msgid "Nothing like the stench of death on your head."
msgstr "Ничто иное, как запах смерти на моей голове."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CATTOY_MOUSE"
msgid "The wheel is come full circle."
msgstr "Колесо дало оборот."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "Call me Sisyphus."
msgstr "Назовите меня Сизифом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "So close, yet so far away."
msgstr "Так близко, но так далеко."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA"
msgid "The peels look dangerous."
msgstr "Их шкурки выглядят опасно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_BURNT"
msgid "The death and suffering never ends."
msgstr "Смерть и страдания никогда не закончатся."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Warmed banana mush is so much better."
msgstr "Тёплая банановая кашка... Что может быть вкуснее?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_TREE"
msgid "Poor plant, locked away from the sun."
msgstr "Несчастное растение, никогда не видело солнца."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE"
msgid "Someone is trying to keep the underground at bay."
msgstr "Кто-то пытается держать подземелье закрытым."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "There's no room at the cave party for me..."
msgstr "Мне нет места в пещерной вечеринке."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "I'm too busy descending into madness to descend that cave."
msgstr "Я слишком занята, чтобы сойти с ума в этой пещере."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "A great evil lurks beneath the surface."
msgstr "Большое зло скрывается под поверхностью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Someone is trying to keep the underground at bay."
msgstr "Кто-то пытается держать подземелье закрытым."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.FULL"
msgid "Oh... I guess I'm not invited to the surface party..."
msgstr "О... Похоже меня не позвали на вечеринку наверху."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Why leave? The light here compliments my complexion."
msgstr "Зачем уходить? Здешний свет мне к лицу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.OPEN"
msgid "The surface beckons."
msgstr "Поверхность так и манит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_FERN"
msgid "A touch of color in the bleakness."
msgstr "Яркое пятно в этом тёмном мире."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_FERN_WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_FERN_WITHERED"
msgid "It's dead."
msgstr "Он мёртв."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.DEAD"
msgid "It's dead."
msgstr "Она мертва."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.GENERIC"
msgid "Has it ever been above ground?"
msgstr "Был ли он когда-нибудь на поверхности?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.SLEEPING"
msgid "It's asleep."
msgstr "Он спит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.VENTING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.VENTING"
msgid "It smells terrible."
msgstr "Пахнет ужасно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.GAS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.GAS"
msgid "That's unpleasant."
msgstr "Как противно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.GENERIC"
msgid "There's nothing coming out... for now."
msgstr "Оттуда ничего не выйдет... пока."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.HOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.HOT"
msgid "I prefer the cold's quiet embrace."
msgstr "Я предпочитаю тихие объятия холода."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.MIASMA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.MIASMA"
msgid "One could drown in that black fog."
msgstr "Ничего не стоит утонуть в этом чёрном тумане."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CEVICHE"
msgid "All I taste is my sadness..."
msgstr "Всё, что я чувствую, это моя печаль..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARCOAL"
msgid "Cold, dead and black, just like my heart."
msgstr "Холодный, мертвый и чёрный, такой же, как моё сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_HAND"
msgid "Do I dare approach?"
msgstr "Осмелюсь ли я приблизиться?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_HECKLER"
msgid "Their words can't hurt me. Well, maybe just a little..."
msgstr "Их слова не могут причинить мне боль. Ну, может быть, совсем немного..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_LECTURN"
msgid "Perhaps there is a small part for me to play."
msgstr "Возможно, мне предстоит сыграть небольшую роль."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_NPC"
msgid "Are you the true face of the darkness?"
msgstr "Ты ли истинное лицо тьмы?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_STAGE_POST"
msgid "The perfect place for a tragedy."
msgstr "Идеальное место для трагедии."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK1"
msgid "Cold, dead artificial life."
msgstr "Холодная, мёртвая, искусственная жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK2"
msgid "Cold, dead artificial life."
msgstr "Холодная, мёртвая, искусственная жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK3"
msgid "Cold, dead artificial life."
msgstr "Холодная, мёртвая, искусственная жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "Why did we sculpt an anchor."
msgstr "Зачем нам скульптура якоря?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ANTLION"
msgid "Still and lifeless."
msgstr "Неподвижная и безжизненная."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEARGER"
msgid "Ashes to ashes, bust to bust. Oh."
msgstr "Пепел в пепел, бюст в бюст. Ой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "Its new lease on life was, well, short-lived."
msgstr "Его новая жизнь была... недолгой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "Merely a cold, lifeless copy."
msgstr "Просто холодная, безжизненная копия."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "She once had a sweet life."
msgstr "Однажды, её жизнь была медом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "A piece, constrained to the board."
msgstr "Он ограничен своей шахматной доской."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "They're here."
msgstr "Они уже здесь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "But a simulacrum of life. Sigh."
msgstr "Лишь отражение жизни. Эх."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CARRAT"
msgid "If only I could feel so serene."
msgstr "Вот бы я могла быть такой безмятежной."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CATCOON"
msgid "A reminder of brighter days."
msgstr "Напоминание о светлых днях."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "Happiness is a warm puppy... but this one is cold."
msgstr "Тёплый щеночек приносит счастье... только вот этот холодный."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "It knows only fury."
msgstr "Он знает только ярость."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CRABKING"
msgid "We put him out of his misery."
msgstr "Мы избавили его от страданий."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "A reminder that kindness only leads to pain."
msgstr "Напоминание, что доброта ведёт только к боли."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "His pain led to anger."
msgstr "Его боль привела к злости."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "What a terrible beast."
msgstr "Какой ужасный зверь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "The beast came back even colder than before."
msgstr "Зверь вернулся ещё более холодным, чем раньше."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "How curious, the things we choose to commemorate."
msgstr "Любопытно, что мы выбираем для увековечения памяти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "She now lies, cold as stone."
msgstr "Теперь она лежит, холодная, как камень."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "Its stony gaze will glare for eternity."
msgstr "Его каменный взгляд будет сиять вечно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_FORMAL"
msgid "Alas, the king is but a figurehead, at best."
msgstr "Увы, король лишь подставное лицо."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "It won't be looking down on us anymore."
msgstr "Он больше не будет смотреть на нас сверху вниз."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "A cold mockery."
msgstr "Издевательство."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KITCOON"
msgid "Hubris, undoubtedly."
msgstr "Высокомерие, определённо."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KLAUS"
msgid "No more life in this festive spirit."
msgstr "Нет больше жизни в этом праздничном духе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "Oh, if I could ride away into the night."
msgstr "Ах, если бы я могла ускакать под покровом ночи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "They're here."
msgstr "Они уже здесь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "No more will she soar over the gloomy shoals."
msgstr "Она больше не будет парить над мрачными мелководьями."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "A fleeting moment of joy, captured in stone."
msgstr "Мимолётный миг радости, запечатлённый в камне."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "A testament to a lifetime spent alone in the dark."
msgstr "Свидетельство жизни, проведенной в одиночестве в темноте."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MOON"
msgid "I'd prefer to look at this over the real thing."
msgstr "Я бы предпочла посмотреть на неё, когда рядом настоящая."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "Such expression in her eyes."
msgstr "Такое выражение в его глазах."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MUSE"
msgid "She holds the true power, here."
msgstr "Здесь у неё настоящая власть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_PAWN"
msgid "We are all but pawns in this game called \"life\"."
msgstr "Все мы - лишь пешки в игре под названием \"жизнь\"."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_PIPE"
msgid "A bubble, frozen in time, can never pop."
msgstr "Пузырьки, застывшие во времени, никогда не лопнут."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "A mere minion to something greater."
msgstr "Простая, но важная фигура."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "They're here."
msgstr "Они уже здесь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "Their cold shark heart was just misunderstood."
msgstr "Её холодное акулье сердце было просто неправильно понято."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_STALKER"
msgid "Dark and cold, like my soul."
msgstr "Тёмный и холодный, как моя душа."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "A monument to fungal decay."
msgstr "Памятник грибковому разложению."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "I still remember watching the light leave their eyes."
msgstr "Я до сих пор помню их взгляд в тот момент, когда искра покидала их глаза."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "This doesn't capture its pain."
msgstr "Не передана та боль, которую он испытывал."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "It was built to bring death."
msgstr "Был построен, чтобы нести смерть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "Why was it able to come back? It's not fair..."
msgstr "Почему он смог вернуться? Это несправедливо..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "It consumed to fill its endless void."
msgstr "Он пытался заполнить свою бесконечную пустоту внутри."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTD"
msgid "If only I could have a new start."
msgstr "Если бы только я могла начать заново."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTH"
msgid "Not quite the fairy tale version."
msgstr "Его образ далёк от сказочного."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTS"
msgid "How curious, the things we choose to commemorate."
msgstr "Любопытно, что мы выбираем для увековечения памяти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER"
msgid "A fuzzy ball of emptiness."
msgstr "Пушистый и пустой мячик."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "It's looking into my soul."
msgstr "Он смотрит мне в душу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "Not so much sleeping as... waiting."
msgstr "Не столько спит, сколько... ждёт."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "It will make the emptiness in my chest grow even bigger..."
msgstr "Пустота в моей груди станет ещё больше..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "I did not expect that."
msgstr "Я такого не ожидала."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHUM"
msgid "I had a pet fish once... it didn't last very long."
msgstr "Была у меня однажды рыбка... долго она не продержалась."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYHOUND.GENERIC"
msgid "My, what big teeth you have."
msgstr "Боже мой, какие у тебя огромные зубы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYHOUND.STATUE"
msgid "Naught but a pithy imitation of life."
msgstr "Ничтожество, но имитирует жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYWARG.GENERIC"
msgid "To perish now would save me much sorrow."
msgstr "Умру сейчас — и сохраню так много слёз."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYWARG.STATUE"
msgid "There is no life in its eyes."
msgstr "В его глазах нет никакой жизни."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.EMBERS"
msgid "Darkness is looming."
msgstr "Тьма приближается."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.GENERIC"
msgid "I might survive this night!"
msgstr "Теперь я, возможно, и переживу эту ночь!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.HIGH"
msgid "A vision of a frozen-over Hell!"
msgstr "Видение замёрзшего Ада!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.LOW"
msgid "The gloom encroaches."
msgstr "Мрак подступает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.NORMAL"
msgid "It's a weird fire."
msgstr "Это странный костёр."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.OUT"
msgid "That is not a good sign."
msgstr "Нехороший знак."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "Darkness is looming."
msgstr "Тьма приближается."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "I might survive this night!"
msgstr "Теперь я, возможно, и переживу эту ночь!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.HIGH"
msgid "A vision of a frozen-over Hell!"
msgstr "Видение замёрзшего Ада!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.LOW"
msgid "The gloom encroaches."
msgstr "Мрак подступает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "It's a weird fire."
msgstr "Это странный костёр."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.OUT"
msgid "That is not a good sign."
msgstr "Нехороший знак."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLLAPSEDCHEST"
msgid "Is the emptyness all around us now?"
msgstr "Неужто пустота теперь среди нас?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "Восток."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.GENERIC"
msgid "I am directionless."
msgstr "У меня нет цели."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "Север."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "Северо-восток."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "Северо-запад."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.S"
msgid "North. No wait, South."
msgstr "Север. А, нет. Это юг."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "Юго-восток."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "Юго-Запад."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "Запад."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOST"
msgid "Rot and decay."
msgstr "Гниль и разложение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "I suppose this will do well enough."
msgstr "Полагаю, это сойдёт."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "Ashes to ashes."
msgstr "Прах к праху."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Dry and brittle."
msgstr "Сухо и хрупко."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "Food for worms."
msgstr "Еда для червей."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.WET"
msgid "It's far too watery, the poor plants might drown."
msgstr "Слишком мокро, бедные растения могут утонуть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTWRAP"
msgid "It's poop. Sigh."
msgstr "Это какашки. Эх."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CONSTRUCTION_PLANS"
msgid "Shall I even bother building this?"
msgstr "Должна ли я утруждать себя строить это?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKBOOK"
msgid "What's the point of filling my stomach when my heart remains empty..."
msgstr "Зачем наполнять мой желудок, если моё сердце так и останется пустым..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMANDRAKE"
msgid "It was a good death. You will be delicious."
msgstr "Это была незаурядная смерть. Она должна быть отменной на вкус."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMEAT"
msgid "The remaining blood has been cooked away."
msgstr "Вся кровь прожарилась."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMONSTERMEAT"
msgid "Cooked evil is still evil."
msgstr "Приготовленное зло остаётся злом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDSMALLMEAT"
msgid "Fire has purified it."
msgstr "Огонь очистил его."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTER"
msgid "Their faces are twisted with hunger."
msgstr "Их лица искривлены от голода."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTERHAT"
msgid "I'm protected, but at what cost to my dignity."
msgstr "Я защищена ценой моей гордости."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTERSHELL"
msgid "All that remains of its former occupant."
msgstr "Всё, что осталось от его прежнего обитателя."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "The writing has been smudged away, the words forgotten."
msgstr "Надпись стерлась, слова забыты."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.BURNT"
msgid "Burnt to a crisp."
msgstr "Сожжено дотла."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "Whatever's in there isn't dead yet."
msgstr "Что бы там ни варилось, оно ещё не до конца умерло."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "It needs to boil."
msgstr "Оно должно закипеть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.DONE"
msgid "Finally, food."
msgstr "Наконец-то, еда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.EMPTY"
msgid "As empty as my soul."
msgstr "Пустой, как моя душа."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOLANT"
msgid "It seems alive but not."
msgstr "Будто живая, но это не так."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COONTAIL"
msgid "It's matted, patchy and putrid."
msgstr "Он свалялся, измазался и весь провонялся."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN"
msgid "I could make a corny joke, but I'll refrain."
msgstr "Я могла бы пошутить про её форму, но, пожалуй, воздержусь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_COOKED"
msgid "This corn couldn't handle the heat."
msgstr "Эта кукуруза не выдержала жара."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_OVERSIZED"
msgid "I could pop enough corn for everyone."
msgstr "Кукурузы хватит на всех."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_SEEDS"
msgid "The seed of life, so tiny in my hand."
msgstr "Семя жизни, такое крошечное в моей руке."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Может, поиграем в переодевание, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_DOLL_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Может, поиграем в переодевание, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_FOOL_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Может, поиграем в переодевание, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_KING_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Может, поиграем в переодевание, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Может, поиграем в переодевание, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "So pretty."
msgstr "Милое платье."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Может, поиграем в переодевание, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_TREE_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Может, поиграем в переодевание, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "The fire has grown cold."
msgstr "Огонь остыл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "A gentle glow from a gentle creature."
msgstr "Нежный свет, исходящий от нежного существа."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "The fire has grown cold."
msgstr "Огонь остыл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "Somehow, its presence puts my mind at ease."
msgstr "Каким-то образом его присутствие успокаивает меня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "The fire has grown cold."
msgstr "Огонь остыл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "Look how it glitters in the firelight, Abigail!"
msgstr "Посмотри, как всё блестит в свете камина, Абигейл!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TRINKET"
msgid "I wonder whose head it toppled from."
msgstr "Интересно, с чьей головы это свалилось?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COZY_BUNNYMAN"
msgid "Poor creatures, sleep is only a temporary escape."
msgstr "Бедные создания, сон — это лишь временное спасение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING.GENERIC"
msgid "One of us will be sent to a watery grave..."
msgstr "Кто-то из нас упокоится в морской могиле..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING.INERT"
msgid "A crumbling edifice of sand... it's not even decorated."
msgstr "Разрушающееся сооружение из песка... оно даже не украшено."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_CANNONTOWER"
msgid "Futile."
msgstr "Тщетно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_CLAW"
msgid "It wants to drag me down to the icy depths of the sea."
msgstr "Они хотят утащить меня в ледяную пучину моря."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_ICEWALL"
msgid "You can't hide forever, crab."
msgstr "Ты не сможешь прятаться вечно, краб."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_MOB"
msgid "You're a pawn."
msgstr "Ты лишь пешка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "Is your agression an attempt to fill the void?"
msgstr "Твоя агрессия — это попытка заполнить пустоту внутри?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTERLAB"
msgid "Oh. The abyss is staring back at me..."
msgstr "Ой. Бездна смотрит на меня..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_BULBIN"
msgid "Its adorable face nearly brings me to tears."
msgstr "От его милой мордочки у меня слёзы на глаза наворачиваются."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_DRAGONLING"
msgid "My, what big eyes you have."
msgstr "Боже, какие у тебя больше глаза."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "May we gaze into the abyss... together."
msgstr "Можем ли мы заглянуть в бездну... вместе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_GLOMLING"
msgid "Its snuggles almost make me forget."
msgstr "Эти объятия почти заставляют меня забыться."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_KITTEN"
msgid "Cursed with nine lives. Poor thing."
msgstr "Проклят с девятью жизнями. Бедняга."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_LAMB"
msgid "The softest creature in the hardest world."
msgstr "Нежнейшее существо в жестоком мире."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "Your beauty will fade too, you know."
msgstr "Твоя красота тоже увянет, знаешь ли."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_PERDLING"
msgid "It's so happy."
msgstr "Оно так счастливо."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_PUPPY"
msgid "Blissfully unaware of mortal troubles..."
msgstr "В блаженном неведении о смертельной опасности..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CROW.GENERIC"
msgid "Take thy beak from out my heart!"
msgstr "Вынь из сердца клюв проклятый!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CROW.HELD"
msgid "He is mine."
msgstr "Теперь он мой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRUMBS"
msgid "The little guy is falling apart."
msgstr "Этот паренёк распадается на части."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "It has an aura of malevolence... and monkeyness."
msgstr "От неё несёт злом... и обезьянами."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTGRASS"
msgid "It never even knew it was alive. How fortunate."
msgstr "Мне нравится убивать что-нибудь маленькое."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTLESS"
msgid "Sigh. Very well, I'll play \"pirates\"."
msgstr "Эх-х. Ладно, я поиграю в \"пиратов\"."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTLICHEN"
msgid "Fleeting, just like life."
msgstr "Он угасает, как и любая жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTREEDS"
msgid "The blade has sentenced you to death."
msgstr "Люблю срезать всякие штуки."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTSTONE"
msgid "The better to mark graves with."
msgstr "Удобно для пометки могил."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER.GENERIC"
msgid "Kindness only begets more pain..."
msgstr "Доброта порождает лишь только больше боли..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "What a pitiful creature."
msgstr "Какое жалкое создание."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.BURIED"
msgid "A soul crushed by the weight of the inescapable past."
msgstr "Душа, раздавленная тяжестью неизбежного прошлого."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.GENERIC"
msgid "He seems hungry for power. Perhaps to fill the void within."
msgstr "Кажется, он жаждет власти. Возможно, чтобы заполнить пустоту внутри."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "The rage is a mask to hide his pain."
msgstr "Ярость — это маска, скрывающая его боль."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "It is too strong, and I am too weak."
msgstr "Оно слишком сильно, а я слишком слаба."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "We are all tethered to this place in one way or another."
msgstr "Все мы заключены в этом месте, так или иначе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEADLYFEAST"
msgid "This, a fitting final meal."
msgstr "Это моё последнее угощение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEAD_SEA_BONES"
msgid "The sea rejects its dead."
msgstr "Море отвергает своих мертвецов."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "It's burning brightly."
msgstr "Ярко горит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Used up and done for."
msgstr "Отгорела своё, и крышка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "Everything dies."
msgstr "Ничто не вечно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "This tree is spooky. I bet it likes Halloween."
msgstr "Это дерево вгоняет в дрожь. Могу поспорить, ему нравится Хеллоуин."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "Extra-spooky!"
msgstr "Жу-у-у-у-уть!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECK_OF_CARDS"
msgid "Suppose I can play Solitaire."
msgstr "Полагаю, теперь я могу раскладывать пасьянс."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_CENTERPIECE"
msgid "The mortal obsession with material things."
msgstr "Смертная одержимость материалистичными вещами."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "I feel the urge to stare into it."
msgstr "Чувствую соблазн туда заглянуть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "It's illuminating... for now."
msgstr "Освещает... пока что."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "We pulled the flowers from their homes for our own amusement."
msgstr "Мы вырвали цветы из их родных мест ради нашего удовольствия."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "It, too, will die."
msgstr "И тебе тоже не жить вечно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "I think it's lovelier this way..."
msgstr "По-моему, так даже прекраснее..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_LAMP"
msgid "Great."
msgstr "Прекрасно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "It will be worth more after the artist dies."
msgstr "Будет стоить больше, когда автор помрёт."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "Leave it."
msgstr "Оставь как есть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "In the end, all we have are pictures."
msgstr "В конце концов, всё, что у нас останется, это картинки."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER.ANTLER"
msgid "That horn won't protect you."
msgstr "Этот рог не защитит вас."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER.GENERIC"
msgid "It lives in a constant state of fear."
msgstr "Он живет в постоянном страхе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPS"
msgid "Death incarnate!"
msgstr "Воплощение смерти!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "Ashes to ashes."
msgstr "Прах к праху."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "This body is nothing but an empty vessel."
msgstr "Это тело - всего лишь пустая оболочка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "You should stay down."
msgstr "Лучше бы тебе не вставать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "No colder than a world without Abigail."
msgstr "Также холоден, как мир без Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "Hot. Cold. What does it matter?"
msgstr "Горячо. Холодно. Какая разница?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "I guess I could set this up and be helpful."
msgstr "Полагаю, могу построить это и побыть полезной."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "What terrors must it see."
msgstr "Какие ужасы он должен лицезреть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER_ANTLER"
msgid "We have grabbed life by its horn... though I wish we hadn't."
msgstr "Мы захватили жизнь этим рогом... хотя я бы хотела, чтобы мы этого не делали."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER_GEMMED"
msgid "Some chains are physical..."
msgstr "Некоторые цепочки являются физическими..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "The remains of a tuft of grass."
msgstr "Остатки травы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DESERTHAT"
msgid "Now no one can tell when I'm crying."
msgstr "Теперь никто не сможет сказать о том, что я плачу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DESICCANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DESICCANT"
msgid "It can't dry away all my tears."
msgstr "Ему не высушить все мои слёзы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DESICCANTBOOSTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DESICCANTBOOSTED"
msgid "I can't remember the last time my eyes were dry."
msgstr "Не помню, когда в последний раз мои глаза были сухи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIRTPILE"
msgid "Oh look. More dirt."
msgstr "Ты посмотри. Опять грязь..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.COLD"
msgid "The source is distant."
msgstr "Источник где-то далеко."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.GENERIC"
msgid "It is forever seeking its lost half."
msgstr "Он обречён вечно искать свою потерянную половинку."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.HOT"
msgid "Something wicked is here!"
msgstr "Что-то злое прямо здесь!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.WARM"
msgid "The wickedness draws closer."
msgstr "Что-то страшное всё ближе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.WARMER"
msgid "It is very close now."
msgstr "Уже очень близко."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "What does this newfangled thing do?"
msgstr "Что эта модерновая штуковина делает?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.READY"
msgid "It still needs a large key."
msgstr "Тут по-прежнему не хватает ключа. Немаленького ключа."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "What mysteries will be revealed!"
msgstr "Посмотрим, что там!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODSTART"
msgid "I could use that."
msgstr "Я могу это использовать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DOCK_KIT"
msgid "I will build it, but no one will come."
msgstr "Я построю его, но никто не придёт."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "What would be the point?"
msgstr "Какой в них смысл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DOLL_BLUEPRINT"
msgid "It's pretty."
msgstr "Он красивый."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBOAT_KIT"
msgid "I can help set this up, I guess."
msgstr "Я могу помочь это установить. Наверное."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBOAT_PACK"
msgid "I suppose I can make myself useful in some small way and put it together."
msgstr "Полагаю я могу побыть немного полезной и помочь её установить."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBODYHAT"
msgid "The belly of the beast."
msgstr "Живот зверя."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONCHILISALAD"
msgid "I missed having someone make me dinner..."
msgstr "Я скучаю по временам, когда кто-то готовил мне обед..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLY"
msgid "It's burning on the inside."
msgstr "Внутри неё пламя."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "Boom box."
msgstr "Бум бокс."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "It holds multitudes, and refuses to burn away."
msgstr "Он удерживает множество вещей и отказывается гореть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Its teeth do not even gnash."
msgstr "Какие зубы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "Pathetic."
msgstr "Жалкий."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "No need to lean in and check if it's hot. I can feel it from here."
msgstr "Я и отсюда чувствую его жар."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Burns hot... but not bright..."
msgstr "Жарко... но не ярко..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT"
msgid "This isn't shaped like a dragon at all."
msgstr "На вид не очень питает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "Still not a dragon. At least it's dead."
msgstr "Всё ещё не питает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "It nearly became a dragon."
msgstr "Она почти превратилась в дракона."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "It's a seed."
msgstr "Семечко."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONHEADHAT"
msgid "What big eyes you have."
msgstr "Какие у тебя большие глаза."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONPIE"
msgid "Well, at least it's a pie now."
msgstr "Ну, по крайней мере, теперь это пирог."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONTAILHAT"
msgid "That's just a tall tail."
msgstr "Это просто длинный хвост."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGON_SCALES"
msgid "Scales of pain."
msgstr "Чешуйки, пронизанные болью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONE"
msgid "It is cold... and beautiful."
msgstr "Холодный... и прекрасный."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONEHAT"
msgid "What's the point?"
msgstr "Какой смысл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONE_STACK"
msgid "Do I dare imagine what kind of darkness it grew from?"
msgstr "Осмелюсь ли я представить, из какой тьмы это выросло?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_LOG"
msgid "Bleached like bones left in the sun."
msgstr "Обесцвеченное, как кости, оставленные на солнце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "Oh. It's burning."
msgstr "О. Оно горит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "Your suffering is over now."
msgstr "Твои страдания закончились."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "It's met its end at our hands."
msgstr "Оно встретило свой конец в наших руках."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "The bleached remains of a dead tree."
msgstr "Обесцвеченные останки мертвого дерева."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRUMSTICK"
msgid "Makes a good thud, and it's nutritious!"
msgstr "Ей можно неслабо шмякнуть, а ещё она питательная!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRUMSTICK_COOKED"
msgid "Less raw, more tasty."
msgstr "Менее сырое, более вкусное."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BANANABUSH"
msgid "Bananas that grow in the sun... how unnatural."
msgstr "Бананы, которые растут под солнцем... как непривычно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BERRYBUSH"
msgid "How sad. You've no home."
msgstr "Как грустно. У тебя не дома."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "How does it feel to be ripped from your home?"
msgstr "Каково быть оторванным от своего дома?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_GRASS"
msgid "I like it dead, but it should probably be returned to the earth."
msgstr "Жаль, что это растение живое, придётся его посадить."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_MARSH_BUSH"
msgid "I like it dead, but it should probably be returned to the earth."
msgstr "Жаль, что это растение живое, придётся его посадить."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_MONKEYTAIL"
msgid "Oh. They're so soft. And fuzzy."
msgstr "Оу. Они такие мягкие. И пушистые."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_SAPLING"
msgid "I like it dead, but it should probably be returned to the earth."
msgstr "Жаль, что это растение живое, придётся его посадить."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_TRAP_STARFISH"
msgid "A pity it didn't crunch me up when it had the chance."
msgstr "Как жаль, что он не сжевал меня, когда у него был шанс."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL"
msgid "Oh. It's very heavy."
msgstr "Оу. Она очень тяжёлая."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "It chills me to my core."
msgstr "От неё у меня леденеет сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_GEM"
msgid "Who would choose to carry such a burden..."
msgstr "Кто бы решился нести такое бремя..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_GOLDEN"
msgid "It's almost as heavy as my heart."
msgstr "Почти так же тяжело, как и у меня на сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_HEAT"
msgid "It may warm the body, but not the heart."
msgstr "Оно может согреть моё тело, но не сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_MARBLE"
msgid "We all carry a great weight. His seems... a bit more literal, though."
msgstr "Все мы несём на себе тяжкий груз. А он... носит его буквально."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_REDGEM"
msgid "It inflicts burning pain."
msgstr "Вызывают жгучую боль."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN"
msgid "Spiky and smelly!"
msgstr "Колючий и вонючий!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_COOKED"
msgid "Less spiky, but even smellier!"
msgstr "Не такой колючий, но ещё более вонючий!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_OVERSIZED"
msgid "Why did this one have to grow so large?"
msgstr "И зачем он вырос таким большим?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_SEEDS"
msgid "It's a plant that's waiting to be."
msgstr "Это растение, которое ждёт своего часа."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMERINGUE"
msgid "A treat devoid of sweetness..."
msgstr "Лакомство, лишённое сладости..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMOTH"
msgid "They seem to live only to clean. What a tiresome life."
msgstr "Видимо, они только живут, чтобы чистить. Какая скучная жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMOTHDEN"
msgid "Poor things, their home is no longer safe from us."
msgstr "Бедняги, их дома больше не в безопасности от нас."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EARMUFFSHAT"
msgid "Their bitter end offers protection from the bitter cold."
msgstr "Их лютая смерть даст мне защиту от лютых морозов."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EEL"
msgid "An eel."
msgstr "Просто угорь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EEL_COOKED"
msgid "An eel that has been cooked."
msgstr "Просто приготовленный угорь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT"
msgid "Almost a deadly nightshade. Almost."
msgstr "Почти что смертельная белладонна. Почти что."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_COOKED"
msgid "Cooking this nightshade made it even less deadly."
msgstr "Приготовление этой «белладонны» сделало её ещё менее смертельной."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "Unfortunately it's not poisonous, despite its sickly purple shade."
msgstr "К сожалению, он не ядовит, несмотря на свой болезненный фиолетовый оттенок."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_SEEDS"
msgid "It's a plant that's waiting to be."
msgstr "Это растение, которое ждёт своего часа."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ELIXIR_CONTAINER"
msgid "If only I could have helped you then."
msgstr "Если бы только я могла помочь тебе так же, как сейчас, но раньше."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EMBERLIGHT"
msgid "At least it warms my hands."
msgstr "По крайней мере, оно согревает мне руки."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.BURNT"
msgid "Nothing lasts forever."
msgstr "Ничто не вечно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.EMPTY"
msgid "The shadow equivalent of taxidermy. I like it."
msgstr "Теневое подобие чучела. Мне нравится."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "It's illuminating... for now."
msgstr "Он светит... пока что."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.GENERIC"
msgid "We pulled the flowers from their homes for our own amusement."
msgstr "Мы вырвали цветы из их домов для нашего развлечения."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "It, too, will die."
msgstr "В этом мире всё имеет свой конец."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.WILTED"
msgid "I think it's lovelier this way..."
msgstr "Я думаю, что так милее..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.BURNING"
msgid "It's burning brightly."
msgstr "Ярко горит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.BURNT"
msgid "Used up and done for."
msgstr "Отгорела своё, и крышка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.CHOPPED"
msgid "Everything dies."
msgstr "Ничто не вечно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.GENERIC"
msgid "Nature is so boring."
msgstr "Природа такая скучная."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "It's burning brightly."
msgstr "Ярко горит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Used up and done for."
msgstr "Отгорела своё, и крышка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "Everything dies."
msgstr "Ничто не вечно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "Its cycle of life is ending."
msgstr "Её жизненный цикл подходит к концу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEBRELLAHAT"
msgid "That's one stretchy eye."
msgstr "Какой эластичный глаз."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEMASKHAT"
msgid "I am the beholder of the eye."
msgstr "Я носитель ока."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR"
msgid "Beware the evil eye."
msgstr "Остерегайтесь дурного глаза."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR_MINI"
msgid "I can feel the sting of their sharp gaze..."
msgstr "Я чувствую их острые взгляды..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "One more blight will be brought into this world."
msgstr "Ещё одно бедствие будет принесено в этот мир."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEPLANT"
msgid "They follow their master's every wish."
msgstr "Они исполнят любое желание своего хозяина."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYETURRET"
msgid "I do not know why it helps me."
msgstr "Я не знаю, почему он помогает мне."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYETURRET_ITEM"
msgid "I think it needs to be placed."
msgstr "Думаю, надо его где-нибудь поставить."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.BURNT"
msgid "This earth is burnt and dead."
msgstr "Эта почва выжжена и мертва."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.GENERIC"
msgid "What seeds shall I sow?"
msgstr "Какое семя мне взрастить сегодня?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.GROWING"
msgid "Leafy tendrils coil out of the muck."
msgstr "Побеги листьев пробиваются из грязи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "This earth is cold and dead."
msgstr "Почва, мёртвая и холодная."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_HOE"
msgid "I must prepare the seeds for their burial."
msgstr "Я должна приготовить семена к их захоронению."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.BURNING"
msgid "All that work, destroyed..."
msgstr "Столько работы, и всё уничтожено..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL"
msgid "How cruel, that I must now steal the fruits of your labor."
msgstr "Как жестоко, что я вынуждена украсть плоды твоего труда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "However did it grow so big?"
msgstr "Как он смог вырасти таким большим?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "It is the tragic fate of all weeds to be spurned from the garden."
msgstr "Эта трагичная судьба всех сорняков - быть изгнанными из огорода."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.GENERIC"
msgid "A plant."
msgstr "Растение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.GROWING"
msgid "Despite the horrors of the world, it seems intent on living."
msgstr "Несмотря на ужасы этого мира, он, кажется, полон решимости жить."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "There's nothing I can do for it."
msgstr "Я больше ничего не могу сделать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "Dead and rotting."
msgstr "Мертво и разлагается."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.SEED"
msgid "Is it cold down there, alone in the ground?"
msgstr "А холодно там, под землёй, одному?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLOW"
msgid "It's fighting against the ground."
msgstr "Оно борется с землёй."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLOW_ITEM"
msgid "I suppose I must find a place for the garden."
msgstr "Полагаю, мне стоит найти место для огорода."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "You don't belong here."
msgstr "Тебе здесь не место."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERFAN"
msgid "That'll make quite a draft."
msgstr "Ах, сколько задумок им можно было бы записать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERHAT"
msgid "Ca-caw!"
msgstr "Ка-а-ар!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERPENCIL"
msgid "M...maybe I'll doodle something... When no one's looking."
msgstr "М... может быть я немного порисую... Пока никто не видит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_CANARY"
msgid "A canary feather, golden as the gilded cage."
msgstr "Перо канарейки, золотое как позолоченная клетка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_CROW"
msgid "A soft feather, black like eternal darkness."
msgstr "Перо ворона, черно как сама тьма."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_ROBIN"
msgid "A redbird feather, red like blood."
msgstr "Перо красной птицы, алое, как кровь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "A snowbird feather, white as the light at the end of the tunnel."
msgstr "Перо снежной птицы, белое как свет в конце тоннеля."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEM_PUPPET"
msgid "I wonder what she did."
msgstr "Гадаю, что она натворила."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE"
msgid "Sort of like an emotional barrier. But wood."
msgstr "Это как эмоциональный барьер. Только деревянный."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC.GENERIC"
msgid "What a lonely post."
msgstr "Какой одинокий столбик."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC.LINKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC.LINKED"
msgid "It fulfills its purpose in connection."
msgstr "Его предназначение выполняется через связь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC_ITEM"
msgid "It's no use to anyone like that."
msgstr "Так он бесполезен."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_GATE"
msgid "Will it keep others in, or out?"
msgstr "Они удержат кого-нибудь внутри или снаружи?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_GATE_ITEM"
msgid "We could use it to build a gate."
msgstr "Это можно использовать для постройки ворот."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ITEM"
msgid "We could use it to build a fence."
msgstr "Это можно использовать для постройки забора."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_JUNK"
msgid "Even these discarded pieces can manage to be useful."
msgstr "Даже эти выброшенные части могут быть полезны."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ROTATOR"
msgid "Disorderly fences need to be brought into line."
msgstr "Беспорядочные заборы должны быть приведены в соответствие."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FERTILIZER"
msgid "A bucket of grime."
msgstr "Ведро с нечистотами."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FESTIVEFISH"
msgid "It's about as festive as I feel."
msgstr "Она такая же праздничная, как и моё настроение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "It's so colorful, it hurts my eyes."
msgstr "Он настолько красочный, что у меня болят глаза."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIG"
msgid "Abigail always told me they were filled with wasps."
msgstr "Абигейл всегда говорила мне, что в них полно ос."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIGATONI"
msgid "The fig cowers in its pasta shell."
msgstr "Фига прячется от мира в пасте."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIGKABAB"
msgid "The fig pieces look like little pierced hearts."
msgstr "Кусочки фиги выглядят как пронзённые сердца."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIG_COOKED"
msgid "Any wasps it held seem to have been burned away."
msgstr "Похоже, все осы внутри сгорели дотла."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREBALLSTAFF"
msgid "To call death from the skies."
msgstr "Призывает смерть с небес."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRECRACKERS"
msgid "It needs only a light."
msgstr "Остаётся только их поджечь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREFLIES.GENERIC"
msgid "A tiny brightness in the dark."
msgstr "Крохи света в беспроглядной тьме."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREFLIES.HELD"
msgid "Tiny lights, stranded from the world outside my pocket."
msgstr "Крошечные огоньки, спрятанные от внешнего мира в карман."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREHOUND"
msgid "His disposition is fiery."
msgstr "У неё вспыльчивый нрав."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRENETTLES"
msgid "They sting terribly."
msgstr "Невероятно больно жалят."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRENETTLES_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRENETTLES_DRIED"
msgid "I like how they smell."
msgstr "Мне нравится их аромат."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPEN"
msgid "Father had one very similar. I doubt it ever started a fire, though."
msgstr "У отца было очень похожее. Хотя я сомневаюсь, что из-за него когда-либо начинался пожар."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.EMBERS"
msgid "Don't give up, little flame!"
msgstr "Не сдавайся, огонёк!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.GENERIC"
msgid "A flame to keep the horrors at bay."
msgstr "Пламя, держащее в ужасе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.HIGH"
msgid "This fire burns with passion!"
msgstr "Этот огонь горит со страстью!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.LOW"
msgid "It's losing the will to go on."
msgstr "Он теряет желание существовать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.NORMAL"
msgid "It's a comfort."
msgstr "Приятно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.OUT"
msgid "This can be rekindled, unlike my heart."
msgstr "Его можно снова разжечь, в отличие от моего сердца."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESTAFF"
msgid "The world will burn before this staff."
msgstr "Я могла бы предать весь мир пламени!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "It's running on fumes."
msgstr "Пыхтит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Quiet as a corpse."
msgstr "Молчит как покойник."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "I don't know why you bother. We're all going to burn."
msgstr "К чему волноваться? Нам всем суждено гореть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH"
msgid "It was flopping around desperately for life. The poor fool."
msgstr "Она беспечно бултыхалась тут всю свою жизнь. Глупышка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHINGNET"
msgid "To ensnare fish and tear them from their peaceful lives."
msgstr "Чтобы ловить рыб и отрывать их от своих мирных жизней."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHINGROD"
msgid "With this the fishies will be ripped from the safety of their precious pond."
msgstr "Этим я смогу выдёргивать рыбок из их драгоценного безопасного пруда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT"
msgid "It's been decapitated."
msgstr "Она обезглавлена."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_COOKED"
msgid "A proper grilling puts a stop to the flopping."
msgstr "Качественная прожарка положила конец её предсмертным трепыханиям."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_DRIED"
msgid "The dessicated remains of a fish."
msgstr "Высушенные останки рыбы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL"
msgid "There are other fish in the sea. Bigger ones, hopefully."
msgstr "В море есть и другие рыбы. Надеемся, большие."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "It will... tide... me over for now."
msgstr "Её будет... достаточно... мне сейчас."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL_DRIED"
msgid "Withered away to almost nothing."
msgstr "Почти полностью высох."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHSTICKS"
msgid "Perfectly molded blocks of fish."
msgstr "Хорошенько спрессованные кусочки рыбы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHTACOS"
msgid "Hopefully no bones still linger within."
msgstr "Надеюсь, я все косточки повытаскивала."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH_BOX"
msgid "It feels a bit cruel to trap them within sight of freedom."
msgstr "Мне кажется жестоким, заманивать их в ловушку и заставлять смотреть на свободу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH_COOKED"
msgid "A proper grilling puts a stop to the flopping."
msgstr "Качественная прожарка положила конец её предсмертным трепыханиям."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLINT"
msgid "A tiny blade-like rock."
msgstr "Маленький лезвиеподобный камень."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.DEFLATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.DEFLATED"
msgid "I knew it couldn't last."
msgstr "Я знала, что долго он не продержится."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.GENERIC"
msgid "It does lift my spirits... a little."
msgstr "Поднимает мне настроение... Слегка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.HELD"
msgid "I should save this for when it's darkest."
msgstr "Стоит сохранить его, пока совсем не стемнеет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOTATIONCUSHION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOTATIONCUSHION"
msgid "One does not need water to drown."
msgstr "Чтобы утонуть, не всегда нужна вода."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER.GENERIC"
msgid "They are bright and cheery. Yuck."
msgstr "Они яркие и радостные. Фу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER.ROSE"
msgid "Prickly and blood red..."
msgstr "Шипастая и кроваво-красная..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWERHAT"
msgid "But I am in mourning..."
msgstr "Но я же в трауре..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWERSALAD"
msgid "Ugh, more flowers."
msgstr "Фу, снова цветы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_CAVE"
msgid "It looks fragile."
msgstr "Выглядит хрупким."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_CAVE_WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_CAVE_WITHERED"
msgid "There's a sadness about how it flickers."
msgstr "В том, как он мерцает, есть какая-то печаль."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_EVIL"
msgid "At least they're better than the other flowers."
msgstr "Эти, на мой взгляд, получше, чем прочие цветочки."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_WITHERED"
msgid "This is the fate of all things."
msgstr "Во всём виноват злой рок."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOLIAGE"
msgid "Lead me to the Aarnivalkea."
msgstr "Приведи меня к блуждающему огоньку."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOLIAGE_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOLIAGE_DRIED"
msgid "I like how they smell."
msgstr "Мне нравится её аромат."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOOTBALLHAT"
msgid "A dead thing for me to wear. Goody."
msgstr "Убийственная вещь. Круто."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FORGETMELOTS"
msgid "They are rather pretty for a weed."
msgstr "Довольно красивая для сорняка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FORGETMELOTS_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FORGETMELOTS_DRIED"
msgid "I like how they smell."
msgstr "Мне нравится её аромат."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FORMAL_BLUEPRINT"
msgid "It looks very dignified."
msgstr "Он выглядит очень достойно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_PIECE"
msgid "It is death, preserved."
msgstr "Смерть в чистом виде."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "What horrors have we resurrected here today?"
msgstr "Какие ужасы мы найдём тут сегодня?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "Death has a sense of humor."
msgstr "У смерти есть чувство юмора."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "We must find more pieces."
msgstr "Нам нужно найти много частей."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRESHFRUITCREPES"
msgid "Could I get this a la mode?"
msgstr "А можно их ещё и в вине погасить?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRIENDLYFRUITFLY"
msgid "Oh. It seems to be friendly."
msgstr "О. Похоже, она настроена дружелюбно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.DEAD"
msgid "Life is small and short."
msgstr "Жизнь бессмысленна и коротка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.GENERIC"
msgid "He's little and warty."
msgstr "Маленькая и бородавчатая."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.SLEEPING"
msgid "He's asleep."
msgstr "Она спит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGFISHBOWL"
msgid "It's actually... really good..."
msgstr "На самом деле... очень вкусно..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGGLEBUNWICH"
msgid "I never thought frog's legs could look so good."
msgstr "Никогда бы не подумала, что лапки лягушек могут быть такими милыми."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGLEGS"
msgid "Torn right from the frog."
msgstr "Оторваны прям от лягушки."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGLEGS_COOKED"
msgid "Definitely not twitching any longer."
msgstr "Теперь уж точно не подёргиваются."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGNEWTON"
msgid "Sweet and only a little slimy."
msgstr "Сладкий и немного склизкий."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "This won't be of help to my cold, cold heart."
msgstr "Он не поможет моему холодному-прехолодному сердцу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "It prefers to be alone."
msgstr "Она предпочитает одиночество."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.RIPE"
msgid "You simply look too delicious."
msgstr "Ты просто выглядишь слишком аппетитно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "It is arrested by deepest sleep."
msgstr "Её останавливает глубочайший сон."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITFLY"
msgid "They have no respect for living things."
msgstr "У них нет никакого уважения к живым существам."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITFLYFRUIT"
msgid "Now you may trade your lord for a queen."
msgstr "Теперь ты можешь обменять своего повелителя на королеву."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITMEDLEY"
msgid "Sweet, tart and in a cup."
msgstr "Сладкий, терпкий и в стаканчике."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FURTUFT"
msgid "This came from a living creature."
msgstr "Это получилось из живого существа."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUSED_SHADELING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUSED_SHADELING"
msgid "It knows nothing but pain and hunger."
msgstr "Оно не знает ничего, кроме боли и голода."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUSED_SHADELING_BOMB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUSED_SHADELING_BOMB"
msgid "They lead such short, explosive lives."
msgstr "Они ведут такую короткую, взрывоопасную жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GARGOYLE_HOUND"
msgid "A \"puppy\", frozen in time..."
msgstr "\"Щенок\", застывший во времени..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GARGOYLE_WEREPIG"
msgid "I can make that face too..."
msgstr "Я могу сделать такое же лицо."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GARLIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GARLIC"
msgid "It gives food flavor."
msgstr "Он придаёт еде аромат."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GARLIC_COOKED"
msgid "It smells a bit nice."
msgstr "От него слегка приятно пахнет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GARLIC_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GARLIC_OVERSIZED"
msgid "Oh. It's nicely braided."
msgstr "О. Он красиво заплетён."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GARLIC_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Жизнь, которую они содержат, является загадкой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GAZPACHO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GAZPACHO"
msgid "Cold and watery like a sailor's grave."
msgstr "Холодное и водянистое, как могила моряка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GEARS"
msgid "The insides of a mechanical demon."
msgstr "Внутренности механического демона."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GELBLOB.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GELBLOB.GENERIC"
msgid "Looks sticky."
msgstr "Выглядит липко."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GELBLOB.HAS_CHARACTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GELBLOB.HAS_CHARACTER"
msgid "They probably need help."
msgstr "Им, наверное, стоило бы помочь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GELBLOB.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GELBLOB.HAS_ITEM"
msgid "I don't know if it's worth it."
msgstr "Не знаю, стоит ли оно того."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GELBLOB_BOTTLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GELBLOB_BOTTLE"
msgid "I have an urge to toss it."
msgstr "У меня возникает непреодолимое желание бросить её."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GELBLOB_STORAGE.FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GELBLOB_STORAGE.FULL"
msgid "Some things can't be preserved."
msgstr "Некоторые вещи нельзя сохранить."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GELBLOB_STORAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GELBLOB_STORAGE.GENERIC"
msgid "Not so dangerous now..."
msgstr "Теперь он не такой опасный..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GELBLOB_STORAGE_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GELBLOB_STORAGE_KIT"
msgid "Child's play."
msgstr "Детская игра."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GEMSOCKET.GEMS"
msgid "It looks so empty."
msgstr "Тут, похоже, чего-то не хватает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GEMSOCKET.VALID"
msgid "The gem has focused it."
msgstr "Камень сфокусировал его."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GENERIC_CORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GENERIC_CORPSE.BURNING"
msgid "May you find peace."
msgstr "Может, ты обретёшь покой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GENERIC_CORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GENERIC_CORPSE.GENERIC"
msgid "The shadow of death lies upon it."
msgstr "На нём лежит тень смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GENERIC_CORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GENERIC_CORPSE.REVIVING"
msgid "Awakened from its eternal slumber."
msgstr "Пробудился от вечного сна."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GESTALT"
msgid "I can feel their fear and loneliness."
msgstr "Я чувствую их страх и одиночество."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GESTALT_CAGE.FILLED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GESTALT_CAGE.FILLED"
msgid "It's trapped inside."
msgstr "Сущность заключена внутри."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GESTALT_CAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GESTALT_CAGE.GENERIC"
msgid "Empty."
msgstr "Пусто."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GESTALT_GUARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GESTALT_GUARD"
msgid "I don't think they want us here."
msgstr "Не думаю, что они хотят чтобы мы были здесь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GESTALT_GUARD_EVOLVED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GESTALT_GUARD_EVOLVED"
msgid "I would be angry too."
msgstr "Я бы тоже злилась."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOST"
msgid "He has risen from the grave!"
msgstr "Он восстал из могилы!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTFLOWER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTFLOWER"
msgid "I promise to use it well."
msgstr "Я обещаю хорошо с ним обходиться."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTFLOWERHAT"
msgid "That I may walk a mile under your veil, Abby."
msgstr "Это словно твоя вуаль, Абби, с которой могу теперь ходить и я."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_ATTACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_ATTACK"
msgid "Abigail was always the strong one."
msgstr "Абигейл всегда была сильным близнецом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_FASTREGEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_FASTREGEN"
msgid "You have to take your medicine, Abigail."
msgstr "Ты должна принимать лекарства, Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_LUNAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_LUNAR"
msgid "You'll leave them reeling, Abby."
msgstr "Они растеряются, Абби."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_RETALIATION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_RETALIATION"
msgid "It has a bitter aftertaste."
msgstr "У него горьковатый привкус."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_REVIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_REVIVE"
msgid "You'll feel like yourself again soon, Abby."
msgstr "Скоро ты снова почувствуешь себя собой, Абби."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_SHADOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_SHADOW"
msgid "Abby will make a big impression."
msgstr "Абби произведёт большое впечатление."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_SHIELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_SHIELD"
msgid "This time... I can protect you."
msgstr "В этот раз... я защищу тебя."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN"
msgid "It's all I can do to help..."
msgstr "Это все, что я могу сделать, чтобы помочь..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_SPEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GHOSTLYELIXIR_SPEED"
msgid "It's quite sugary."
msgstr "Он довольно сладкий."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GIFT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GIFT"
msgid "The only gift I desire is a swift end..."
msgstr "Единственный подарок, который я желаю, это быстрый конец..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GIFTWRAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GIFTWRAP"
msgid "Abby... how do I make the ribbon curly?"
msgstr "Абби... как сделать ленту волнистой?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GINGERBREADHOUSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GINGERBREADHOUSE"
msgid "Temporary joy, meant to be consumed."
msgstr "Временная радость, предназначенная быть поглощенной."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GINGERBREADPIG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GINGERBREADPIG"
msgid "No one wants to be my friend."
msgstr "Никто не хочет быть моим другом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GINGERBREADWARG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GINGERBREADWARG"
msgid "Horrible evil in a festive coating."
msgstr "Ужасное зло в праздничном наряде."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GLASSBLOCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GLASSBLOCK"
msgid "A moment frozen in time."
msgstr "Момент, застывший во времени."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GLASSCUTTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GLASSCUTTER"
msgid "It visits death upon all who face it."
msgstr "Смерть настигает всех, кто встречается с ним."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GLASSSPIKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GLASSSPIKE"
msgid "My warped reflection stares back at me with malice."
msgstr "Моё деформированное отражение смотрит на меня со злобой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GLOMMER.GENERIC"
msgid "Well aren't you a happy little fuzzball. Die."
msgstr "Ну что за счастливый маленький комочек шерсти? Умри."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GLOMMER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GLOMMER.SLEEPING"
msgid "Is it dead? Oh, just sleeping."
msgstr "Он мёртв? Ох, просто спит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GLOMMERFLOWER.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GLOMMERFLOWER.DEAD"
msgid "Even flowers of the night die."
msgstr "Смерть собрала себе в букет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GLOMMERFLOWER.GENERIC"
msgid "Flower of the night."
msgstr "Цветок ночи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GLOMMERFUEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GLOMMERFUEL"
msgid "Fuzzball excrement."
msgstr "Пушистый помёт."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GLOMMERWINGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GLOMMERWINGS"
msgid "Even his wings are small and cheery."
msgstr "Даже его маленькие крылышки излучают жизнерадостность."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GLOWBERRYMOUSSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GLOWBERRYMOUSSE"
msgid "It swirls like the endless abyss."
msgstr "Она кружится, как бесконечная бездна."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GNARWAIL.BROKENHORN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GNARWAIL.BROKENHORN"
msgid "Some things remain broken forever."
msgstr "Некоторые вещи остаются сломанными навечно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER"
msgid "You've lost something dear to you too, haven't you?"
msgstr "Ты тоже потерял что-то дорогое для тебя, не так ли?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GNARWAIL.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GNARWAIL.FOLLOWER"
msgid "Do you really wish to come with me?"
msgstr "Ты впрямь желаешь последовать за мной?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GNARWAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GNARWAIL.GENERIC"
msgid "I cannot escape its piercing gaze... or horn."
msgstr "Мне не избежать его пронзительного взгляда... или рога."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GNARWAIL_HORN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GNARWAIL_HORN"
msgid "It's so sharp..."
msgstr "Такой острый..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GOATMILK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GOATMILK"
msgid "I think it's curdled."
msgstr "Я думаю, оно свернулось."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GOGGLESHAT"
msgid "They're just for show."
msgstr "Они просто для шоу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GOLDENAXE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GOLDENAXE"
msgid "One might as well kill trees with style."
msgstr "По крайней мере теперь я смогу убивать деревья с шиком."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GOLDENPICKAXE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GOLDENPICKAXE"
msgid "One might as well smash rocks with style."
msgstr "По крайней мере теперь я смогу крошить камни с шиком."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GOLDENPITCHFORK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GOLDENPITCHFORK"
msgid "One might as well till fields with style."
msgstr "По крайней мере теперь я смогу вспахать землю с шиком."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GOLDENSHOVEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GOLDENSHOVEL"
msgid "One might as well dig with style."
msgstr "По крайней мере теперь я смогу копать с шиком."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GOLDEN_FARM_HOE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GOLDEN_FARM_HOE"
msgid "One might as well garden in style."
msgstr "По крайней мере теперь я смогу возделывать почву с шиком."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GOLDNUGGET"
msgid "Even in purgatory it remains the most precious of metals."
msgstr "Я возьму его с собой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GOOSE_FEATHER"
msgid "Plucked, just like Abigail was from me."
msgstr "Оторвано, как и Абигейл от меня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASS.BARREN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASS.BARREN"
msgid "It needs poop."
msgstr "Её нужно удобрить."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASS.BURNING"
msgid "It smells funny."
msgstr "Пахнет специфически."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASS.DISEASED"
msgid "It's not long for this world..."
msgstr "Недолго для этого мира..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASS.DISEASING"
msgid "It is on the precipice..."
msgstr "Он находится на грани..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASS.GENERIC"
msgid "It's just a tuft of grass."
msgstr "Это просто пучок травы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASS.PICKED"
msgid "It has been killed."
msgstr "Убийство свершилось."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASS.WITHERED"
msgid "It just couldn't take the heat."
msgstr "Ей не дано было пережить иссушающую жару."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASSGATOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASSGATOR"
msgid "It fears what it does not know."
msgstr "Он боится неизвестного."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "It's suffering."
msgstr "Он страдает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "This is a creature ruled by fear."
msgstr "Этим существом управляет страх."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GRASS_UMBRELLA"
msgid "The sun beats down."
msgstr "Солнце побеждено."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GRAVEURN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GRAVEURN.GENERIC"
msgid "Empty. Sigh."
msgstr "Пусто. Эх."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GRAVEURN.HAS_SPIRIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GRAVEURN.HAS_SPIRIT"
msgid "Let's find you a new place to rest."
msgstr "Давай найдём тебе новое место для упокоения."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GRAVY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GRAVY"
msgid "How we try in vain to add flavor to our bland and meaningless lives."
msgstr "Как мы тщетно пытаемся привнести вкус в нашу пресную и бессмысленную жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GREENAMULET"
msgid "A flash of brilliance!"
msgstr "Он великолепен!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GREENGEM"
msgid "The flaws are its most beautiful features."
msgstr "Его недостатки одновременно являются его лучшими качествами."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GREENMOONEYE"
msgid "A green aura hangs over us..."
msgstr "Зелёная аура нависла над нами..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GREENSTAFF"
msgid "I can see the power sparkling deep within."
msgstr "Я вижу силу, сверкающую глубоко внутри."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GREEN_CAP"
msgid "This mushroom is disappointingly normal."
msgstr "Этот гриб удручающе нормальный."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GREEN_CAP_COOKED"
msgid "All is malleable."
msgstr "Всему приходит конец."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "Dank."
msgstr "Сырой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "I would hide too, if I could."
msgstr "Я бы тоже спряталась, если бы могла."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "Harvested."
msgstr "Он уже собран."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GROTTO_POOL_BIG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GROTTO_POOL_BIG"
msgid "A rare bit of beauty in this dark, dreary place."
msgstr "Маленькая капля красоты в этом тёмном, унылом месте."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GROTTO_POOL_SMALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GROTTO_POOL_SMALL"
msgid "A rare bit of beauty in this dark, dreary place."
msgstr "Маленькая капля красоты в этом тёмном, унылом месте."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GUACAMOLE"
msgid "That's just gruesome. I like it."
msgstr "Это просто отвратительно. Мне нравится."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GUANO"
msgid "The inevitable byproduct of life."
msgstr "Неизбежный побочный продукт жизни."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.GUNPOWDER"
msgid "It is a dark path we tread."
msgstr "Это тёмный путь, на который я вступаю."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_1"
msgid "Oh... it's... g-good."
msgstr "Ох... это... х-хорошо."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_10"
msgid "This is... fun..."
msgstr "Это... весело..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_11"
msgid "You have to bite their heads off first... heehee..."
msgstr "Сначала нужно откусить голову... хи-хи..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_12"
msgid "Today I eat them. One day, they'll eat me."
msgstr "Сегодня их ем я. Однажды они съедят меня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_13"
msgid "A candy as hard as my heart."
msgstr "Конфета тверда, как моё сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_14"
msgid "What is this eternal burning?!"
msgstr "Что за бесконечное жжение?!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_2"
msgid "The most delicious lie."
msgstr "Самая вкусная ложь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_3"
msgid "Sigh. At least it's honest."
msgstr "Ох. По крайней мере, это забавно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_4"
msgid "Don't worry, Webber, it's just candy."
msgstr "Не бойся, Веббер, это просто конфета."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_5"
msgid "Nine lives are not enough to save you from my hungry maw..."
msgstr "Девяти жизней не хватит, чтобы спасти вас от моего голодного брюха..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_6"
msgid "Lumps of bitter sorrow."
msgstr "Куски горькой печали."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_7"
msgid "Life is a swirling abyss of suffering and disappointment."
msgstr "Жизнь - циркулирующая пропасть страдания и разочарования."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_8"
msgid "This is... fun..."
msgstr "Это... весело..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENCANDY_9"
msgid "As perplexing as it is delicious."
msgstr "Немного озадачивает, но вкусно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "Things seem less horrifying with this."
msgstr "Вещи кажутся менее ужасающими."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "If only life was so potent."
msgstr "Вот бы жизнь была настолько сильной."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "Like life, it's a bit disappointing."
msgstr "Как и жизнь, оно немного разочаровывает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "I wish I possessed such burning within my heart."
msgstr "Хотелось бы, чтобы в моём сердце было такое жжение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENPOTION_MOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEENPOTION_MOON"
msgid "If only it could change the past."
msgstr "Если бы только оно могло изменить прошлое."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "It reminds me of Abigail. I'll hang it somewhere."
msgstr "Напоминает мне Абигейл. Повешу куда-нибудь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "It longs to be hung somewhere."
msgstr "Эта штука прямо просит, чтобы её куда-то повесили."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "Decoration for a devilish day."
msgstr "Украшение в честь дьявольского дня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "A memorial for a monster."
msgstr "Воспоминание о монстре."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "It descends into darkness."
msgstr "Он спускается во тьму."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "Crows in trees mean souls trapped between worlds."
msgstr "Вороны на деревьях — это души, застрявшие между мирами."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HAMBAT"
msgid "Death begets death."
msgstr "Смерть порождает смерть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HAMMER"
msgid "This hammer does not create... it only destroys..."
msgstr "О, с этим я смогу уничтожить этот мир."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HAMMER_MJOLNIR"
msgid "What a brutal implement."
msgstr "Какое жестокое орудие."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HANDPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HANDPILLOW_BEEFALOWOOL"
msgid "This one is just right. Except for the smell."
msgstr "Эта в самый раз. За исключением запаха."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HANDPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HANDPILLOW_KELP"
msgid "This one is too... kelpy."
msgstr "Эта слишком... жидкая."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HANDPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HANDPILLOW_PETALS"
msgid "This one is too soft."
msgstr "Этот слишком мягкая."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HANDPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HANDPILLOW_STEELWOOL"
msgid "This one is too hard."
msgstr "Это слишком жёсткая."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HAREBALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HAREBALL"
msgid "What a horrid thing!"
msgstr "Какая ужасная вещь!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HAWAIIANSHIRT"
msgid "They'll put flowers on anything these days."
msgstr "В последнее время цветы лепят на всё подряд."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HEALINGSALVE"
msgid "Life brings pain, pain brings life."
msgstr "Жизнь дарит боль, а боль дарит жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HEALINGSALVE_ACID
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HEALINGSALVE_ACID"
msgid "I find it strangely soothing."
msgstr "Я нахожу это странно успокаивающим."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HEALINGSTAFF"
msgid "I could restore my allies."
msgstr "Я могла бы воскресить моих союзников."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HEATROCK.COLD"
msgid "Just a moderately cold lump of rock."
msgstr "Просто прохладный камень."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HEATROCK.FROZEN"
msgid "Frozen like my heart."
msgstr "Холоден, как моё сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HEATROCK.GENERIC"
msgid "There it sits, just taking up space."
msgstr "Так он лежит и просто занимает место."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HEATROCK.HOT"
msgid "Those that burn brightest, burn fastest."
msgstr "Чем ярче горит, тем быстрее выгорит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HEATROCK.WARM"
msgid "As lukewarm and lifeless as every other rock."
msgstr "Тёплый и безжизненный, как и любой другой камень."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HEDGEHOUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HEDGEHOUND"
msgid "Its beauty hid the beast within."
msgstr "Его красота скрывала зверя внутри."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HEDGEHOUND_BUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HEDGEHOUND_BUSH"
msgid "They're... beautiful."
msgstr "Они... прекрасны."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB"
msgid "It's a tragic fate, to be left behind by those you love."
msgstr "Как это трагично — быть покинутым тем, кого любишь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRABTEA_FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRABTEA_FIRENETTLES"
msgid "It warms all but my soul."
msgstr "Он греет моё тело, но не душу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRABTEA_FOLIAGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRABTEA_FOLIAGE"
msgid "My mind is not what needs protecting."
msgstr "Моему разуму не нужна защита."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRABTEA_FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRABTEA_FORGETMELOTS"
msgid "To keep the demons at bay."
msgstr "Чтобы держать демонов в узде."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRABTEA_MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRABTEA_MOON_TREE_BLOSSOM"
msgid "They will merely tolerate my presence."
msgstr "Они просто будут терпеть моё присутствие."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRABTEA_PETALS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRABTEA_PETALS"
msgid "It quiets the mind."
msgstr "Он успокаивает разум."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRABTEA_PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRABTEA_PETALS_EVIL"
msgid "This takes me to a dark place."
msgstr "С ним я будто приближаюсь к тёмной стороне."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRABTEA_SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRABTEA_SUCCULENT_PICKED"
msgid "For when I miss the cold."
msgstr "На случай, если я буду скучать по холоду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRABTEA_TILLWEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRABTEA_TILLWEED"
msgid "This tea will make me live longer. Sigh."
msgstr "Этот чай продлит мою жизнь. Эх."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_LIGHTPOST.ABANDONED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_LIGHTPOST.ABANDONED"
msgid "The light could not last."
msgstr "Свет не мог гореть вечно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_LIGHTPOST.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_LIGHTPOST.GENERIC"
msgid "A bit of light in the darkness."
msgstr "Лучик света во тьме."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_LIGHTPOST_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_LIGHTPOST_ITEM"
msgid "Where should you go?"
msgstr "Куда бы тебя поставить?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_RELOCATION_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_RELOCATION_KIT"
msgid "She deserves to live in a nicer place."
msgstr "Она заслужила жить в лучшем месте."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_SHELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_SHELL"
msgid "If only it would take me to Abigail."
msgstr "Если бы она могла перенести меня к Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_TEASHOP.ACTIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_TEASHOP.ACTIVE"
msgid "It's been a while since my last tea party."
msgstr "Давненько я не устраивала чаепития."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_TEASHOP.BREWING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_TEASHOP.BREWING"
msgid "One of my few joys in this life."
msgstr "Одна из немногих радостей в моей жизни."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_TEASHOP.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_TEASHOP.BURNT"
msgid "It makes me extra sad."
msgstr "От этого мне становится ещё грустнее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_TEASHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITCRAB_TEASHOP.GENERIC"
msgid "She's not in."
msgstr "Её нет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITHOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITHOTSPRING.BOMBED"
msgid "Perhaps it will soothe my soul, if only for a moment."
msgstr "Возможно, он успокоит мою душу, хотя бы на мгновение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITHOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITHOTSPRING.EMPTY"
msgid "Nothing left for me here..."
msgstr "Для меня тут ничего не осталось."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITHOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITHOTSPRING.GENERIC"
msgid "When I gaze upon my reflection, a ghost stares back at me."
msgstr "Когда я смотрю на своё отражение, призрак смотрит на меня в ответ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITHOTSPRING_CONSTR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITHOTSPRING_CONSTR"
msgid "I don't mind waiting."
msgstr "Я не против подождать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITHOUSE.BUILTUP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITHOUSE.BUILTUP"
msgid "It's hardly worth saving."
msgstr "Вряд ли его стоит спасать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITHOUSE.GENERIC"
msgid "Perhaps broken things can be fixed... over time..."
msgstr "Возможно, сломанное можно починить... со временем..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITHOUSE_LAUNDRY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITHOUSE_LAUNDRY"
msgid "Chores keep the mind occupied."
msgstr "Домашние дела помогают занять мысли."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITHOUSE_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMITHOUSE_ORNAMENT"
msgid "It's pleasant."
msgstr "Это приятно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMIT_BUNDLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMIT_BUNDLE"
msgid "For once I'm rewarded for my efforts."
msgstr "Хоть в этот раз я вознаграждена за свои усилия."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMIT_BUNDLE_SHELLS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMIT_BUNDLE_SHELLS"
msgid "Abigail likes the shells."
msgstr "Абигейл нравились ракушки."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMIT_CRACKED_PEARL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMIT_CRACKED_PEARL"
msgid "I seem to leave only misery in my wake..."
msgstr "Похоже, я оставляю за собой только скорбь..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMIT_PEARL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HERMIT_PEARL"
msgid "I will be its caretaker."
msgstr "Я о ней позабочусь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HIVEHAT"
msgid "What dark machinations were once concocted beneath?"
msgstr "Что за тёмные махинации создали это?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOME"
msgid "A pathetic simulacrum..."
msgstr "Жалкий вид..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOMESIGN.BURNT"
msgid "Transient, indeed."
msgstr "Ненадолго, увы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOMESIGN.GENERIC"
msgid "A mark is made, however transient."
msgstr "Мой след оставлен, впрочем ненадолго."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "Its blank face shall soon offer a secret."
msgstr "Пустое место так и тянет начертать секреты."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HONEY"
msgid "A sweet, but fleeting treat."
msgstr "Сладостное, но мимолётное наслаждение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HONEYCOMB"
msgid "Pieces of beehive, scattered."
msgstr "Кусочки улья. Разрозненные."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HONEYHAM"
msgid "A sweet sauce for this creature's sweet embrace."
msgstr "Сладкие объятия для столь лакомого кусочка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HONEYNUGGETS"
msgid "Meat cut into tiny pieces. Just like my heart."
msgstr "Мясо нарезали на мелкие кусочки. Прямо как моё сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HORN"
msgid "It sounds like there's a beefalo trapped inside."
msgstr "Звучит так, как будто там внутри бифало сидит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HORRORFUEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HORRORFUEL"
msgid "There are always more horrors to come."
msgstr "Впереди нас ожидает ещё много ужасов."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HORSESHOE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HORSESHOE"
msgid "Will it make a difference for me?"
msgstr "И что же для меня изменится?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOTCHILI"
msgid "Abigail hated spicy foods."
msgstr "Абигейл ненавидела острую еду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOTSPRING.BOMBED"
msgid "I don't see how this helped."
msgstr "Не понимаю, как это помогло."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOTSPRING.EMPTY"
msgid "Nothing left for me here..."
msgstr "Для меня тут ничего не осталось."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOTSPRING.GENERIC"
msgid "When I gaze upon my reflection, a ghost stares back at me."
msgstr "Когда я смотрю на своё отражение, призрак смотрит на меня в ответ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOTSPRING.GLASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOTSPRING.GLASS"
msgid "The top is solid glass."
msgstr "Верхняя часть - сплошное стекло."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUND"
msgid "Stay back, foul minion of evil!"
msgstr "Прочь, мерзкий приспешник зла!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUNDBONE"
msgid "The remains of an evil beast."
msgstr "Останки отвратительного чудища."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUNDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUNDCORPSE.BURNING"
msgid "Fare thee well."
msgstr "Прощай же."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUNDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUNDCORPSE.GENERIC"
msgid "It's dead."
msgstr "Она мертва."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUNDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUNDCORPSE.REVIVING"
msgid "You should have stayed dead."
msgstr "Тебе стоило оставаться мёртвой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUNDMOUND"
msgid "Home to the foulest creatures."
msgstr "Обитель грязных существ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUNDSTOOTH"
msgid "Pulled out by the root."
msgstr "Вырван с корнем."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUNDSTOOTH_BLOWPIPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUNDSTOOTH_BLOWPIPE"
msgid "Delivering sweet death from a distance."
msgstr "Доставка сладкой смерти на расстоянии."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HOUNDWHISTLE"
msgid "That I cannot hear it does not mean it is silent."
msgstr "Если я не могу услышать звуки, что он издаёт, не означает, что их нет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HUTCH"
msgid "He is blissfully ignorant."
msgstr "Он в блаженном неведении."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "It's not floating, yet."
msgstr "Пока ещё не брюхом к верху."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "It's reached its natural state."
msgstr "Теперь она оказалась в своём естественном состоянии."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ICE"
msgid "Broken pieces of my heart."
msgstr "Осколки моего разбитого сердца."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ICEBERG.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ICEBERG.GENERIC"
msgid "Oh that my ship would dash across it."
msgstr "Ох если бы мой корабль бросился в его сторону."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ICEBERG.MELTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ICEBERG.MELTED"
msgid "It melted down a bit."
msgstr "Он слегка растаял."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ICEBERG_MELTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ICEBERG_MELTED"
msgid "It melted down a bit."
msgstr "Он слегка растаял."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ICEBOX"
msgid "It is as cold as my heart."
msgstr "Столь же холодный, как моё сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ICECREAM"
msgid "Ice cream could never replace Abigail."
msgstr "Мороженое никогда не сможет заменить Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ICEHAT"
msgid "Keep a cool head."
msgstr "Держит голову в холоде."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ICEHOUND"
msgid "He has a cold, dead heart."
msgstr "У неё холодное, мёртвое сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ICEPACK"
msgid "Nothing can insulate us from the horrors of this world."
msgstr "Ничто не может оградить нас от ужасов этого мира."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ICESTAFF"
msgid "A staff to freeze."
msgstr "Посох замерзания."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ICESTAFF2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ICESTAFF2"
msgid "Cold and misery."
msgstr "Холод и страдание."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ICESTAFF3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ICESTAFF3"
msgid "My heart is already cold as ice."
msgstr "Моё сердце и так холодно, как лёд."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ICE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ICE_BLUEPRINT"
msgid "It reflects the coldness I feel inside."
msgstr "Он отражает холод, который я чувствую внутри."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "It's calling my name."
msgstr "Он зовёт меня по имени."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "It's cold and black."
msgstr "Он холодный и чёрный."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.INSPECTACLESBOX
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.INSPECTACLESBOX"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.INSPECTACLESBOX2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.INSPECTACLESBOX2"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.INSPECTACLESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.INSPECTACLESHAT.GENERIC"
msgid "They can't show me what I'm looking for."
msgstr "Они не могут показать мне то, что я ищу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.INSPECTACLESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.INSPECTACLESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.INSPECTSELF"
msgid "When I look in the mirror, it's like Abigail's here."
msgstr "Я похожа на Абигейл, когда смотрю в зеркало."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.IPECACSYRUP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.IPECACSYRUP"
msgid "I'd like a poison that is less stinky, please."
msgstr "Можно мне менее вонючий яд, пожалуйста."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.IVY_SNARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.IVY_SNARE"
msgid "I suppose I must deserve this."
msgstr "Видимо, я это заслужила."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.JAMMYPRESERVES"
msgid "The perfect amount of jam."
msgstr "Идеальное количество джема."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.JELLYBEAN"
msgid "Beans that shall never know life."
msgstr "Бобы, которые никогда не знали жизни."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.JUNK_PILE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.JUNK_PILE"
msgid "Could there be something worthwhile hiding deep inside?"
msgstr "Может ли быть что-то стоящее, спрятанное глубоко внутри?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.JUNK_PILE_BIG.BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.JUNK_PILE_BIG.BLUEPRINT"
msgid "Do you see what's up there, Abigail?"
msgstr "Видишь, что там лежит, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.JUNK_PILE_BIG.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.JUNK_PILE_BIG.GENERIC"
msgid "It's about to collapse... maybe I'll be here when it does."
msgstr "Вот-вот рухнет... А я постою рядом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.JUSTEGGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.JUSTEGGS"
msgid "Plain is fine. Why hope for anything more?"
msgstr "Простота - это прекрасно. Зачем надеяться на что-то большее?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KABOBS"
msgid "Meat, skewered right through the center."
msgstr "Мясо, проткнутое прямо через центр."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KELP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KELP"
msgid "It's... I don't know. Sigh."
msgstr "Она... Я не знаю. Эх."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KELPHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KELPHAT"
msgid "The strands are so slippery, it's barely holding together."
msgstr "Пряди такие скользкие, что едва держатся вместе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KELP_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KELP_COOKED"
msgid "The things we do for sustenance."
msgstr "Что мы готовы сделать ради пропитания."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KELP_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KELP_DRIED"
msgid "We took it out of the ocean, then took the ocean out of it."
msgstr "Сначала мы забрали её из океана, а потом забрали океан из неё."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KILLERBEE.GENERIC"
msgid "A bee without conscience."
msgstr "Бессовестная пчела."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KILLERBEE.HELD"
msgid "Be still, little one."
msgstr "Успокойся, малышка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDECOR1.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDECOR1.BURNT"
msgid "No more enjoyment to be had."
msgstr "Больше никаких игр."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDECOR1.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDECOR1.GENERIC"
msgid "This is not real poultry."
msgstr "Это не настоящая домашняя птица."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDECOR1_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDECOR1_KIT"
msgid "It will only build a temporary distraction."
msgstr "Это лишь временно отвлечет вас."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDECOR2.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDECOR2.BURNT"
msgid "Happiness is ephemeral."
msgstr "Счастье эфемерно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDECOR2.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDECOR2.GENERIC"
msgid "It tricks them with the promise of sustenance."
msgstr "Обманывает их обещанием пропитания."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDECOR2_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDECOR2_KIT"
msgid "It will only build a temporary distraction."
msgstr "Это лишь временно отвлечет вас."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDEN.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDEN.BURNT"
msgid "Everything ends."
msgstr "Все закончится."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDEN.GENERIC"
msgid "Where the wild beasts go."
msgstr "Куда уходят звери."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK"
msgid "They've left me behind..."
msgstr "Они ушли от меня..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP"
msgid "The sands of time are unforgiving."
msgstr "Пески времени неумолимы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDEN_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOONDEN_KIT"
msgid "Oh, to be young and free of life's worries."
msgstr "О, быть молодым и свободным от жизненных забот."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_DECIDUOUS"
msgid "Small and innocent. Like I once was..."
msgstr "Маленький и невинный. Как я когда-то была..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_DESERT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_DESERT"
msgid "Small and innocent. Like I once was..."
msgstr "Маленький и невинный. Как я когда-то была..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_FOREST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_FOREST"
msgid "Small and innocent. Like I once was..."
msgstr "Маленький и невинный. Как я когда-то была..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_GRASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_GRASS"
msgid "Small and innocent. Like I once was..."
msgstr "Маленький и невинный. Как я когда-то была..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_MARSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_MARSH"
msgid "Small and innocent. Like I once was..."
msgstr "Маленький и невинный. Как я когда-то была..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_MOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_MOON"
msgid "Small and innocent. Like I once was..."
msgstr "Маленький и невинный. Как я когда-то была..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_NAMETAG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_NAMETAG"
msgid "It's too painful to grow attached to things."
msgstr "Слишком больно привязываться к вещам."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_ROCKY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_ROCKY"
msgid "Small and innocent. Like I once was..."
msgstr "Маленький и невинный. Как я когда-то была..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_SAVANNA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_SAVANNA"
msgid "Small and innocent. Like I once was..."
msgstr "Маленький и невинный. Как я когда-то была..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_YOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KITCOON_YOT"
msgid "Small and innocent. Like I once was..."
msgstr "Маленький и невинный. Как я когда-то была..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KLAUS"
msgid "I see him when I'm sleeping..."
msgstr "Я вижу его, когда я сплю..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KLAUSSACKKEY"
msgid "The key to our prosperity..."
msgstr "Ключ к нашему процветанию..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KLAUS_SACK"
msgid "Should we peek inside...?"
msgstr "Стоит ли нам заглянуть внутрь...?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KNIGHT"
msgid "A cold, soulless horse."
msgstr "Холодная, бездушная лошадь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "Another battle lost to time."
msgstr "Ещё одна битва проиграна времени."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KNIGHT_YOTH.FOLLOWING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KNIGHT_YOTH.FOLLOWING"
msgid "How loyal you are."
msgstr "Что за преданность."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KNIGHT_YOTH.FOLLOWING_OTHER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KNIGHT_YOTH.FOLLOWING_OTHER"
msgid "Whom do you serve, dear knight?"
msgstr "Кому вы присягнули на верность, благородный рыцарь?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KNIGHT_YOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KNIGHT_YOTH.GENERIC"
msgid "Brutes, all of you!"
msgstr "Скот, ты и собратья твои!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KOALEFANT_CARCASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KOALEFANT_CARCASS"
msgid "Somehow, it comforts me."
msgstr "Каким-то образом это меня утешает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KOALEFANT_SUMMER"
msgid "A beast of solitude."
msgstr "Одинокий зверь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KOALEFANT_WINTER"
msgid "It stands against the cruel elements."
msgstr "Он борется с жестокими стихиями."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KOALEFIG_TRUNK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KOALEFIG_TRUNK"
msgid "How terrible."
msgstr "Как ужасно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KRAMPUS"
msgid "Hello, foul creature of the underworld."
msgstr "Привет, подлая подземная тварь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.KRAMPUS_SACK"
msgid "It smells of goat."
msgstr "Воняет козлом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LANTERN"
msgid "Light the way, darkly."
msgstr "Освещает мрачные пути."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LATKES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LATKES"
msgid "They are... quite tasty."
msgstr "Они... довольно вкусны."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "This world is nothing but hurt."
msgstr "Этот мир - не что иное, как боль."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "Heavy protection for one's heart."
msgstr "Тяжёлая защита для сердца."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "If only my heart were as light."
msgstr "Если бы только моё сердце было таким же лёгким."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "They'll have to catch me to hurt me."
msgstr "Им придётся поймать меня, чтобы навредить."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "Protect my fragile frame."
msgstr "Защитит моё хрупкое тело."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "Even our armor is fanged."
msgstr "Даже наша броня с клыками."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "It will restore one's power."
msgstr "Она восстановит мою силу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "It protects from damage, but not from sorrow."
msgstr "Она защищает от повреждений, но не от печали."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "That Battle Standard needs to be destroyed..."
msgstr "Этот боевой штандарт нужно уничтожить..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_BERNIE"
msgid "How do you do, Bernie?"
msgstr "Как поживаешь, Берни?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_BOARLORD"
msgid "A ruthless man."
msgstr "Безжалостный человек."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "I forsee a wave of death."
msgstr "Я предвижу волну смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "When will you be free from this torment?"
msgstr "Когда ты освободишься от этих мучений?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "There is dastardly power within."
msgstr "Внутри есть подлая сила."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "But what of the birds?"
msgstr "Оно что, из птиц?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "A bombardment of pain."
msgstr "Обстрел боли."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "It eases pain of the body, but not of the heart."
msgstr "Это облегчает боль тела, но не сердца."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "But will it heal my soul?"
msgstr "Но исцелит ли она мою душу?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "It's too heavy. Like my soul."
msgstr "Оно слишком тяжело. Как моя душа."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "Empty as my heart."
msgstr "Пустота, как в моём сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "Full as my sorrows."
msgstr "Полный, как моя душа печали."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "It brings more pain into the world."
msgstr "Это приносит больше боли в мир."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_LUCY"
msgid "Hello again, Lucy."
msgstr "И вновь здравствуй, Люси."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "I dared not hope it would take me home."
msgstr "Я не смела надеяться, что это приведёт меня домой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "I bid you good day."
msgstr "Я предлагаю вам хороший день."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "I'll be able to attack so often..."
msgstr "Я смогу так часто атаковать..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_SPAWNER"
msgid "That's where they come from..."
msgstr "Вот откуда они взялись..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "Hit harder, stronger..."
msgstr "Бей жёстче, сильнее..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "The wearer shall be a force of good."
msgstr "Носитель должен быть добрым."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE"
msgid "It burns with the fires of Hell."
msgstr "Она пылает языками пламени из Ада."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_COCOON"
msgid "Cold-blooded."
msgstr "Хладнокровная."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "Is it worth it to put stake in your future?"
msgstr "Стоит ли оставлять кого-то после себя?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "This egg is almost as cold as my heart."
msgstr "Это яйцо почти так же холодно, как моё сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "The egg is warm, but my heart is still cold."
msgstr "Яйцу тепло, но в сердце у меня по-прежнему лишь холод."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_PET.CONTENT"
msgid "Enjoy your happiness while it lasts, little lavae."
msgstr "Наслаждайся своей беззаботностью, пока это возможно, маленькая лавовая личинка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_PET.GENERIC"
msgid "A spark of life illuminating the darkness."
msgstr "Искорка света, освещающая тьму."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "He is suffering the pangs of hunger."
msgstr "Она страдает от приступов голода."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_PET.STARVING"
msgid "He is approaching death."
msgstr "Она приближается к смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAE_TOOTH"
msgid "Forsooth, it's a tooth."
msgstr "Нет сомнений, это зуб."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVASPIT.COOL"
msgid "It's cooled off and smells funny."
msgstr "Она остыла и странновато пахнет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVASPIT.HOT"
msgid "It spit up."
msgstr "Её выплюнули."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVA_POND"
msgid "I could jump in and be done."
msgstr "Я могу покончить со всем здесь и сейчас."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVA_POND_ROCK"
msgid "It's... a rock... Sigh."
msgstr "Это... камень... Ох."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LEAFLOAF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LEAFLOAF"
msgid "It's nothing like any meatloaf I've tried."
msgstr "Такой мясной рулет я никогда не пробовала."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LEAFYMEATBURGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LEAFYMEATBURGER"
msgid "It's drab and flavorless..."
msgstr "Тусклый и безвкусный..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LEAFYMEATSOUFFLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LEAFYMEATSOUFFLE"
msgid "Oh. I thought it was dessert..."
msgstr "О. Я думала, это десерт..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LEIF"
msgid "A lumbering beast."
msgstr "Неуклюжее чудовище."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LEIF_IDOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LEIF_IDOL"
msgid "Let's play \"funeral pyre.\""
msgstr "Давайте сыграем в \"Погребальный костёр\"."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LEIF_SPARSE"
msgid "A lumbering beast."
msgstr "Неуклюжее чудовище."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LICHEN"
msgid "How does it manage to grow like that?"
msgstr "Как это ему удалось вырасти здесь?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LIFEINJECTOR"
msgid "We were not meant to cheat death."
msgstr "Нам не дано обмануть смерть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTBULB"
msgid "It's slowly burning out."
msgstr "Она медленно угасает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTCRAB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTCRAB"
msgid "Their shells look like glass... I wonder if they shatter like glass too."
msgstr "Их ракушки похожи на стекло... интересно, настольки же ли они хрупкие."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTER"
msgid "Death in a box..."
msgstr "Смерть в маленькой коробочке..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTFLIER"
msgid "A small spot of light in the darkness... waiting to be snuffed out."
msgstr "Маленькое пятнышко света в темноте... ожидающее, когда его погасят."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "Chaaaarge!"
msgstr "Разря-я-я-я-яд!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "Look at those hooves."
msgstr "Только посмотрите на эти копытца!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTNINGGOATHORN"
msgid "A weird curling horn."
msgstr "Странный скрученный рог."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "Even this power will run out."
msgstr "Даже эта мощь сойдёт на нет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "Focuses the destruction."
msgstr "Концентрирует разрушительную силу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LITTLE_WALRUS"
msgid "The cycle of violence continues."
msgstr "Цикл насилия продолжается."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LIVINGLOG"
msgid "It is forever screaming silently."
msgstr "Оно будет вечно безмолвно кричать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LIVINGTREE"
msgid "Can it never die?"
msgstr "Оно никогда не умрёт?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LIVINGTREE_ROOT"
msgid "Potential horror."
msgstr "Потенциальный ужас."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LIVINGTREE_SAPLING"
msgid "It'll grow up big and abhorrent."
msgstr "Оно станет большим и отвратительным."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LOBSTERBISQUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LOBSTERBISQUE"
msgid "I would like a spoon."
msgstr "Мне бы ложку."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LOBSTERDINNER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LOBSTERDINNER"
msgid "Its death will give me life."
msgstr "Его смерть подарит мне жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LOG.BURNING"
msgid "Just a burning log."
msgstr "Просто горящее бревно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LOG.GENERIC"
msgid "If trees could talk, they would scream at the sight of this."
msgstr "Если бы деревья могли говорить, то они кричали бы при виде этого."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LORDFRUITFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LORDFRUITFLY"
msgid "I would curtsy, but I've decided that I don't like you at all."
msgstr "Я бы сделала реверанс, но решила, что ты мне совсем не нравишься."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_1"
msgid "I get the feeling... that this meant a great deal to someone."
msgstr "Такое ощущение... что для кого-то оно имело большое значение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_10
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_10"
msgid "I get the feeling... that this meant a great deal to someone."
msgstr "Такое ощущение... что для кого-то оно имело большое значение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_11
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_11"
msgid "I get the feeling... that this meant a great deal to someone."
msgstr "Такое ощущение... что для кого-то оно имело большое значение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_14
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_14"
msgid "I get the feeling... that this meant a great deal to someone."
msgstr "Такое ощущение... что для кого-то оно имело большое значение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_18
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_18"
msgid "I get the feeling... that this meant a great deal to someone."
msgstr "Такое ощущение... что для кого-то оно имело большое значение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_19
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_19"
msgid "I get the feeling... that this meant a great deal to someone."
msgstr "Такое ощущение... что для кого-то оно имело большое значение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_2"
msgid "I get the feeling... that this meant a great deal to someone."
msgstr "Такое ощущение... что для кого-то оно имело большое значение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_42
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_42"
msgid "I get the feeling... that this meant a great deal to someone."
msgstr "Такое ощущение... что для кого-то оно имело большое значение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_43
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_43"
msgid "I get the feeling... that this meant a great deal to someone."
msgstr "Такое ощущение... что для кого-то оно имело большое значение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_7
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_7"
msgid "I get the feeling... that this meant a great deal to someone."
msgstr "Такое ощущение... что для кого-то оно имело большое значение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "Luck has long since abandoned me..."
msgstr "Удача уже давно меня бросила..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUCY"
msgid "Hello... \"Lucy\"... I'd like you to meet my sister."
msgstr "Привет... \"Люси\"... Я хочу познакомить тебя с моей сестрой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUMPY_SAPLING"
msgid "This life appeared from nowhere."
msgstr "Это жизнь, появившаяся из ниоткуда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARFROG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARFROG"
msgid "What horrors have you seen, little frog?"
msgstr "Какие ужасы ты наблюдала, маленькая жаба?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARPLANTHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARPLANTHAT"
msgid "It lets me hide my face from the world."
msgstr "Позволяет мне прятать своё лицо от этого мира."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARPLANT_HUSK"
msgid "It can't hurt anyone anymore."
msgstr "Оно больше не может навредить мне."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARPLANT_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARPLANT_KIT"
msgid "You can't always fix what's broken. But sometimes you can."
msgstr "Не всегда можно починить то, что сломано. Но иногда можно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARRIFT_CRYSTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARRIFT_CRYSTAL"
msgid "Beautiful and fragile."
msgstr "Прекрасное и хрупкое."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARRIFT_PORTAL"
msgid "A gaping wound in the sky."
msgstr "Зияющая рана в небе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARTHRALL_PLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARTHRALL_PLANT"
msgid "Others must suffer for it to survive."
msgstr "Другие должны страдать, чтобы оно могло жить."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARTHRALL_PLANT_VINE_END
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARTHRALL_PLANT_VINE_END"
msgid "It's lashing out."
msgstr "Оно набрасывается на меня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNAR_FORGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNAR_FORGE"
msgid "Will I be able to create anything of use?"
msgstr "Смогу ли я создать что-нибудь полезное?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNAR_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNAR_FORGE_KIT"
msgid "I should try to put these scattered pieces together..."
msgstr "Мне нужно попытаться собрать эти разрозненные кусочки вместе..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNAR_GRAZER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNAR_GRAZER"
msgid "Will you grant me the eternal slumber I seek?"
msgstr "Подаришь ли ты мне вечный сон, который я ищу?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNAR_SEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNAR_SEED"
msgid "All that remains is its crown."
msgstr "Корона - всё, что от него осталось."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUREPLANT"
msgid "It consumes all."
msgstr "Он пожирает всё."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUREPLANTBULB"
msgid "Life goes on."
msgstr "Жизнь продолжается."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUTEFISK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUTEFISK"
msgid "Maybe I'll try just a bite."
msgstr "Возможно, попробую немного."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MADSCIENCE_LAB"
msgid "Madness lies within."
msgstr "Внутри лежит безумие."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAGICIAN_CHEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAGICIAN_CHEST"
msgid "You can't use a magic box for hide-and-seek, that's cheating."
msgstr "Нельзя использовать волшебный сундук для игры в прятки, это нечестно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MALBATROSS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MALBATROSS"
msgid "What a horrid bird!"
msgstr "Какая ужасная птица!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MALBATROSS_BEAK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MALBATROSS_BEAK"
msgid "How gruesome."
msgstr "Как мерзко."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MALBATROSS_FEATHER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MALBATROSS_FEATHER"
msgid "It won't be needing these anymore."
msgstr "Ему они больше не понадобятся."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MALBATROSS_FEATHERED_WEAVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MALBATROSS_FEATHERED_WEAVE"
msgid "My fingers ache from sewing in all those feathers."
msgstr "Мои пальцы болят от зашивания всех этих перьев."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MALE_PUPPET"
msgid "I wonder what he did."
msgstr "Гадаю, что он натворил."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKE"
msgid "Alas, poor mandrake!"
msgstr "Увы, бедный мандрагорик!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKESOUP"
msgid "Boiled the life out of him."
msgstr "Выпарила из неё всю жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKE_ACTIVE"
msgid "Onward, vegetable minion!"
msgstr "Вперёд, мой овощной приспешник!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKE_COOKED"
msgid "Now it's just food."
msgstr "Теперь это просто еда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKE_PLANTED"
msgid "The mighty mandrake. It's best picked at night."
msgstr "Могучая мандрагора. Нужно взять её ночью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MANRABBIT_TAIL"
msgid "It contains his fuzzy wuzzy essence."
msgstr "Здесь сокрыта его истинная пушистая сущность."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAPSCROLL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAPSCROLL"
msgid "Blank as Abigail now."
msgstr "Пуста как Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLE"
msgid "Smooth and lifeless."
msgstr "Гладкий и безжизненный."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLEBEAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLEBEAN"
msgid "Cold... but not lifeless..."
msgstr "Холод... но не безжизненный..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLEBEAN_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLEBEAN_SAPLING"
msgid "It cares nothing for the laws of this world..."
msgstr "Ему безразличны законы этого мира..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLEPILLAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLEPILLAR"
msgid "Even stone can not withstand the constant pull of decay."
msgstr "Даже камень не в силах противостоять постоянному давлению времени."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLESHRUB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLESHRUB"
msgid "Against all odds, it has flourished in life..."
msgstr "Несмотря ни на что, он расцвёл..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLETREE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLETREE"
msgid "Be ye alive or be ye dead?"
msgstr "Живое ты или мёртвое?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_BUSH.BURNING"
msgid "Even thorns burn."
msgstr "Даже шипы горят."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_BUSH.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_BUSH.BURNT"
msgid "The end."
msgstr "Конец."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "A bush that always hurts."
msgstr "Кустарник, который причиняет боль."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_BUSH.PICKED"
msgid "Life is pain. Now it has no life."
msgstr "Жизнь - боль. Теперь у него нет жизни."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_PLANT"
msgid "It's a plant."
msgstr "Это растение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_TREE.BURNING"
msgid "It's burning."
msgstr "Оно горит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_TREE.BURNT"
msgid "Black like my heart."
msgstr "Черно, как моё сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "Its spikes were no protection."
msgstr "Шипы его не защитили."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_TREE.GENERIC"
msgid "A tree that knows only pain."
msgstr "Дерево, которое знает только боль."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASHEDPOTATOES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASHEDPOTATOES"
msgid "My stomach rumbles just looking at it..."
msgstr "Мой желудок урчит от одного взгляда на него..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_ANCIENT_ARCHITECTHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_ANCIENT_ARCHITECTHAT"
msgid "Did the wearer know what would become of their people?"
msgstr "Знал ли её носитель, что станет с его народом?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_ANCIENT_HANDMAIDHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_ANCIENT_HANDMAIDHAT"
msgid "She bears the look of one fated to be reckoned with."
msgstr "У неё вид того, кому суждено править."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_ANCIENT_MASONHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_ANCIENT_MASONHAT"
msgid "There is a quiet strength about this one."
msgstr "В ней сокрыта большая сила."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_BLACKSMITHHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_BLACKSMITHHAT"
msgid "To become someone else, even for a moment..."
msgstr "Стать кем-то другим, хотя бы на мгновение..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_DOLLBROKENHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_DOLLBROKENHAT"
msgid "To become someone else, even for a moment..."
msgstr "Стать кем-то другим, хотя бы на мгновение..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_DOLLHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_DOLLHAT"
msgid "To become someone else, even for a moment..."
msgstr "Стать кем-то другим, хотя бы на мгновение..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_DOLLREPAIREDHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_DOLLREPAIREDHAT"
msgid "To become someone else, even for a moment..."
msgstr "Стать кем-то другим, хотя бы на мгновение..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_FOOLHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_FOOLHAT"
msgid "To become someone else, even for a moment..."
msgstr "Стать кем-то другим, хотя бы на мгновение..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_HALFWITHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_HALFWITHAT"
msgid "I already mask my emotions."
msgstr "Я и так скрываю свои эмоции за маской."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_KINGHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_KINGHAT"
msgid "To become someone else, even for a moment..."
msgstr "Стать кем-то другим, хотя бы на мгновение..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_MIRRORHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_MIRRORHAT"
msgid "To become someone else, even for a moment..."
msgstr "Стать кем-то другим, хотя бы на мгновение..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_PRINCESSHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_PRINCESSHAT"
msgid "There's a lonliness in her expression."
msgstr "На её лице читается одиночество."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_QUEENHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_QUEENHAT"
msgid "To become someone else, even for a moment..."
msgstr "Стать кем-то другим, хотя бы на мгновение..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_SAGEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_SAGEHAT"
msgid "I already mask my emotions."
msgstr "Я и так скрываю свои эмоции за маской."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_TOADYHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_TOADYHAT"
msgid "I already mask my emotions."
msgstr "Я и так скрываю свои эмоции за маской."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_TREEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_TREEHAT"
msgid "To become someone else, even for a moment..."
msgstr "Стать кем-то другим, хотя бы на мгновение..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST"
msgid "If we sailed forever we would never reach the horizon."
msgstr "Если мы будем плыть вечно, то никогда не достигнем горизонта."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_ITEM"
msgid "A meager light to combat the darkness."
msgstr "Скудный свет для борьбы с темнотой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD"
msgid "A meager light to combat the darkness."
msgstr "Тоненький свет для борьбы с тьмой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_YOTD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_YOTD"
msgid "How long before that fire in your eyes goes out?"
msgstr "Сколько времени пройдёт, когда огонь в твоих глазах погаснет?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM"
msgid "Alas, being struck down by lightning is one less thing I can look forward too."
msgstr "Увы, быть убитой молнией - это ещё одна смерть, на которую я могу теперь не рассчитывать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_ITEM"
msgid "It's for making a mast."
msgstr "Для создания мачты."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_MALBATROSS"
msgid "Fly me away from this place."
msgstr "Унеси меня от этого места."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_MALBATROSS_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_MALBATROSS_ITEM"
msgid "That's alright, I can manage it."
msgstr "Всё в порядке, я справлюсь сама."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_YOTD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_YOTD"
msgid "Maybe I could sail far away..."
msgstr "Может, я могла бы уплыть далеко-далеко..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_YOTD_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_YOTD_ITEM"
msgid "It's for making a mast."
msgstr "Чтобы сделать мачту."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELL"
msgid "I feel a strange kinship with him."
msgstr "Я чувствую странное родство с ним."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLHEAD"
msgid "He sure has a taste for the dramatic."
msgstr "Ему уж точно не отказать в драматизме."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLLIGHT"
msgid "What a curious light."
msgstr "Какое странное свечение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLLOCK"
msgid "Looks magical."
msgstr "Выглядит магично."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "Shall we have a danse macabre?"
msgstr "Будет ли у нас смертельный танец?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLTHRONE"
msgid "Not quite what I expected."
msgstr "Не совсем то, чего я ожидала."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEAT"
msgid "It is still bloody."
msgstr "Оно всё ещё кровит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATBALLS"
msgid "Balled meat. How exciting."
msgstr "Мясо, скатанное в шарики. Как занимательно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.BURNT"
msgid "It's done drying. Forever."
msgstr "С сушкой покончено. Навсегда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DONE"
msgid "The drying is over."
msgstr "Сушка завершилась."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "The drying is over."
msgstr "Сушка завершилась."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYING"
msgid "It sways in the drying wind."
msgstr "Оно качается на иссушающем ветру."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "The rain is keeping it from drying."
msgstr "Дождь не даёт мясу высохнуть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "The rain is keeping it from drying."
msgstr "Дождь не даёт мясу высохнуть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
msgid "It sways in the drying wind."
msgstr "Оно качается на иссушающем ветру."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.GENERIC"
msgid "I can hang meat here."
msgstr "Я могу вешать сюда мясо."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.BURNT"
msgid "It's done drying. Forever."
msgstr "С сушкой покончено. Навсегда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DONE"
msgid "The drying is over."
msgstr "Сушка завершилась."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT"
msgid "The drying is over."
msgstr "Сушка завершилась."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYING"
msgid "It sways in the drying wind."
msgstr "Оно качается на иссушающем ветру."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN"
msgid "The rain is keeping it from drying."
msgstr "Дождь не даёт мясу высохнуть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT"
msgid "The rain is keeping it from drying."
msgstr "Дождь не даёт мясу высохнуть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT"
msgid "It sways in the drying wind."
msgstr "Оно качается на иссушающем ветру."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.GENERIC"
msgid "One can't survive long without food..."
msgstr "Никто не живёт долго без еды..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED"
msgid "Broken and abandoned."
msgstr "Сломлена и покинута."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT"
msgid "It's done drying. Forever."
msgstr "С сушкой покончено. Навсегда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE"
msgid "The drying is over."
msgstr "Сушка завершилась."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_NOTMEAT"
msgid "The drying is over."
msgstr "Сушка завершилась."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT"
msgid "Food without salt is like life without..."
msgstr "Еда без соли как жизнь без..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING"
msgid "It sways in the drying wind."
msgstr "Оно качается на иссушающем ветру."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN"
msgid "The rain is keeping it from drying."
msgstr "Дождь не даёт мясу высохнуть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN_NOTMEAT"
msgid "The rain is keeping it from drying."
msgstr "Дождь не даёт мясу высохнуть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING_NOTMEAT"
msgid "It sways in the drying wind."
msgstr "Оно качается на иссушающем ветру."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC"
msgid "One can dry much on there. How optimistic."
msgstr "Тут можно многое высушить. Какой оптимизм."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATYSALAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATYSALAD"
msgid "This salad tastes strange..."
msgstr "Этот салат странный на вкус..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEAT_DRIED"
msgid "Meat turned dry and delicious."
msgstr "Мясо, высушенное и вкусное."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEGAFLARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEGAFLARE"
msgid "I could just let the monsters come for me..."
msgstr "Я могла бы просто позволить монстрам прийти за мной..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM"
msgid "Horrid swamp thing!"
msgstr "Ужасная болотная тварь!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMARMORHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMARMORHAT"
msgid "I'm not a merm."
msgstr "Я не мэрм."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMARMORUPGRADEDHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMARMORUPGRADEDHAT"
msgid "I'm not a merm."
msgstr "Я не мэрм."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMCORPSE.BURNING"
msgid "Their ashes belong in the swamp."
msgstr "Их прах должен покоиться на болоте."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMCORPSE.GENERIC"
msgid "I can't help feeling sorry for the horrid swamp thing."
msgstr "Я не могу не сочувствовать этой ужасной болотной твари."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMCORPSE.REVIVING"
msgid "It's unnatural."
msgstr "Это неестественно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMGUARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMGUARD"
msgid "Friend or foe?"
msgstr "Друг или враг?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMGUARD_LUNAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMGUARD_LUNAR"
msgid "Their eyes... they're so vacant and cold..."
msgstr "Их глаза... они такие пустые и холодные..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMGUARD_SHADOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMGUARD_SHADOW"
msgid "You shed everything you were. Does it feel... good?"
msgstr "Ты сбросил всё, чем был. Чувствуешь ли ты себя... хорошо?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHAT"
msgid "We all hide behind our own masks..."
msgstr "Все мы прячемся за своими собственными масками..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHEAD.BURNT"
msgid "Somehow, it found a way to sink even lower."
msgstr "Как ни странно, нашёлся способ унизить его ещё больше."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHEAD.GENERIC"
msgid "No dignity at all."
msgstr "Совсем никакого уважения."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHOUSE.BURNT"
msgid "Fire has broken it down even further."
msgstr "Огонь не пощадил его ещё больше."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHOUSE.GENERIC"
msgid "Time has broken it down."
msgstr "Время его не пощадило."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHOUSE_CRAFTED.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHOUSE_CRAFTED.BURNT"
msgid "Nothing but ash."
msgstr "Остался только пепел."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC"
msgid "It has not yet been touched by the ravages of time."
msgstr "Пока что его не тронуло сокрушающее воздействие времени."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMKING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMKING"
msgid "He does look very regal, despite the warts."
msgstr "Он и впрямь выглядит очень царственно, несмотря на бородавки."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMTHRONE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMTHRONE.BURNT"
msgid "Their kingdom vanishes as swiftly as it appeared."
msgstr "Их королевство пропало настолько же быстро, насколько и появилось."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMTHRONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMTHRONE.GENERIC"
msgid "\"The Frogs Who Desired a King\"..."
msgstr "\"Лягушки, просящие царя\"..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT"
msgid "All that work, for nothing."
msgstr "Вся эта работа - даром."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC"
msgid "I don't know why you bother."
msgstr "Не знаю, почему тебе не всё равно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMWATCHTOWER_NOKING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMWATCHTOWER_NOKING"
msgid "They fight without purpose..."
msgstr "Они сражаются без цели..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMWATCHTOWER_REGULAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMWATCHTOWER_REGULAR"
msgid "They seem to not wish us harm, for now."
msgstr "Пока что они не желают нам зла."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_ARMORY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_ARMORY"
msgid "\"Mermfolk Ownlee\"... hmph. How childish."
msgstr "«Собствиность народа мэрмов»... пф. Как это по-детски."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_ARMORY_UPGRADED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_ARMORY_UPGRADED"
msgid "\"Mermfolk Ownlee\"... hmph. How childish."
msgstr "«Собствиность народа мэрмов»... пф. Как это по-детски."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_LUNAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_LUNAR"
msgid "Their eyes... they're so vacant and cold..."
msgstr "Их глаза... они такие пустые и холодные..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_PRINCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_PRINCE"
msgid "Are you ready to shoulder the burdens of leadership?"
msgstr "Готовы ли вы взять на себя бремя лидерства?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_SHADOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_SHADOW"
msgid "You shed everything you were. Does it feel... good?"
msgstr "Ты сбросил всё, чем был. Чувствуешь ли ты себя... хорошо?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_TOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_TOOL"
msgid "It's only slightly better than useless."
msgstr "Это лишь немногим лучше, чем бесполезно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_TOOLSHED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_TOOLSHED"
msgid "Father had a tool shed, though he hardly used it."
msgstr "У отца был сарай для инструментов, но он им почти не пользовался."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_TOOLSHED_UPGRADED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_TOOLSHED_UPGRADED"
msgid "Father had a tool shed, though he hardly used it."
msgstr "У отца был сарай для инструментов, но он им почти не пользовался."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_TOOL_UPGRADED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_TOOL_UPGRADED"
msgid "It's only slightly better than useless."
msgstr "Это лишь немногим лучше, чем совсем бесполезно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MESSAGEBOTTLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MESSAGEBOTTLE"
msgid "I wonder what poor forgotten soul sent that."
msgstr "Интересно, что за бедная забытая душа оправила это."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MESSAGEBOTTLEEMPTY"
msgid "It holds nothing but emptiness."
msgstr "В ней нет ничего кроме пустоты."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MIGHTY_GYM.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MIGHTY_GYM.BURNT"
msgid "It's nothing but ashes and memories."
msgstr "Это не что иное, как пепел и воспоминания."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MIGHTY_GYM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MIGHTY_GYM.GENERIC"
msgid "It seems strength can only be found through suffering."
msgstr "Кажется, что силу можно обрести только через страдания."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MILKYWHITES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MILKYWHITES"
msgid "Ashes to ashes, dust to... this."
msgstr "Пепел к пеплу, прах к... этому."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINERHAT"
msgid "Hands-free lighting!"
msgstr "И светло, и руки свободны!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINIBOATLANTERN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINIBOATLANTERN"
msgid "Such a happy little glow... I despise it."
msgstr "Такой счастливый мелкий огонёк... я его презираю."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINIFAN"
msgid "When I am still, it is as lifeless as Abigail."
msgstr "Когда я просто стою, она безжизненна, как Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINIFLARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINIFLARE"
msgid "Why? No one will come."
msgstr "Зачем? Никто не придёт."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINISIGN.GENERIC"
msgid "Such a striking likeness..."
msgstr "Такое поразительное сходство..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINISIGN.UNDRAWN"
msgid "It is bare..."
msgstr "Она пуста..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINISIGN_ITEM"
msgid "We must stick it in the cold, hard ground..."
msgstr "Мы должны держать его на холодной, твердой почве..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINOTAUR"
msgid "He must be lonely, trapped in such a small cage."
msgstr "Ему, наверное, одиноко. Взаперти в такой маленькой клетушке."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINOTAURCHEST"
msgid "My, what magnificent horns you have!"
msgstr "Господи, какие потрясающие у него рога!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINOTAURHORN"
msgid "All that remains of a once great beast."
msgstr "Всё, что осталось от некогда великого зверя."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLE.ABOVEGROUND"
msgid "You should go back to where it's dark."
msgstr "Тебе стоит вернуться назад, где тьма."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLE.HELD"
msgid "How do you like being torn away from your family?"
msgstr "Ну и как, нравится быть оторванным от своей семьи?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLE.UNDERGROUND"
msgid "Stay down there, away from this horrible place."
msgstr "Оставайся там внизу, подальше от этого ужасного места."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLEBAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLEBAT"
msgid "Nature has played a cruel joke on this creature."
msgstr "Природа сыграла злую шутку на этом существе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLEBATHILL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLEBATHILL"
msgid "Abigail keeps daring me to touch it..."
msgstr "Абигейл всё подзадоривает меня дотронуться до неё..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLEHAT"
msgid "So this is what those things see."
msgstr "Так вот что видят эти создания."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLEHILL"
msgid "Down, down, down to the depths."
msgstr "Всё ниже, и ниже, и ниже, в самые глубины."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEY"
msgid "Living without the burden of intelligence must be nice."
msgstr "Жизнь без бремени интеллекта, наверное, приятна."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYBARREL"
msgid "It's filthy."
msgstr "Она грязная."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYHUT.BURNT"
msgid "Charred remains are all that's left."
msgstr "Обугленные останки и всё."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYHUT.GENERIC"
msgid "I never cared for climbing trees, no matter how many times Abby prodded me."
msgstr "Мне никогда не нравилось лазать по деревьям, сколько бы раз Абби меня ни подталкивала."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYISLAND_PORTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYISLAND_PORTAL"
msgid "For a moment I let myself imagine it might take me home... when will I learn?"
msgstr "На секунду я позволила себе подумать, что он может вернуть меня домой... когда я уже научусь?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS"
msgid "The scattered remains of some ill-fated machine."
msgstr "Разбросанные останки чьей-то злополучной машины."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYPILLAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYPILLAR"
msgid "Her kingdom is built on nothing but sand, and one day it will topple."
msgstr "Её королевство построено только на песке, в один день оно рассыпется в труху."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYQUEEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYQUEEN"
msgid "Queens don't usually scratch their backsides in public, do they Abigail?"
msgstr "Королевы обычно не чешут свою спину при людях, разве не так, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYTAIL"
msgid "Oh. They're so soft. And fuzzy."
msgstr "Оу. Они такие мягкие. И пушистые."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEY_MEDIUMHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEY_MEDIUMHAT"
msgid "A captain must go down with her ship."
msgstr "Капитан должен пойти на дно со своим судном."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEY_SMALLHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEY_SMALLHAT"
msgid "It makes my hair itch..."
msgstr "У меня от неё волосы чешутся..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONSTERLASAGNA"
msgid "Cooked evil is still evil. Even in lasagna."
msgstr "Приготовленное зло, это всё равно зло, пусть даже в виде лазаньи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONSTERMEAT"
msgid "Evilness pervades it."
msgstr "Оно пропитано злом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONSTERMEAT_DRIED"
msgid "Meat turned dry and weird-tasting."
msgstr "Мясо высушилось, но странный привкус не пропал."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONSTERTARTARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONSTERTARTARE"
msgid "Looks good, tastes horrible."
msgstr "Выглядит хорошо, а на вкус — не очень."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.BROKEN"
msgid "It's been ravaged by time."
msgstr "Время разрушило её."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.GENERIC"
msgid "I felt a terrible chill run down my spine."
msgstr "Я почувствовала, как ужасный холод пробежался по моей спине."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "Bathed in pale eternal light..."
msgstr "Купается в вечном бледном свете..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.STAFFED"
msgid "Perhaps it thirsts for a sacrifice. Where's Webber..."
msgstr "Возможно, нужно жертвоприношение. Где Веббер?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "That doesn't look right..."
msgstr "Выглядит неправильно..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBUTTERFLY.GENERIC"
msgid "Such beauty can never last."
msgstr "Такая красота не может длиться вечно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBUTTERFLY.HELD"
msgid "Give up. You won't escape my grasp."
msgstr "Сдайся. Ты не избежишь объятий смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBUTTERFLYWINGS"
msgid "It's the way of all things."
msgstr "Таков порядок вещей."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBUTTERFLY_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBUTTERFLY_SAPLING"
msgid "It grows, against all odds."
msgstr "Он растёт, несмотря ни на что."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.CAVE"
msgid "Caves. The moon's one weakness."
msgstr "Пещеры. Единственная слабость луны."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.GENERIC"
msgid "Does it reflect from the other side too, Abigail?"
msgstr "А со стороны загробного мира, отражения видны, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.GLASSED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.GLASSED"
msgid "It's staring at me."
msgstr "Он смотрит на меня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "A full moon looms overhead. Watchful."
msgstr "Полная луна сияет над головой. Заглядение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "A new moon looms above us."
msgstr "Новая луна повисла над нами."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "The moon is on the wane."
msgstr "Луна убывает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "The moon waxes before us."
msgstr "Перед нами растущая луна."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASS"
msgid "Its sharp edge would end this quickly."
msgstr "Его острый конец быстро бы всё закончил."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASSAXE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASSAXE"
msgid "Death is so anticlimactic for trees."
msgstr "Смерть такая разочаровывающая для деревьев."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASS_CHARGED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASS_CHARGED"
msgid "It feels almost alive, somehow."
msgstr "Почему-то он кажется почти живым."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASS_ROCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASS_ROCK"
msgid "What a sickly color."
msgstr "Какой отвратный цвет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASS_WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASS_WOBSTER_DEN"
msgid "What lives within that cold glass mound?"
msgstr "Кто проживает на дне этой ямы?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCKCRATER"
msgid "It's useless and missing a piece, much like me."
msgstr "Он бесполезен, и в нём не хватает части. Мы похожи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCKIDOL"
msgid "A lifeless sacrifice."
msgstr "Безжизненная жертва."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCKNUGGET"
msgid "It's traveled so far..."
msgstr "Он путешествовал так долго..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCKSEED"
msgid "Its pallor reminds me of Abigail."
msgstr "Её бледность напоминает мне Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCK_PIECES"
msgid "Now it will never decay..."
msgstr "Теперь он никогда не разрушится."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSPIDERDEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSPIDERDEN"
msgid "Terrible creatures lurk within."
msgstr "Внутри скрываются ужасные существа."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_GLASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_GLASS.GENERIC"
msgid "Cold glass."
msgstr "Холодное стекло."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_GLASS.INFUSED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_GLASS.INFUSED"
msgid "There's light trapped inside."
msgstr "Внутри заперт свет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_GOGGLESHAT"
msgid "I shall be able to see with eyes unclouded."
msgstr "Я смогу видеть незамутнёнными глазами."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_SPARK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_SPARK"
msgid "It doesn't feel of this world."
msgstr "Он будто из другого мира."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_STATIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_STATIC"
msgid "That looks rather dangerous... I wonder if he'd let me try."
msgstr "Это выглядит довольно опасно... Интересно, разрешит ли он мне попробовать?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_STATIC_CATCHER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_STATIC_CATCHER"
msgid "Empty."
msgstr "Пусто."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_STATIC_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_STATIC_ITEM"
msgid "I can see a little spark inside."
msgstr "Я вижу маленькую искорку внутри."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_STATIC_ROAMER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_STATIC_ROAMER"
msgid "Like a roaming little spirit."
msgstr "Будто маленький блуждающий призрак."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR.GENERIC"
msgid "Heehee. Yes, I'd love to hear a secret."
msgstr "Хи-хи. Да, я бы хотела услышать секрет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP"
msgid "It doesn't feel good to be incomplete."
msgstr "Не очень-то приятно быть не одним целым."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ASTRAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ASTRAL"
msgid "You are whole again."
msgstr "Ты вновь цел."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_COSMIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_COSMIC"
msgid "The whispers... are getting louder..."
msgstr "Шёпот... становится громче..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_CROWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_CROWN"
msgid "You're safe now."
msgstr "Теперь ты в безопасности."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_GLASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_GLASS"
msgid "It wants to find its missing pieces."
msgstr "Он хочет найти недостающие части."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ICON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ICON"
msgid "I will take you to your final resting place."
msgstr "Я отведу тебя к месту твоего последнего упокоения."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_IDOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_IDOL"
msgid "Abby and I will help put you back together."
msgstr "Мы с Абби поможем тебе стать одним целым."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_LINK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_LINK"
msgid "Is something hiding in there?"
msgstr "Там что-то прячется?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ROCK_GLASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ROCK_GLASS"
msgid "I sense a presence within..."
msgstr "Я чувствую чьё-то присутствие внутри..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
msgid "I sense a presence within..."
msgstr "Я чувствую чьё-то присутствие внутри..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ROCK_SEED"
msgid "I sense a presence within..."
msgstr "Я чувствую чьё-то присутствие внутри..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_SEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_SEED"
msgid "It wants some sort of energy."
msgstr "Она нуждается в какой-то энергии."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_WARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_WARD"
msgid "So lost and alone... my sister and I will help you."
msgstr "Так одинок и потерян... Мы с сестрой поможем тебе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_CAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_CAP"
msgid "It took nourishment from dead things, now its death will nourish me."
msgstr "Он питался от мёртвых вещей, теперь его смерть насытит меня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_CAP_COOKED"
msgid "All is malleable."
msgstr "Всему приходит конец."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_DEVICE.CONSTRUCTION1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_DEVICE.CONSTRUCTION1"
msgid "There's so much left to be done..."
msgstr "Так много ещё предстоит сделать..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_DEVICE.CONSTRUCTION2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_DEVICE.CONSTRUCTION2"
msgid "It's quite odd looking, isn't it?"
msgstr "Довольно странно выглядит, не правда ли?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_DEVICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_DEVICE.GENERIC"
msgid "How very peculiar."
msgstr "Как своеобразно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_FISSURE.GENERIC"
msgid "I see the light."
msgstr "Я вижу свет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_FISSURE.NOLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_FISSURE.NOLIGHT"
msgid "Even the earth is falling apart under the pressure."
msgstr "Даже земля разваливается под давлением."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_FISSURE_PLUGGED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_FISSURE_PLUGGED"
msgid "They're trapped... for now."
msgstr "Они в ловушке... пока что."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE.BURNING"
msgid "Oh. It's burning."
msgstr "О. Оно горит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE.BURNT"
msgid "Your suffering is over now."
msgstr "Твои страдания закончились."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE.CHOPPED"
msgid "It's met its end at our hands."
msgstr "Оно встретило свой конец в наших руках."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE.GENERIC"
msgid "A fleeting beauty."
msgstr "Мимолетная красота."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE_BLOSSOM"
msgid "Delicate and impermanent."
msgstr "Нежная и непостоянная."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE_BLOSSOM_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE_BLOSSOM_DRIED"
msgid "I like how they smell."
msgstr "Мне нравится его аромат."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOOSE"
msgid "It's an abomination."
msgstr "Ну и мерзость."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOOSEEGG"
msgid "Not sure how a thing like that happens."
msgstr "Ума не приложу, как такое вообще может происходить."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "A cradle of life. I hate it."
msgstr "Колыбель жизни. Ненавижу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOQUECA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOQUECA"
msgid "Thank-you, Warly."
msgstr "Спасибо, Варли."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITO.GENERIC"
msgid "It thieves others' life to maintain its own."
msgstr "Ворует чужую жизнь, чтобы поддерживать свою."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITO.HELD"
msgid "I can feel its stolen warmth."
msgstr "Я чувствую тепло, что он отнял."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOBOMB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOBOMB"
msgid "The enemies of my enemies are my mosquitoes."
msgstr "Враги моих врагов - мои комары."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOFERTILIZER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOFERTILIZER"
msgid "The best nourishment is the lifeblood of another."
msgstr "Лучшая пища - это жизненная сила другого человека."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOMERMSALVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOMERMSALVE"
msgid "Don't worry, this will only hurt for a moment."
msgstr "Не волнуйся, больно будет только на мгновение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOMUSK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOMUSK"
msgid "What an ugly little doll."
msgstr "Какая уродливая кукла."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOSACK"
msgid "A sack of blood ripped from a mosquito. I love it."
msgstr "Брюхо с кровью, оторванное от комара. Мне нравится."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSSLING"
msgid "A new life. The last thing anyone needs."
msgstr "Новая жизнь. Последнее, чего желает каждый."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOUND.DUG"
msgid "The earth has vomited up its secrets."
msgstr "Земля изрыгнула свои секреты."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOUND.GENERIC"
msgid "Some day, I will join you."
msgstr "Когда-нибудь, я присоединюсь к вам."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MULLEDDRINK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MULLEDDRINK"
msgid "Can it thaw a cold, broken heart?"
msgstr "Сможет ли он согреть холодное разбитое сердце?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "Its beauty is tinged with a heartbreaking sadness."
msgstr "Его красота окрашена душераздирающей печалью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "Cold and beautiful like death."
msgstr "Холодно и красиво, как смерть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "An item with multiple uses."
msgstr "Им можно пользоваться в разных ситуациях."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHGNOME
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHGNOME"
msgid "It's so... bouncy."
msgstr "Он такой... упругий."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOMBOMB"
msgid "Death in mushroom form."
msgstr "Смерть в форме гриба."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOMHAT"
msgid "If I'm lucky, it'll be poisonous."
msgstr "Если мне повезёт, то она будет ядовита."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "Death has released it."
msgstr "Смерть его выпустила."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "A death cap, surely."
msgstr "Бледная поганка, конечно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "It is no more."
msgstr "Её больше нет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "Emptiness. The natural state of all things."
msgstr "Пустота. Естественное состояние всех вещей."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "It thrives... against all odds..."
msgstr "Они прорастают ... вопреки всему ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "Nothing escapes the pull of decay."
msgstr "Ничто не может избежать разрушения."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "A frigid cold bites at its heart."
msgstr "Холод окутал её полностью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "The beginnings of life..."
msgstr "Начало жизни..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "Completely teeming with life..."
msgstr "Кишит жизнью..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "Life goes on."
msgstr "Жизнь продолжается."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "Oh look... A mushroom..."
msgstr "О, смотри... гриб..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "Abigail would have thought this was... pretty..."
msgstr "Абигейл бы подумала, что это... красиво..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "Nothing good may last."
msgstr "Ничто не вечно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "Let's turn it red as my heart's blood..."
msgstr "Давайте сделаем его красным, как цвет крови моего сердца..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "Such a sickly fungal glow..."
msgstr "Такой болезненный и слабый свет..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED"
msgid "I know the scent of death and decay."
msgstr "Запах смерти и разложения. Он мне знаком."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "All its efforts fall on rocky soil."
msgstr "Все эти усилия падают на безжизненную почву."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "It looks like a rotting hat."
msgstr "Похоже на гниющую шляпу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_MOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_MOON"
msgid "Curiouser and curiouser."
msgstr "Все любопытнее и любопытнее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED"
msgid "I know the scent of death and decay."
msgstr "Запах смерти и разложения. Он мне знаком."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "It has a glowing presence."
msgstr "Это прям лучится светом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "Do little gnomes live in these?"
msgstr "А маленькие гномы тут живут?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED"
msgid "I know the scent of death and decay."
msgstr "Запах смерти и разложения. Он мне знаком."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "It's trying so hard. Why?"
msgstr "Оно так старается. Зачем?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "These are some strange trees."
msgstr "Вот уж странное, так странное."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED"
msgid "I know the scent of death and decay."
msgstr "Запах смерти и разложения. Он мне знаком."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC"
msgid "This one is frail and scorned. Like a friend."
msgstr "Такое хилое, вызывает лишь презрение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDBEARGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDBEARGER"
msgid "Don't worry. Abby and I will put you out of your misery."
msgstr "Не волнуйся. Абби и я избавят тебя от мучений."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDBIRD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDBIRD"
msgid "There's no life in its eyes."
msgstr "В её глазах нет жизни."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE"
msgid "Even in death, it consumes."
msgstr "Даже после смерти оно поглощает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC"
msgid "A truly bad omen."
msgstr "Воистину дурное знамение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDDEERCLOPS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDDEERCLOPS"
msgid "Forced to continue its cursed existence... I pity it."
msgstr "Его заставили продолжить своё проклятое существование... Мне его жаль."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDHOUND.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDHOUND.DEAD"
msgid "It's better this way."
msgstr "Пусть такой она и останется."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDHOUND.GENERIC"
msgid "For this creature, to live is to suffer."
msgstr "Для этого существа, жизнь - страдания."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDHOUND.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDHOUND.SLEEPING"
msgid "Don't wake up."
msgstr "Не просыпайся."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDWARG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDWARG"
msgid "It only lives for malice."
msgstr "Живёт лишь ради вреда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATED_PENGUIN.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATED_PENGUIN.DEAD"
msgid "It's better this way."
msgstr "Пусть такой она и останется."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATED_PENGUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATED_PENGUIN.GENERIC"
msgid "To let it live would be a cruelty."
msgstr "Оставить её в живых было бы жестокостью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATED_PENGUIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATED_PENGUIN.SLEEPING"
msgid "Don't wake up."
msgstr "Не просыпайся."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_DROPPER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_DROPPER"
msgid "Webber sees the world in a most curious way."
msgstr "Веббер видит мир самым любопытным образом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_HEALER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_HEALER"
msgid "It's the only thing smiling around here."
msgstr "Единственное, что здесь улыбается."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_HIDER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_HIDER"
msgid "Very well, since you made the cookies you can bring one spider friend to our tea party."
msgstr "Очень хорошо, что ты испёк печенье, теперь на наше чаепитие можно привести одного друга-паука."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_MOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_MOON"
msgid "Very well, since you made the cookies you can bring one spider friend to our tea party."
msgstr "Очень хорошо, что ты испёк печенье, теперь на наше чаепитие можно привести одного друга-паука."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_SPITTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_SPITTER"
msgid "It's the only thing smiling around here."
msgstr "Единственное, что здесь улыбается."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_WARRIOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_WARRIOR"
msgid "Very well, since you made the cookies you can bring one spider friend to our tea party."
msgstr "Очень хорошо, что ты испёк печенье, теперь на наше чаепитие можно привести одного друга-паука."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_WATER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_WATER"
msgid "Webber sees the world in a most curious way."
msgstr "Веббер видит мир самым любопытным образом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NATURE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NATURE_BLUEPRINT"
msgid "Do you like this one, Abigail?"
msgstr "Тебе он нравится, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTCAPHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTCAPHAT"
msgid "There are so few comforts to be found in this wretched place."
msgstr "В этом жалком месте так мало удобств, которые можно найти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTLIGHT"
msgid "Eerie, and yet beautiful."
msgstr "Жуткий, и тем не менее красивый."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMAREFUEL"
msgid "With the sleep of dreams comes this stuff."
msgstr "Со сном, кошмаров полным, является оно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMAREGROWTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMAREGROWTH"
msgid "Something wicked this way comes."
msgstr "Что-то опасное грядёт."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARELIGHT"
msgid "It pulls power from beneath."
msgstr "Он черпает энергию из преисподней."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMAREPIE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMAREPIE"
msgid "It tastes like melancholy. Mmm."
msgstr "На вкус как меланхолия. М-м-м."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "I know not what lurks in the shadow."
msgstr "Я даже не представляю что скрывается там, в тени."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "It's almost over."
msgstr "Почти закончилось."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "The presence has departed."
msgstr "Я здесь одна."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "They're all around!"
msgstr "Они вокруг! Повсюду!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "I think they're leaving."
msgstr "Я думаю, они уходят."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "I can feel the prying eyes."
msgstr "Я чувствую недобрые взгляды."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "They approach."
msgstr "Они приближаются."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTSTICK"
msgid "Danger in the dark."
msgstr "Опасность во тьме."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTSWORD"
msgid "Dreams come to a point. A sharp one."
msgstr "Кошмары обратились в лезвие. Острое лезвие."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NITRE"
msgid "Herein lies the folly of man."
msgstr "В нём вся глупость человеческая."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NITRE_FORMATION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NITRE_FORMATION"
msgid "It thrives while the rest of us burn."
msgstr "Она процветает, в то время как остальные из нас сгорают."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NONSLIPGRIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NONSLIPGRIT"
msgid "At least one thing won't slip away from me..."
msgstr "По крайней мере, одно от меня не ускользнёт..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NONSLIPGRITBOOSTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NONSLIPGRITBOOSTED"
msgid "I will salt the earth."
msgstr "Я посолю землю."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NUTRIENTSGOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NUTRIENTSGOGGLESHAT"
msgid "I used to like reading about plants... I suppose this is similar in a way."
msgstr "Раньше мне нравилось читать про растения... Полагаю, это что-то вроде того."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OAR"
msgid "I'd prefer to be stranded at sea."
msgstr "Я бы предпочла потеряться в море."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OAR_DRIFTWOOD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OAR_DRIFTWOOD"
msgid "Just when it thought it had escaped the ocean..."
msgstr "Как только он подумал, что сбежал из океана..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OAR_MONKEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OAR_MONKEY"
msgid "It slices through the waves without mercy."
msgstr "Прорезает волны без пощады."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OASISLAKE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OASISLAKE.EMPTY"
msgid "If only my tears could dry up like this lake."
msgstr "Если бы только мои слёзы могли высохнуть, как это озеро."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OASISLAKE.GENERIC"
msgid "A place to drown my sorrows."
msgstr "Место, чтобы утопить мои печали."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHABLEFLOTSAM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHABLEFLOTSAM"
msgid "Nothing but grass and muck."
msgstr "Ничего, кроме травы и грязи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_BALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_BALL"
msgid "It floats happily until something drags it under."
msgstr "Он счастливо парит, пока что-то не утащит его под воду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_CANARY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_CANARY"
msgid "It floats happily until something drags it under."
msgstr "Он счастливо парит, пока что-то не утащит его под воду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_CROW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_CROW"
msgid "It floats happily until something drags it under."
msgstr "Он счастливо парит, пока что-то не утащит его под воду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_GOOSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_GOOSE"
msgid "It floats happily until something drags it under."
msgstr "Он счастливо парит, пока что-то не утащит его под воду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS"
msgid "It floats happily until something drags it under."
msgstr "Он счастливо парит, пока что-то не утащит его под воду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_NONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_NONE"
msgid "The line seems terribly bare... perhaps it needs something..."
msgstr "Леска кажется ужасно пустой... может, ей что-то нужно..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_OVAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_OVAL"
msgid "It floats happily until something drags it under."
msgstr "Он счастливо парит, пока что-то не утащит его под воду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_ROBIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_ROBIN"
msgid "It floats happily until something drags it under."
msgstr "Он счастливо парит, пока что-то не утащит его под воду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER"
msgid "It floats happily until something drags it under."
msgstr "Он счастливо парит, пока что-то не утащит его под воду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY"
msgid "Perhaps it's poisoned?"
msgstr "Может он отравлен?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY"
msgid "I'll never catch a fish as heavy as my heart."
msgstr "Ни одна рыба не будет настолько тяжёлой, насколько моё сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN"
msgid "The rain will mask my tears of boredom..."
msgstr "Дождь скроет мои слезы скуки..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW"
msgid "How miserable."
msgstr "Как ничтожно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE"
msgid "A paltry last meal for the fish."
msgstr "Жалкая последняя трапеза для рыбы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN"
msgid "A paltry last meal for the fish."
msgstr "Жалкая последняя трапеза для рыбы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED"
msgid "A paltry last meal for the fish."
msgstr "Жалкая последняя трапеза для рыбы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE"
msgid "A paltry last meal for the fish."
msgstr "Жалкая последняя трапеза для рыбы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN"
msgid "A paltry last meal for the fish."
msgstr "Жалкая последняя трапеза для рыбы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPOON_RED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPOON_RED"
msgid "A paltry last meal for the fish."
msgstr "Жалкая последняя трапеза для рыбы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGROD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGROD"
msgid "The depths will offer no safety from my hook."
msgstr "Глубины не уберегут рыбу от моего крючка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_1"
msgid "What a horrendous looking creature."
msgstr "Что за чудовищное создание."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_2"
msgid "I'm afraid your time is up."
msgstr "Боюсь, твоё время истекло."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_3"
msgid "It fought hard to live. A shame, really."
msgstr "Она упорно боролась за жизнь. Очень жаль, правда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_4"
msgid "My luck couldn't possibly be worse than it already is."
msgstr "Хуже чем сейчас, моя удача уже не станет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_5
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_5"
msgid "Its existence must be so confusing."
msgstr "Она, наверное, так сбита с толку своим существованием."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_6
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_6"
msgid "It's almost too pretty to eat. Almost."
msgstr "Она почти слишком красива, чтобы её есть. Почти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_7
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_7"
msgid "It's almost too pretty to eat. Almost."
msgstr "Она почти слишком красива, чтобы её есть. Почти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_8
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_8"
msgid "It has no warmth... like my life without Abigail."
msgstr "В ней нет тепла... как и в моей жизни без Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_9
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_9"
msgid "A fish, by any name, should not smell sweet."
msgstr "Рыба, как бы её ни называли, не должна сладко пахнуть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_1"
msgid "It didn't have enough time to grow."
msgstr "У неё не было достаточно времени, чтобы вырасти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_2"
msgid "I'm afraid you've splished your last splash."
msgstr "Боюсь, ты всплеснула свой последний всплеск."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_3"
msgid "I suppose it will do for now."
msgstr "Предполагаю, на данный момент она сойдёт."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_4"
msgid "All my efforts reap only the smallest rewards."
msgstr "Все мои усилия приносят лишь самую малую награду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_5
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_5"
msgid "It looks oddly... crunchy?"
msgstr "Она выглядит на удивление... хрустящей?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_6
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_6"
msgid "It already reeks of decay."
msgstr "Она разлагается у меня на руках."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_7
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_7"
msgid "Hmph. I see no resemblance."
msgstr "Хм. Не вижу никакого сходства."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_8
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_8"
msgid "The sun has set on your time in this world."
msgstr "Солнце будет последним, что ты увидишь в этом мире."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_9
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_9"
msgid "What a rude little creature."
msgstr "Какое грубое маленькое существо."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANTREE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANTREE"
msgid "Its roots have the appearance of sunbleached bones."
msgstr "Его корни выглядят как выгоревшие на солнце кости."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANTREENUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANTREENUT"
msgid "How strange that it doesn't drown when dropped to the bottom of the ocean."
msgstr "Как странно, что он не тонет, когда его роняют на дно океана."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANTREE_PILLAR"
msgid "It reminds me of happier days, sitting in the dappled shade..."
msgstr "Напоминает мне о более счастливых днях, когда мы сидели в пятнистой тени..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANVINE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANVINE"
msgid "This would make a good hangman's tree."
msgstr "Из неё вышло бы прекрасное висельное дерево."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANVINE_COCOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANVINE_COCOON"
msgid "Something sinister lurks above us."
msgstr "Что-то зловещее скрывается над нами."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANVINE_COCOON_BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANVINE_COCOON_BURNT"
msgid "Nothing but ash remains."
msgstr "Остался только пепел."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANWHIRLBIGPORTALEXIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANWHIRLBIGPORTALEXIT"
msgid "Is it even worth digging through?"
msgstr "Стоит ли вообще копаться в этом?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANWHIRLPORTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANWHIRLPORTAL"
msgid "It calls to me."
msgstr "Он взывает ко мне."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.CAUGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.CAUGHT"
msgid "I'm sorry. You are the unlucky ones."
msgstr "Мне жаль. Вам не повезло."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.ESCAPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.ESCAPED"
msgid "Ah. Of course."
msgstr "Ах. Ну конечно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.FIXED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.FIXED"
msgid "Somehow, I managed to fix it."
msgstr "Каким-то образом, я умудрилась починить его."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.GENERIC"
msgid "The fish must die, so that I may prolong my own terrible existence."
msgstr "Рыбы должны умереть, чтобы я смогла продлить своё ужасное существование."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.LOWERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.LOWERED"
msgid "I shouldn't get my hopes up..."
msgstr "Мне не стоит завышать свои ожидания..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER_KIT"
msgid "Even I should be able to build it simply enough."
msgstr "Даже я должна с этим справиться."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT.GENERIC"
msgid "Empty."
msgstr "Пусто."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT.LOTS_OF_KELP"
msgid "So even the merms have their limits."
msgstr "Похоже что даже у мэрмов есть свои пределы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT.SOME_KELP"
msgid "The merms are in an endless cycle of feeding. Give them more."
msgstr "У мэрмов бесконечный цикл кормления. Дайте им ещё."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC"
msgid "Empty."
msgstr "Пусто."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP"
msgid "So, even the merms have their limits."
msgstr "Похоже что даже у мэрмов есть свои пределы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP"
msgid "The merms are in an endless cycle of feeding. Give them more."
msgstr "У мэрмов бесконечный цикл кормления. Дайте им ещё."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ONEMANBAND"
msgid "I used to take joy in instruments such as these."
msgstr "Раньше я радовалась таким инструментам."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ONION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ONION"
msgid "I never cry."
msgstr "Я никогда не плачу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ONION_COOKED"
msgid "It will never make anyone cry again."
msgstr "Больше он никого не заставить плакать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ONION_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ONION_OVERSIZED"
msgid "You won't draw any tears from me."
msgstr "Ты не заставишь меня плакать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ONION_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Жизнь, которую они содержат, является загадкой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OPALPRECIOUSGEM"
msgid "I see a million sad eyes reflecting back at me..."
msgstr "Я вижу миллион грустных глаз, смотрящих на меня..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OPALSTAFF"
msgid "As cold and lifeless as... well..."
msgstr "Столь же холодный и безжизненный как... ладно..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ORANGEAMULET"
msgid "Temporary release from drudgery."
msgstr "Временное освобождение от рутины жизни."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ORANGEGEM"
msgid "Such things used to bring me happiness."
msgstr "Раньше я любила такие вещи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ORANGEMOONEYE"
msgid "It sees all, and yet nothing."
msgstr "Видит всё и всё-таки ничего."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ORANGESTAFF"
msgid "With each use the wielder dies and is again reborn."
msgstr "Каждый раз, когда использую его, я умираю и рождаюсь снова."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OTTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OTTER"
msgid "Is it true they hold paws while sleeping at sea to not get separated?"
msgstr "Правда ли, что они держатся за лапы, когда спят в море, чтобы не разлучаться?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OTTERDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OTTERDEN.GENERIC"
msgid "It has nothing."
msgstr "Ничего нет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OTTERDEN.HAS_LOOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OTTERDEN.HAS_LOOT"
msgid "If I take what's there, the creature may starve."
msgstr "Если я возьму то, что там есть, это существо может умереть с голоду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OTTERDEN_DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OTTERDEN_DEAD"
msgid "I had a feeling it would end at sea."
msgstr "У меня было предчувствие, что всё закончится в море."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PALMCONETREE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PALMCONETREE"
msgid "Your hardened exterior won't protect you from the world."
msgstr "Твоя твёрдая оболочка не защитит тебя от этого мира."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PALMCONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PALMCONE_SAPLING"
msgid "It may yet have the chance to grow up."
msgstr "Может у неё появиться шанс вырасти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PALMCONE_SCALE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PALMCONE_SCALE"
msgid "I warned you that your armor wouldn't protect you."
msgstr "Я предупреждала тебя, что твоя броня тебя не защитит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PALMCONE_SEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PALMCONE_SEED"
msgid "A tree that has barely begun to live."
msgstr "Дерево, которое только начало свою жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PANDORASCHEST"
msgid "Life is a gamble."
msgstr "Жизнь - азартная игра."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PANETTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PANETTONE"
msgid "It's... delicious."
msgstr "Он... великолепен."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PANFLUTE"
msgid "Music is the window to my empty soul."
msgstr "Музыка есть окно к моей пустой душе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PAPYRUS"
msgid "For documenting my pain."
msgstr "Для записи моих страданий."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PAVLOVA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PAVLOVA"
msgid "It's brittle and delicate, like life itself."
msgstr "Хрупкие и нежные, как сама жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PEGHOOK"
msgid "Abigail will defend me."
msgstr "Абигейл защитит меня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PENGUIN"
msgid "All dressed up, but where to go?"
msgstr "Все так вырядились, но пойти-то некуда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PENGUINCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PENGUINCORPSE.BURNING"
msgid "Now it is truly free. Well, as free as a flightless bird."
msgstr "Теперь она по-настоящему свободна. Ну, свободна, как нелетающая птица."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PENGUINCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PENGUINCORPSE.GENERIC"
msgid "Poor bird."
msgstr "Бедная пташка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PENGUINCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PENGUINCORPSE.REVIVING"
msgid "There can be a fate worse than death."
msgstr "Есть судьба гораздо хуже смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPER"
msgid "It looks so tiny and insignificant."
msgstr "Он выглядит таким мелким и незначительным."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPERPOPPER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPERPOPPER"
msgid "They're so good I almost forgot my crushing grief."
msgstr "Они настолько хороши, что я почти забыла о своём сокрушающем горе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPER_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPER_COOKED"
msgid "What can this tiny plant possibly do to fill my empty life?"
msgstr "Что это мелкое растение может в принципе сделать, чтобы наполнить мою пустую жизнь?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPER_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPER_OVERSIZED"
msgid "That is a very significant amount of pepper."
msgstr "Очень значительное количество перца."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPER_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPER_SEEDS"
msgid "Will I live to see this grow?"
msgstr "Доживу ли я, когда они вырастут?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PERD"
msgid "Dumb bird! Stay away from the berries!"
msgstr "Глупая птица! Отойди от ягод!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PERDFAN"
msgid "It's... surprisingly soft."
msgstr "Оно... удивительно мягкое."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PERDSHRINE.BURNT"
msgid "Black like my heart."
msgstr "Чёрное, как моё сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PERDSHRINE.EMPTY"
msgid "It's empty..."
msgstr "Пусто..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PERDSHRINE.GENERIC"
msgid "It hungers for a sacrifice."
msgstr "Он жаждет жертвы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PEROGIES"
msgid "A lovely little pouch of nutrients."
msgstr "Вкуснейшие кармашки с мясом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PETALS"
msgid "Its joy was so disparaging..."
msgstr "Недолго радовалось это существо..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PETALS_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PETALS_DRIED"
msgid "I like how they smell."
msgstr "Мне нравится их аромат."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PETALS_EVIL"
msgid "They are painted with the colors of my soul."
msgstr "Они окрашены в цвета моей души."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PETALS_EVIL_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PETALS_EVIL_DRIED"
msgid "I like how they smell."
msgstr "Мне нравится их аромат."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PETRIFIED_TREE"
msgid "Now it will never die..."
msgstr "Теперь оно никогда не умрёт..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PHLEGM"
msgid "The wretched beast must have been sick."
msgstr "Это жалкое чудовище, по всей видимости, ещё и болеет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PHONOGRAPH"
msgid "Shall we have a danse macabre?"
msgstr "Устроим пляску смерти?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PICKAXE"
msgid "That the earth itself might be penetrated."
msgstr "Ну что ж, теперь могу я вгрызться в твердь земную."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PICKAXE_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PICKAXE_LUNARPLANT"
msgid "It makes the endless toil a bit easier."
msgstr "Делает бесконечный труд немного легче."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PICKLEDHERRING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PICKLEDHERRING"
msgid "It tastes... good."
msgstr "Она... вкусная."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITE1"
msgid "A storm rages within him."
msgstr "Внутри него бушует буря."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITE2"
msgid "Furious."
msgstr "В ярости."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITE3"
msgid "His whole career is grounded in violence."
msgstr "Вся его карьера основана на насилии."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITE4"
msgid "Petrifying."
msgstr "Окаменел."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITEFIGHTER1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITEFIGHTER1"
msgid "A storm rages within him."
msgstr "Внутри него бушует буря."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITEFIGHTER2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITEFIGHTER2"
msgid "Furious."
msgstr "В ярости."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITEFIGHTER3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITEFIGHTER3"
msgid "His whole career is grounded in violence."
msgstr "Вся его карьера основана на насилии."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITEFIGHTER4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITEFIGHTER4"
msgid "Petrifying."
msgstr "Окаменел."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGGUARD"
msgid "This little piggie looks mean."
msgstr "Эта маленькая свинка выглядит очень воинственно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGGYBACK"
msgid "They are more useful in death."
msgstr "От них больше толку когда они мертвы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHEAD.BURNT"
msgid "He's been burnt down."
msgstr "Он был сожжён."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHEAD.GENERIC"
msgid "Kill the pig! Spill his blood!"
msgstr "Убейте свинью! Пролейте её кровь!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHOUSE.BURNT"
msgid "Nothing lasts forever."
msgstr "Ничто не вечно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHOUSE.FULL"
msgid "I hope they're enjoying themselves."
msgstr "Я надеюсь, что они наслаждаются."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHOUSE.GENERIC"
msgid "At least they are comfortable."
msgstr "По крайней мере, они удобны."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "Always on the outside, looking in."
msgstr "Теперь я совсем одна."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGKING"
msgid "Live it up while you can, Your Majesty."
msgstr "Прожигайте жизнь пока можете, Ваше Величество."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.DEAD"
msgid "He's better off, now."
msgstr "Ещё один отмучился."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.FOLLOWER"
msgid "I still feel alone."
msgstr "И всё же мне так одиноко."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.GENERIC"
msgid "They are so standoffish."
msgstr "Они такие неприветливые."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.GUARD"
msgid "How Orwellian."
msgstr "Как это по Оруэлловски."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.WEREPIG"
msgid "A creature of the night!"
msgstr "Создание ночи!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGSHRINE.BURNT"
msgid "Ashes to ashes."
msgstr "Прах к праху."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGSHRINE.EMPTY"
msgid "It needs a sacrifice of flesh."
msgstr "Нужна кровожадная жертва."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGSHRINE.GENERIC"
msgid "A tribute to gluttony."
msgstr "Почтение чревоугодия."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGSKIN"
msgid "The hide of a pig that once was."
msgstr "Шкура того, что когда-то было свиньёй."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGTENT"
msgid "The place where they wrap pigs in blankets."
msgstr "Место, в котором они заворачивают свиней в одеяла."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGTORCH"
msgid "It cuts at the darkness."
msgstr "Он прорезает тьму."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIG_COIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIG_COIN"
msgid "It pays for a fleeting friendship."
msgstr "Плата за мимолётную дружбу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIG_TOKEN"
msgid "Yet another unnecessary plaything."
msgstr "Ещё одна ненужная игрушка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PINECONE"
msgid "A tiny life, ensconced in brittle death."
msgstr "Крохотная жизнь приютилась в хрупкой смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PINECONE_SAPLING"
msgid "A tree will grow soon."
msgstr "Скоро вырастет дерево."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIRATE_FLAG_POLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIRATE_FLAG_POLE"
msgid "Those monkeys have no imagination. I've seen more macabre children's drawings."
msgstr "У этих обезьян нет воображения. Я видела как дети рисуют более угрожающие рисунки."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIRATE_STASH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIRATE_STASH"
msgid "Oh... did I... find the treasure?"
msgstr "О... Я нашла... Сокровище?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PITCHFORK"
msgid "What a devilish tool!"
msgstr "Какой дьявольский инструмент!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANTMEAT"
msgid "It has a foul smell."
msgstr "У него отвратительный запах."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANTMEAT_COOKED"
msgid "It's only slightly more appealing."
msgstr "Не намного лучше сырого."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANTREGISTRYHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANTREGISTRYHAT"
msgid "I don't like to play in the dirt..."
msgstr "Я не люблю играть в грязи..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "An edible plant."
msgstr "Съедобное растение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "Keep growing. I'll wait."
msgstr "Расти-расти. Я подожду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANT_NORMAL.READY"
msgid "It is ready for the harvest."
msgstr "Готово к сбору."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "It's had the life sucked out of it."
msgstr "Оно держалось за жизнь до последнего."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYBILL_THE_DOLL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYBILL_THE_DOLL"
msgid "What a strange little story."
msgstr "Какая странная история."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYBILL_THE_PRINCESS_YOTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYBILL_THE_PRINCESS_YOTH"
msgid "I do love horses."
msgstr "Мне нравятся лошади."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYBILL_THE_VAULT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYBILL_THE_VAULT"
msgid "It was written with a sorrowful pen."
msgstr "Написана скорбящим пером."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYBILL_THE_VEIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYBILL_THE_VEIL"
msgid "Fun!"
msgstr "Весело!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.ATTACKER"
msgid "%s... they'll betray us."
msgstr "%s... предательство."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.FIRESTARTER"
msgid "Do you wish to see the world burn?"
msgstr "Ты хочешь увидеть мир в огне?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.GENERIC"
msgid "How do you do, %s?"
msgstr "Как поживаешь, %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.GHOST"
msgid "A heart could return %s to this world..."
msgstr "Сердце может возвратить %s в этот мир..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.MURDERER"
msgid "Murderer! Cutthroat!"
msgstr "Убийца! Головорез!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.REVIVER"
msgid "Abigail likes you, %s."
msgstr "Ты нравишься Абигейл, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER_HOSTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER_HOSTED.GENERIC"
msgid "A souless existence."
msgstr "Бездушное существование."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER_HOSTED.ME
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER_HOSTED.ME"
msgid "I don't need another dead twin."
msgstr "Мне не нужна ещё одна мёртвая близняшка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYING_CARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYING_CARD"
msgid "A single playing card. Great."
msgstr "Одна игральная карта. Отлично."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_DISMANTLER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_DISMANTLER"
msgid "Tools for watch surgery."
msgstr "Инструменты для часовой хирургии."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_HEAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_HEAL.GENERIC"
msgid "It's soothing to watch the seconds tick away."
msgstr "Секунды жизни постепенно тикают. Это успокаивает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_HEAL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_HEAL.RECHARGING"
msgid "Its power is spent."
msgstr "Их сила потрачена."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PARTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PARTS"
msgid "Clock entrails."
msgstr "Внутренности часов."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL.GENERIC"
msgid "It's soothing to watch the seconds tick away."
msgstr "Секунды жизни постепенно тикают. Это успокаивает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL.RECHARGING"
msgid "Its power is spent."
msgstr "Их сила потрачена."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.DIFFERENTSHARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.DIFFERENTSHARD"
msgid "What will I find if I take a tumble down the rabbit hole?"
msgstr "Что я найду, если упаду в кроличью нору?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.GENERIC"
msgid "What will I find if I take a tumble down the rabbit hole?"
msgstr "Что я найду, если упаду в кроличью нору?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL_EXIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL_EXIT"
msgid "I'm afraid the past is just as dreadful as the future."
msgstr "Боюсь, прошлое так же ужасно, как и будущее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_RECALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_RECALL.GENERIC"
msgid "It's soothing to watch the seconds tick away."
msgstr "Секунды жизни постепенно тикают. Это успокаивает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_RECALL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_RECALL.RECHARGING"
msgid "Its power is spent."
msgstr "Их сила потрачена."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_REVIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_REVIVE.GENERIC"
msgid "Abigail... do you think...?"
msgstr "Абигейл... ты думаешь..?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_REVIVE.RECHARGING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_REVIVE.RECHARGING"
msgid "Its power is spent."
msgstr "Их сила потрачена."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_WARP.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_WARP.GENERIC"
msgid "It's soothing to watch the seconds tick away."
msgstr "Секунды жизни постепенно тикают. Это успокаивает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_WARP.RECHARGING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_WARP.RECHARGING"
msgid "Its power is spent."
msgstr "Их сила потрачена."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_WEAPON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_WEAPON.GENERIC"
msgid "Nothing could be as painful as my own memories."
msgstr "Нет ничего больнее моих воспоминаний."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKET_SCALE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKET_SCALE"
msgid "What is the weight of my actions?"
msgstr "Какова тяжесть моих грехов?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POLISHCOOKIE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POLISHCOOKIE"
msgid "I suppose... it wouldn't hurt to have one..."
msgstr "Ну, полагаю... одно мне не повредит..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POLLY_ROGERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POLLY_ROGERS"
msgid "I would have preferred a raven."
msgstr "Мне бы хотелось ворона."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POLLY_ROGERSHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POLLY_ROGERSHAT"
msgid "The hat of a cutthroat pirate."
msgstr "Шляпа пирата-головореза."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POMEGRANATE"
msgid "So many juicy red bits to chomp and squish!"
msgstr "Так много сочных красных кусочков, которые можно давить и мять!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POMEGRANATE_COOKED"
msgid "Warm, but no less messy."
msgstr "Тёплый, но лучше от этого он не стал."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POMEGRANATE_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POMEGRANATE_OVERSIZED"
msgid "I wonder how long a single seed would keep one trapped in the underworld..."
msgstr "Интересно, как долго одно семя будет держать в ловушке подземного мира?.."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POMEGRANATE_SEEDS"
msgid "It's a plant that's waiting to be."
msgstr "Это растение, которое ждёт своего часа."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POND"
msgid "Ophelia? Are you down there?"
msgstr "Ты там, Офелия?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PONDEEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PONDEEL"
msgid "An eel."
msgstr "Просто угорь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PONDFISH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PONDFISH"
msgid "It was flopping around desperately for life. The poor fool."
msgstr "Она беспечно бултыхалась тут всю свою жизнь. Глупышка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POND_ALGAE"
msgid "Some algae."
msgstr "Какие-то водоросли."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POOP"
msgid "Life is blood and this."
msgstr "Что жизнь? Лишь кровь и... это."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLEBLENDER_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLEBLENDER_ITEM"
msgid "Inflicts chaos and turmoil on food."
msgstr "Наводит панику и хаос на еду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG"
msgid "I may starve to death before it's done."
msgstr "Я могу умереть с голоду ещё до того, как оно будет готово."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT"
msgid "It will all be over soon."
msgstr "Скоро всё будет кончено."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE"
msgid "Another menial task has been completed."
msgstr "Ещё одна грязная задача была выполнена."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY"
msgid "A foodless void."
msgstr "Бесплодная бездна."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC"
msgid "For when the hunger gnaws at my tiny stomach..."
msgstr "Для тех времён, когда голод гложет мой мелкий желудок..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLEFIREPIT_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLEFIREPIT_ITEM"
msgid "I may carry warmth with me, yet I am ever cold."
msgstr "Я могу носить с собой тепло, но мне всегда холодно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLESPICER_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLESPICER_ITEM.DONE"
msgid "Finished."
msgstr "Готово."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLESPICER_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLESPICER_ITEM.GENERIC"
msgid "If only it could spice up my life."
msgstr "Если бы только я могла придать остроты своей жизни."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLETENT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLETENT"
msgid "It makes no difference where I rest my head, my nights are filled with bad dreams."
msgstr "Неважно, где я отдыхаю, мои ночи всегда полны кошмаров."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLETENT_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLETENT_ITEM"
msgid "Abigail and I set up a tent in our backyard once. It was... fun."
msgstr "Абигейл и Я однажды поставили палатку на заднем дворе. Было... весело."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATO"
msgid "It has eyes, yet it never cries."
msgstr "У него есть глазки, но он никогда не плачет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATOSACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATOSACK"
msgid "Large enough to hold a corpse... or a few dozen potatoes."
msgstr "Достаточно большой, чтобы вместить труп... или несколько дюжин картофелин."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATOSOUFFLE"
msgid "A dish as delicate as life itself."
msgstr "Блюдо, столь хрупкое, как и сама жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATOTORNADO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATOTORNADO"
msgid "Spiraling, just like my life."
msgstr "Сплошная петля, прямо как моя жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATO_COOKED"
msgid "Now its eyes will never open."
msgstr "Теперь его глаза никогда не откроются."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATO_OVERSIZED"
msgid "I'm not sure if I could even carry it on my own..."
msgstr "Я даже не уверена, что смогу сама его поднять..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATO_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Жизнь, которую они содержат, является загадкой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POTTEDFERN"
msgid "Its growth is stunted by the limits of the pot."
msgstr "Он чахнет в своём горшке."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POWCAKE"
msgid "I would have to be desperate."
msgstr "Только в случае крайней безысходности."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POWDER_MONKEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POWDER_MONKEY"
msgid "What more can be taken from me?"
msgstr "Сколько ещё будет отнято у меня?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PREMIUMWATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PREMIUMWATERINGCAN.EMPTY"
msgid "Dry as a bone..."
msgstr "Сухая как кость..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PREMIUMWATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PREMIUMWATERINGCAN.GENERIC"
msgid "What an odd looking watering can."
msgstr "Какая странная на вид лейка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PRIME_MATE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PRIME_MATE"
msgid "What it must be like to live unburdened by intelligence?"
msgstr "Интересно, каково это, быть необременённым интеллектом?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUFFIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUFFIN.GENERIC"
msgid "Oh, to be so carefree."
msgstr "О, быть таким беззаботным."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUFFIN.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUFFIN.HELD"
msgid "Life is not fair, is it?"
msgstr "Жизнь несправедлива, не так ли?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUFFIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUFFIN.SLEEPING"
msgid "It slumbers soundly."
msgstr "Беспробудно спит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN"
msgid "It's as big as the hole where my heart once was."
msgstr "Она такая же большая, как рана у меня в груди на месте сердца."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKINCARVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKINCARVER"
msgid "I love a pumpkin gutting contest."
msgstr "Конкурс потрошения тыкв? Такое мне по душе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKINCOOKIE"
msgid "Why indulge in such childish things?"
msgstr "Зачем баловать себя такими детскими вещами?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKINHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKINHAT.GENERIC"
msgid "I know that emptiness behind those eyes."
msgstr "Я узнаю эту пустоту в глазах."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKINHAT.UNCARVED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKINHAT.UNCARVED"
msgid "It lacks character."
msgstr "Ей не хватает характера."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKINPIE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKINPIE"
msgid "Is it sweet enough to help me forget the bitterness in my heart?"
msgstr "Достаточно ли он сладок, чтобы помочь мне забыть горечь в сердце?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN_COOKED"
msgid "It shriveled a tiny bit from the heat. I like that."
msgstr "С ней увяла ещё одна маленькая частичка моего сердца. Как хорошо."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN_LANTERN"
msgid "You're not so scary."
msgstr "Ты не такой уже и страшный."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN_OVERSIZED"
msgid "If only it could become a carriage and carry me far away from here."
msgstr "Если бы только она могла превратиться в карету и увезти меня подальше отсюда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN_SEEDS"
msgid "It's a seed. Exciting."
msgstr "Это семечко. Занятно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUNCHINGBAG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUNCHINGBAG"
msgid "Some are simply made to suffer."
msgstr "Некоторые рождены для страданий."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUREBRILLIANCE"
msgid "It hurts my eyes."
msgstr "От него глазам больно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PURPLEAMULET"
msgid "It's oozing."
msgstr "Он источает энергию."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PURPLEGEM"
msgid "Purple like a... purple thing."
msgstr "Фиолетовый как... всё фиолетовое."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PURPLEMOONEYE"
msgid "Maybe now I'll lose fewer friends..."
msgstr "Может, теперь я потеряю меньше друзей..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "We have prolonged our horrific demise."
msgstr "Мы продлили нашу ужасную кончину."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "The monster's hunger shall never cease."
msgstr "Голод монстра никогда не прекратится."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "A post. Not very exciting."
msgstr "Столб. Не очень интересно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "Like death, it creeps everywhere."
msgstr "Как смерть, она ползает повсюду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "I am not impressed by opulence."
msgstr "Я не впечатлена богатством."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "What horror have those eyes witnessed?"
msgstr "Свидетелем каких ужасов стали эти глаза?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "Yet another reminder of death."
msgstr "Ещё одно напоминание о смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "Don't worry. You'll be dead soon."
msgstr "Не волнуйся. Скоро ты умрёшь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "It shall never grow another berry."
msgstr "Этот куст никогда не вырастит другую ягоду."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "It is empty, like my heart."
msgstr "Он пуст, как и моё сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Жизнь, которую они содержат, является загадкой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "For making food."
msgstr "Для приготовления пищи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "For making a small amount of food."
msgstr "Для приготовления небольшого количества пищи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_COIN1"
msgid "I shall put them on my eyes when I die."
msgstr "Я положу их на глаза, когда умру."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_COIN2"
msgid "Money will not bring back Abigail."
msgstr "Деньги не вернут Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_COIN3"
msgid "Wealth cannot buy immortality."
msgstr "Богатство не позволяет купить бессмертие."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_COIN4"
msgid "It came from above."
msgstr "Она упала сверху."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "Its insides are as horrid as its outsides."
msgstr "Его внутренности столь же ужасны, как и его внешний вид."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "It's ready now."
msgstr "Теперь он готов."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "Life is a trap."
msgstr "Жизнь - это ловушка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FERN"
msgid "Wilson calls them \"greens\"... but they're purple..."
msgstr "Уилсон называет его «зеленью»... но они фиолетовый..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FLOUR"
msgid "Flour by any other name would smell as sweet."
msgstr "Мука совсем другая, в этом мире она пахнет сладостью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "Cooked purples."
msgstr "Приготовленные пурпуры."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "We should offer it to the beast."
msgstr "Мы должны предложить это зверю."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "The beast will be satisfied with this."
msgstr "Зверь будет удовлетворён этим."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "This will satisfy the beast, but not for long."
msgstr "Это удовлетворит зверя, но не надолго."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "The beast doesn't want that."
msgstr "Зверь этого не хочет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "A waste."
msgstr "Мусор."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GARLIC"
msgid "It gives food flavor."
msgstr "Он придаёт еде аромат."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "It smells a bit nice."
msgstr "От него слегка приятно пахнет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Жизнь, которую они содержат, является загадкой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GOATKID"
msgid "What childhood is this for you?"
msgstr "Чем для тебя является детство?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "But no honey."
msgstr "Не хватает мёда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "Hello, ma'am. Care to trade?"
msgstr "Здравствуйте, мадам. Хотите поторговать?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GRILL"
msgid "It can't make life more palatable."
msgstr "Это не сделает жизнь более аппетитной."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "I don't want to carry this around."
msgstr "Я не хочу таскать его с собой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "It makes a little bit of food."
msgstr "Он делает немного еды."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "It only works if I place it somewhere."
msgstr "Он будет работать, только если я его поставлю где-нибудь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_HOE"
msgid "To till the corrupt soil."
msgstr "Для возделывания испорченной почвы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_KEY"
msgid "It is the key to something precious."
msgstr "Это ключ от чего-то драгоценного."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "The key to a beautiful place, locked long away."
msgstr "Ключ от прекрасного места, запертого надолго."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "It sheds light on nothing important."
msgstr "Проливает свет на бесполезность."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "The only light in my life is Abigail."
msgstr "Единственный свет в моей жизни - это Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "I am ground down on the mealing stone of life."
msgstr "Я нахожусь на жёрнове жизни."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "Seclusion has not been kind to it."
msgstr "Уединение не было добро к нему."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "I, too, cart around my baggage."
msgstr "Я тоже перевозила свой багаж."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "Nothing in there could bring me happiness."
msgstr "Ничего здесь не может дать мне счастья."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "Maybe we'll get lucky and they'll be poisonous."
msgstr "Может быть, нам повезёт, и они будут ядовитыми."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "They thrive on a stump made by death."
msgstr "Они процветают на пне, поглощённом смертью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "All things die. Even fungus."
msgstr "Всё умирает. Даже грибок."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ONION"
msgid "I never cry."
msgstr "Я никогда не плачу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "It will never make anyone cry again."
msgstr "Теперь он никого не заставит плакать снова."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Жизнь, которую они содержат, является загадкой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_OVEN"
msgid "It looks okay."
msgstr "Он выглядит хорошо."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "Sigh... Why bother?"
msgstr "Эх... Зачем беспокоиться?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "Looks dangerous."
msgstr "Выглядит опасно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "It's winged, but it's no angel."
msgstr "Оно крылатое, но это не ангел."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "Abigail needs a statue."
msgstr "Абигейл нуждается в статуе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "Long dry."
msgstr "Давно сухой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "Now I may enter the park."
msgstr "Теперь я могу войти в парк."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "I need a key to enter."
msgstr "Мне нужен ключ для входа."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "A monument. But not to Abigail."
msgstr "Памятник. Но не Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "Dust to dust."
msgstr "Прах к праху."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "Had I such a shell, I would never emerge."
msgstr "Если бы у меня был такой панцирь, я бы никогда не появлялась."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "Cold and dead."
msgstr "Холодный и мёртвый."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "Would you like to be a pie, little bird?"
msgstr "Хочешь стать пирогом, маленькая птица?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "It's practicing for the big sleep."
msgstr "Он тренируется к большему сну."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "If only life had been handed to me on a silver plate."
msgstr "Вот бы моя жизнь была вручена на серебряной тарелке."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "Water, water, everywhere..."
msgstr "Вода, вода, везде..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PORTAL"
msgid "There's no night here. It is a nice change."
msgstr "Здесь нет ночи. Это приятное изменение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "Perhaps I'll be happier in the next world."
msgstr "Возможно, в следующем мире я буду счастливее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT"
msgid "We cook to stave off death."
msgstr "Мы готовим, чтобы предотвратить смерть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POTATO"
msgid "It has eyes, yet it never cries."
msgstr "У него есть глазки, но он никогда не плачет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "Now its eyes will never open."
msgstr "Теперь его глаза никогда не откроются."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Жизнь, которую они содержат, является загадкой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "The hanger is a noose for a pot."
msgstr "Подвес - это петля для горшка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "It's for hanging the pot over the fire."
msgstr "Это для подвешивания горшка над огнём."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "We will cook, or we will die."
msgstr "Мы должны готовить, иначе мы умрём."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "Sweetness begets sweetness."
msgstr "Сладость порождает сладость."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "Time came for it."
msgstr "Пришло время."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "Nothing escaped this plague."
msgstr "Ничто не ускользнуло от этой чумы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "It's been forgotten."
msgstr "Она была забыта."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "Nothing more to pray for."
msgstr "Больше незачем молиться."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "This was once a happy home."
msgstr "Когда-то это был счастливый дом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Its hearth no longer has a home."
msgstr "Этот очаг больше не домашний."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "Time is an illusion."
msgstr "Время - иллюзия."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "Time is death's ally."
msgstr "Время - союзник смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "Death has been here."
msgstr "Смерть была здесь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "It's a ghost town."
msgstr "Это город-призрак."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "Some tragedy has struck this house."
msgstr "Некая трагедия поразила этот дом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "A door that leads nowhere."
msgstr "Дверь, которая никуда не ведёт."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "The roof cannot protect you when death comes."
msgstr "Крыша не сможет защитить вас, когда придёт смерть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "Let's have a peek inside..."
msgstr "Давайте заглянем внутрь..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "Locked, like my heart."
msgstr "Заперт, как и моё сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALMON"
msgid "It flops as its life slowly leaves its body."
msgstr "Он бьётся, когда жизнь медленно покидает его тело."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "Not so lively now."
msgstr "Теперь не такой живой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALT"
msgid "It adds flavor..."
msgstr "Это добавит вкуса..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "It needs to be ground down before we can use it."
msgstr "Его необходимо измельчить перед использованием."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "There is no salt, yet."
msgstr "Пока недостаточно солёно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "There is salt to be had."
msgstr "Теперь достаточно солёно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "It's for collecting salt from the pond."
msgstr "Это для сбора соли из пруда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAP"
msgid "Tree blood."
msgstr "Древесная кровь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "For collecting tree blood."
msgstr "Для сбора древесной крови."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAPLING"
msgid "We will perish before this grows back."
msgstr "Мы погибнем быстрее чем оно вырастет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "As bittersweet as life."
msgstr "Горький, как жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "Planting seeds requires an optimism I don't possess."
msgstr "Посадка семян требует оптимизма, которого у меня нет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "Is all of life not a slaughter?"
msgstr "Не вся ли жизнь это битва?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "Just a dash."
msgstr "Просто смесь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "I suppose it could be edible."
msgstr "Полагаю, это может быть съедобно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "We've taken all there was to take."
msgstr "Мы взяли всё, что нужно было взять."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "We ripped it from its home on the shrub."
msgstr "Мы вырвали её из дома около кустарника."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "It has a sickly beauty."
msgstr "Это болезненная красота."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "All things must end."
msgstr "Всё должно закончиться."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "All that sacrifice for nothing."
msgstr "Все жертвы напрасно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "Like a dagger through the heart. A tree heart."
msgstr "Как кинжал в сердце. Сердце дерева."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "I can harvest it now."
msgstr "Теперь я могу собрать это."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "Its life ebbs."
msgstr "Его жизнь уходит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "They're less standoffish than their brethren."
msgstr "Они менее стойкие, чем их братья."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "How do you do, sir?"
msgstr "Как поживаете, сэр?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "He is practicing for the big sleep."
msgstr "Он тренируется к большему сну."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "I see no joy in this house."
msgstr "Я не вижу радости в этом доме."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "Neither a house nor a home."
msgstr "Не дом, не жилище."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Not as sweet as Abigail."
msgstr "Не такой сладкий, как Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TOMATO"
msgid "Red as heart's blood."
msgstr "Красный, как кровь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "Its flesh is far more bloody now."
msgstr "Теперь его плоть намного кровавее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Жизнь, которую они содержат, является загадкой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "How do you do?"
msgstr "Как дела?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "How do you do?"
msgstr "Как дела?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TURNIP"
msgid "It's... a turnip."
msgstr "Это... репа."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "The turnip is now cooked."
msgstr "Репа теперь приготовлена."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Жизнь, которую они содержат, является загадкой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_WHEAT"
msgid "We can grind it down into flour."
msgstr "Мы можем измельчить его в муку."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Жизнь, которую они содержат, является загадкой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBIT.GENERIC"
msgid "He's wandering mindlessly, oblivious to his fate."
msgstr "Проводит праздно жизнь, безучастный своей судьбе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBIT.HELD"
msgid "He is safely in my embrace."
msgstr "Теперь он в моих объятиях."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHAT"
msgid "Fine. It's adorable."
msgstr "Ладно. Он милый."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHOLE.GENERIC"
msgid "I'm too big to fall down there."
msgstr "Я слишком большая чтобы упасть прямо туда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHOLE.SPRING"
msgid "It's closed up. No one is falling down there, now."
msgstr "Она завалена. Теперь никто не упадёт туда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHOUSE.BURNT"
msgid "It didn't cook well."
msgstr "Недоготовилась."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "It is not as edible as it looks."
msgstr "Она не такая съедобная, как на первый взгляд."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKINGHORN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKINGHORN"
msgid "I guess it plays a type of burial song."
msgstr "Думаю, это что-то вроде похоронной песни."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKINGHORN_CHEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKINGHORN_CHEST"
msgid "It's like a grave for my things."
msgstr "Словно могила для моих вещей."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKINGMINION_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKINGMINION_BUNNYMAN"
msgid "You're making me angry."
msgstr "Ты начинаешь меня злить."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKINGSPEAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKINGSPEAR"
msgid "Death by rabbit antler. Cute."
msgstr "Смерть от кроличьего рога. Мило."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKING_AGGRESSIVE"
msgid "It's in a foul mood."
msgstr "Он в отвратительном настроении."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKING_LUCKY"
msgid "I should take a closer look."
msgstr "Нужно взглянуть на него поближе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKING_PASSIVE"
msgid "He seems friendly enough."
msgstr "Он выглядит довольно дружелюбно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RAINCOAT"
msgid "I liked jumping in puddles with Abigail."
msgstr "Я любила прыгать по лужам вместе с Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RAINHAT"
msgid "What fun is rain if you're not getting wet?"
msgstr "Какая радость от дождя, если нельзя промокнуть?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RAINOMETER.BURNT"
msgid "Does that mean sunshine is dead, too?"
msgstr "Значит ли это, что солнце тоже мертво?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RAINOMETER.GENERIC"
msgid "It measures cloudiness. I like when it's dreary."
msgstr "Он измеряет облачность. Я люблю, когда пасмурно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RATATOUILLE"
msgid "A whole bunch of cooked vegetables. Riveting."
msgstr "Как много варёных овощей. Занимательно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RAZOR"
msgid "This is just for shaving."
msgstr "Это только для бритья."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD"
msgid "I wondered if I'd ever hear that song again."
msgstr "А я думала, услышу ли я снова эту песню."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_BALATRO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_BALATRO"
msgid "It brightens my mood, if only for a while."
msgstr "Она поднимает мне настроение, хоть и ненадолго."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_CREEPYFOREST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_CREEPYFOREST"
msgid "Does this music lift your spirits, Abigail?"
msgstr "Музыка поднимает тебе дух, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_DANGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_DANGER"
msgid "Does this music lift your spirits, Abigail?"
msgstr "Музыка поднимает тебе дух, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_DAWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_DAWN"
msgid "Does this music lift your spirits, Abigail?"
msgstr "Музыка поднимает тебе дух, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_DRSTYLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_DRSTYLE"
msgid "Does this music lift your spirits, Abigail?"
msgstr "Музыка поднимает тебе дух, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_DUSK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_DUSK"
msgid "I wonder if father still listens to his record collection."
msgstr "Интересно, слушает ли папа всё ещё свою коллекцию пластинок."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_EFS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_EFS"
msgid "A song of sweet foreboding."
msgstr "Музыка сладкого предзнаменования."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_END
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_END"
msgid "I wonder if father still listens to his record collection."
msgstr "Интересно, слушает ли папа всё ещё свою коллекцию пластинок."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_HALLOWEDNIGHTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_HALLOWEDNIGHTS"
msgid "Love it."
msgstr "Мне нравится."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_MAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_MAIN"
msgid "I wonder if father still listens to his record collection."
msgstr "Интересно, слушает ли папа всё ещё свою коллекцию пластинок."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_WORKTOBEDONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_WORKTOBEDONE"
msgid "I wonder if father still listens to his record collection."
msgstr "Интересно, слушает ли папа всё ещё свою коллекцию пластинок."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REDGEM"
msgid "Red like my heart's blood."
msgstr "Красный, как кровь от моего сердца."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REDLANTERN"
msgid "A light to guide me."
msgstr "Свет, ведущий меня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REDMOONEYE"
msgid "Now Wolfgang won't get \"lost\" when I invite him to play."
msgstr "Теперь Вольфганг не «потеряется», когда я позову его играть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REDPOUCH"
msgid "What lies within?"
msgstr "Что лежит внутри?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_CAP"
msgid "A mushroom after my own heart."
msgstr "Гриб, вслед за моим сердцем."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_CAP_COOKED"
msgid "All is malleable."
msgstr "Всему приходит конец."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "Damp."
msgstr "Влажный."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "I would hide too, if I could."
msgstr "Я бы тоже спряталась, если бы могла."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "Harvested."
msgstr "Он уже собран."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REEDS.BURNING"
msgid "Soon to be ashes."
msgstr "Всё обратится в пепел."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REEDS.GENERIC"
msgid "It's just a bunch of reeds."
msgstr "Это всего лишь камыш."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REEDS.PICKED"
msgid "They have already been torn away."
msgstr "Я только что взяла его."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REFINED_DUST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REFINED_DUST"
msgid "Dust to... somewhat denser dust."
msgstr "Пыль стала... более плотной пылью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REFLECTIVEVEST"
msgid "Everything's a vest."
msgstr "Что наша жизнь? Жилет..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RELIC"
msgid "A leftover of an ancient world."
msgstr "Остатки древнего мира."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB.BURNT"
msgid "It is unspeakably burnt."
msgstr "Не передать словами, как она сгорела."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "I will learn unspeakable things."
msgstr "Я узнаю вещи, невыразимые словами."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "It is unspeakably burnt."
msgstr "Не передать словами, как она сгорела."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "I will learn unspeakable things."
msgstr "Я узнаю вещи, невыразимые словами."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "It is unspeakably burnt."
msgstr "Не передать словами, как она сгорела."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "I have learnt unspeakable things."
msgstr "Я познала вещи, невыразимые словами."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "Madness brings fire."
msgstr "Безумие приносит огонь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "This is but a step from madness."
msgstr "От этого всего шаг до безумия."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESKIN_TOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESKIN_TOOL"
msgid "Change is... not always terrible."
msgstr "Изменения... не всегда ужасны."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "I'm glad that fail-safe is gone."
msgstr "Я рада, что это меня больше не спасёт."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "It's just putting off the inevitable."
msgstr "Просто откладывает неизбежное."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESURRECTIONSTONE"
msgid "A futile ward."
msgstr "Напрасная трата времени."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REVIVER"
msgid "Choices matter."
msgstr "Вопрос выбора."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RHINODRILL"
msgid "Brotherly camaraderie will not save you."
msgstr "Братское товарищество не спасёт вас."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROASTTURKEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROASTTURKEY"
msgid "The holiday was cut short for this poor bird."
msgstr "Праздник для этой птички окончился быстро."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBIN.GENERIC"
msgid "Does that mean spring is coming? I hope not."
msgstr "Что, разве весна наступает? Надеюсь нет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBIN.HELD"
msgid "He likes being trapped in my pocket."
msgstr "Ей нравится быть пойманной."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "Life in the barren, frozen wastes."
msgstr "Жизнь в бесплодных промёрзших пустошах."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBIN_WINTER.HELD"
msgid "It's so soft. It is my enemy."
msgstr "Он такой нежный. Полная противоположность мне."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBOT_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBOT_BLUEPRINT"
msgid "Oh to be encased within a hard and unfeeling exterior..."
msgstr "О, быть заключённым в твёрдую и бесчувственную оболочку..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBOT_PUPPET"
msgid "I wonder what they did."
msgstr "Гадаю, что он натворил."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK"
msgid "Even that is not permanent."
msgstr "Даже он не вечен."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCKS"
msgid "Some small rocks."
msgstr "Несколько камешков."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCKY"
msgid "What terrible sights they have seen."
msgstr "Какие ужасы им довелось повидать..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN"
msgid "It will never again bear fruit."
msgstr "Он никогда больше не принесёт плодов."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING"
msgid "Oh. It's burning."
msgstr "О. Оно горит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
msgid "It is corrupt. Tainted."
msgstr "Он повреждён. Испорчен."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING"
msgid "Vileness spreads within it."
msgstr "В нём растёт болезнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
msgid "It's born fruit."
msgstr "Это готовый плод."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED"
msgid "It has nothing to offer me."
msgstr "Ему нечего мне предложить."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED"
msgid "I feel much the same."
msgstr "Я чувствую себя так же."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_FRUIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_FRUIT"
msgid "It grew on a tree, but it looks like a rock."
msgstr "Он вырос на дереве, но выглядит как камень."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
msgid "I can eat it now."
msgstr "Теперь я могу его съесть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED"
msgid "It might actually taste good at this point."
msgstr "Теперь он может вполне быть вкусным."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT"
msgid "Why do you persevere?"
msgstr "Почему ты продолжаешь стараться?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_ICE.GENERIC"
msgid "A large piece of cold, unfeeling ice."
msgstr "Огромный кусок холодного, бесчувственного льда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_ICE.MELTED"
msgid "A large pool of cool, melted ice."
msgstr "Огромный кусок прохладного, тающего льда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_ICE_MELTED"
msgid "A large pool of cool, melted ice."
msgstr "Огромный кусок прохладного, тающего льда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "There's a fire in the pit's belly."
msgstr "Лава, покрытая коркой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_LIGHT.LOW"
msgid "The shadows encroach."
msgstr "Тени подбираются ближе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "The lava's on fire."
msgstr "Лава объята пламенем."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_LIGHT.OUT"
msgid "The lava lost its will to burn..."
msgstr "Выглядит безопасно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_MOON"
msgid "It's traveled so far..."
msgstr "Он путешествовал так долго..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "Now it will never die..."
msgstr "Теперь оно никогда не умрёт..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "Now it will never die..."
msgstr "Теперь оно никогда не умрёт..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROOK"
msgid "A Rook? Or is it a Castle?"
msgstr "Ладья? Или правильнее будет сказать Тура?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROOK_NIGHTMARE"
msgid "Time erodes everything."
msgstr "Время разрушает всё."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROPE"
msgid "That would be the easy way out of this place."
msgstr "Это был бы самый лёгкий способ покинуть это место."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROPE_BRIDGE_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROPE_BRIDGE_KIT"
msgid "A rope over an abyss."
msgstr "Над пропастью по мосту."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROSEGLASSESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROSEGLASSESHAT.GENERIC"
msgid "I hope you find her."
msgstr "Я надеюсь, ты найдёшь её."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROTTENEGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROTTENEGG.GENERIC"
msgid "The way of all things."
msgstr "Этим всегда всё и заканчивается."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROYAL_JELLY"
msgid "We stole it out of the mouths of baby bees."
msgstr "Мы украли его из ртов маленьких пчёл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RUBBLE"
msgid "Broken bits of stone."
msgstr "Каменные обломки."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RUINSHAT"
msgid "Abigail would've loved this crown."
msgstr "Абигейл понравилась бы эта корона."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RUINS_BAT"
msgid "It possesses the power of the ancients."
msgstr "Я держу в руках мощь древних."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RUINS_RUBBLE"
msgid "A pile of broken dreams."
msgstr "Разбитые мечты, сваленные в кучу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "It is touched by death."
msgstr "Он тронут смертью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "It judges my very being."
msgstr "Он показывает моё существо."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLEHORN"
msgid "I'm only taking back what's mine."
msgstr "Беру лишь то, что мне принадлежит по праву."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_BASIC"
msgid "As if it wasn't already burdened by the yoke of life..."
msgstr "Как будто он и до этого не был обременён жизнью..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_RACE"
msgid "Too much whimsy gives me indigestion."
msgstr "Меня укачивает от длительных поездок."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_SHADOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_SHADOW"
msgid "The higher you sit, the farther you fall."
msgstr "Чем выше сидишь, тем больнее падать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_WAR"
msgid "Oh, how we bend creatures to our ill intent."
msgstr "О, как же сильно мы способны унижать существ,\n чтоб явью стали наши вожделения."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_WATHGRITHR"
msgid "It has wings, but will never fly."
msgstr "У него есть крылья, но летать ему не суждено."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALSA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALSA"
msgid "I don't feel much like dancing."
msgstr "Мне не очень хочется танцевать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTBOX
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTBOX"
msgid "It'll only prolong the inevitable."
msgstr "Он лишь отложит неизбежное."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTLICK"
msgid "The beasts crave it..."
msgstr "Звери его обожают..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTLICK_IMPROVED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTLICK_IMPROVED"
msgid "Salty like tears."
msgstr "Соленый, как слёзы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTROCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTROCK"
msgid "Almost as salty as my bitter tears."
msgstr "Почти настолько же солёные, как и мои слёзы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTSTACK.GENERIC"
msgid "Those figures can't be natural."
msgstr "Эти формы не могут быть естественными."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTSTACK.GROWING"
msgid "The cycle begins anew."
msgstr "Цикл начинается заново."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTSTACK.MINED_OUT"
msgid "It's been utterly destroyed."
msgstr "Оно было полностью разрушено."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTY_DOG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTY_DOG"
msgid "You are no hound... but I'll overlook it."
msgstr "Ты не пёс... но я закрою на это глаза."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTY_DOGHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTY_DOGHAT"
msgid "It is my turn to play the captain."
msgstr "Моя очередь играть в капитана."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SANDBLOCK"
msgid "Mockery of a spoiled childhood."
msgstr "Издевательство над испорченным детством."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SANDSPIKE"
msgid "Aim for my heart..."
msgstr "Цель для моего сердца..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SANITYROCK.ACTIVE"
msgid "It's calling to me."
msgstr "Он зовёт меня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SANITYROCK.INACTIVE"
msgid "Even this obelisk has left me."
msgstr "Даже этот обелиск покинул меня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.BURNING"
msgid "Consigned to the flames."
msgstr "Предан языкам пламени."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.DISEASED"
msgid "It's not long for this world..."
msgstr "Не долго просуществовало для этого мира..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.DISEASING"
msgid "It is on the precipice..."
msgstr "Он находится на грани..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.GENERIC"
msgid "It's trying to grow up."
msgstr "Он пытается вырасти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.PICKED"
msgid "Maybe next time, sapling."
msgstr "Возможно в следующий раз, деревце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.WITHERED"
msgid "The oppressive heat got to this one."
msgstr "Всеподавляющая жара добралась и до него."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCANDATA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCANDATA"
msgid "If I'm lucky, it might just bore me to death."
msgstr "Если повезёт, то я просто умру со скуки."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCARECROW.BURNING"
msgid "Antagonizing crows is always bad luck."
msgstr "Гонять ворон - к несчастью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCARECROW.BURNT"
msgid "Now the crows will be at peace."
msgstr "Теперь вороны будут жить мирно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCARECROW.GENERIC"
msgid "Who would want to scare crows away?"
msgstr "Зачем вообще отпугивать ворон?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCORCHED_SKELETON"
msgid "The flame has cleansed this poor wretched soul."
msgstr "Пламя очистило эту бедную несчастную душу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCRAPBOOK_PAGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCRAPBOOK_PAGE"
msgid "A lost and lonely page."
msgstr "Потерянная и одинокая страница."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCRAPHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCRAPHAT"
msgid "My head will be safe. My dignity, however..."
msgstr "Моя голова будет в безопасности. Жаль, не моя честь..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCRAP_MONOCLEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCRAP_MONOCLEHAT"
msgid "I won't find what I'm looking for, no matter how far I can see."
msgstr "Я не найду того, что ищу, как бы далеко я ни видела."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "Abigail... You be Death, I'll be the Sculptor..."
msgstr "Абигейл... Если ты смерть, то я скульптор..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "...I can't be disappointed... If I expect nothing..."
msgstr "...Я не могу разочароваться... если я ничего не жду..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "That looks... f-fun..."
msgstr "Выглядит... в-весело..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "Cleft from the stone."
msgstr "Расколотый камень."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "A beautiful corruption gnaws at its base..."
msgstr "Она прекрасно распалась до основания..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "Not everyone can be put back together after falling apart."
msgstr "Не все могут восстановиться после разрушения."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "It wants out..."
msgstr "Он хочет выйти..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "The more the marble wastes, the more the statue grows."
msgstr "Чем больше мраморных обломков, тем больше выйдет статуя."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "How did this get here?"
msgstr "Как она здесь оказалась?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "There's a sickly beauty to it..."
msgstr "Есть в нём нездоровая красота..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "If only the rest of us could be whole again."
msgstr "Если бы моя другая часть могла со мной воссоединиться..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "It wants out..."
msgstr "Он хочет выйти..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "We all have monsters within, I suppose."
msgstr "У каждого свои скелеты в шкафу."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "Off with his head! Heehee."
msgstr "Голову с плеч! Хи-хи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "I feel... queasy..."
msgstr "Меня... тошнит..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "It's been made whole again. Lucky."
msgstr "Он снова цел. Везунчик."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "It wants out..."
msgstr "Он хочет выйти..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "Perhaps it wanted to hide the shame of its monstrous form?"
msgstr "Может, она хотела скрыть свою чудовищную сущность?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "Strange marble debris..."
msgstr "Странные мраморные обломки..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "Another entry in a long line of unfortunate occurrences."
msgstr "Ещё одна запись в длинной очереди несчастных происшествий."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "Thinking on the waves makes me nauseous."
msgstr "У меня тошнота от мыслей о волнах."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEAFOODGUMBO"
msgid "A sea once teeming with life. No more."
msgstr "Когда-то море было полно жизни. Теперь нет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEASTACK"
msgid "I could steer toward it and resign myself to a watery fate."
msgstr "Я могла бы устремиться ему на встречу и смириться со своей водянистой судьбой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SECURITY_PULSE_CAGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SECURITY_PULSE_CAGE"
msgid "I feel the same way."
msgstr "Чувствую себя также."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SECURITY_PULSE_CAGE_FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SECURITY_PULSE_CAGE_FULL"
msgid "It must be nice."
msgstr "Должно быть, приятно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEEDPOUCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEEDPOUCH"
msgid "Another burden for me to shoulder."
msgstr "Ещё одно бремя для меня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEEDS"
msgid "Life, or at least the promise of it."
msgstr "Жизнь, или, по крайней мере, надежда на неё."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEEDS_COOKED"
msgid "The fire has toasted their life away."
msgstr "Я высушила из них всю жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SENTRYWARD"
msgid "Grant us the power of sight..."
msgstr "Даруй нам силу взгляда ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEWING_KIT"
msgid "Another implement for staving off the inevitable decay."
msgstr "Ещё один инструмент, чтобы отсрочить неизбежное старение."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEWING_MANNEQUIN.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEWING_MANNEQUIN.BURNT"
msgid "This burnt husk is all that remains."
msgstr "Выгоревшая оболочка - всё, что осталось."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEWING_MANNEQUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEWING_MANNEQUIN.GENERIC"
msgid "A mockery of life."
msgstr "Насмешка над жизнью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEWING_TAPE"
msgid "It doesn't mend the hole... merely masks it."
msgstr "Это не отверстие, просто оно так замаскировано."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWDANCER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWDANCER"
msgid "Father used to do silly dances like that."
msgstr "Отец обычно устраивал такие глупые танцы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWDIGGER"
msgid "Was he your brother?"
msgstr "Он был твоим братом?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWHEART"
msgid "It beats with a sorrow to span the skies and plumb the darkest seas."
msgstr "В его биении слышна печаль, охватывающая весь небосвод и погружающаяся в самые тёмные моря."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWRIFT_PORTAL"
msgid "Endless, swirling nothingness... how serene."
msgstr "Бесконечное, кружащееся ничто... как безмятежно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY"
msgid "Such power."
msgstr "Какая сила."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED"
msgid "For me, the world feels upside down."
msgstr "Для меня мир всегда перевёрнут."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD"
msgid "Are the two heads aware of each other?"
msgstr "Знают ли эти головы друг о друге?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_HANDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_HANDS"
msgid "Another nightmare to torment me."
msgstr "Ещё один кошмар, который будет мучить меня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_HORNS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_HORNS"
msgid "Will the darkness consume me at last?"
msgstr "Поглотит ли меня наконец тьма?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_MOUTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_MOUTH"
msgid "What are you? The Grin Reaper?"
msgstr "Кто ты? Смерть, с улыбкой на лице?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_PARASITE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_PARASITE"
msgid "Parasite."
msgstr "Паразит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_WINGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_WINGS"
msgid "There is no face beneath that hood."
msgstr "Под этим капюшоном нет лица."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_BATTLEAXE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_BATTLEAXE"
msgid "A beautiful death bringer."
msgstr "Прекраснейший посол смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_BEEF_BELL"
msgid "A shame it only works for beefalo."
msgstr "Жаль, что работает только на бифало."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_FORGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_FORGE"
msgid "What terrible things will I create?"
msgstr "Какие ужасные вещи я сотворю?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_FORGE_KIT"
msgid "I suppose if I tried I could piece it together."
msgstr "Если попытаться, то можно собрать всё воедино."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_HEART_VEIN"
msgid "From a heart that knows no peace."
msgstr "От сердца, что не знает покоя."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHALLOW_GRAVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHALLOW_GRAVE"
msgid "What difference does it make?"
msgstr "Какая разница?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHARK"
msgid "Are you here to send me to a watery grave?"
msgstr "Ты пришла, чтобы утащить меня в могилу на дне моря?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHARKBOI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHARKBOI"
msgid "It has a bite no colder than reality."
msgstr "Его укус никогда не будет холоднее укуса реальности."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHELLWEAVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHELLWEAVER"
msgid "What should I make, Abigail?"
msgstr "Что же мне сделать, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHELL_CLUSTER"
msgid "They're all clumped together... it seems a shame to separate them..."
msgstr "Они все слиплись вместе... разлучать их было бы жалостью..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHIELDOFTERROR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHIELDOFTERROR"
msgid "Nothing can truly shield you from the horrors of this cruel world."
msgstr "Ничто не может по-настоящему защитить вас от ужасов этого жестокого мира."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHOVEL"
msgid "What terrible secrets might be uncovered with this?"
msgstr "До каких ужасных секретов мне удастся докопаться?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHOVEL_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHOVEL_LUNARPLANT"
msgid "Some things should stay buried... but not today."
msgstr "Некоторым вещам стоит остаться похороненными... но не сегодня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHROOMBAIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHROOMBAIT"
msgid "Will it give me a dreamless sleep?"
msgstr "Даст ли это мне сон без сновидений?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHROOMCAKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHROOMCAKE"
msgid "Will it make me grow? Or shrink perhaps? Mushrooms are funny things."
msgstr "Он меня увеличит? Или уменьшит? Забавные эти грибы."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHROOM_SKIN"
msgid "A reminder of the death we wrought."
msgstr "Напоминание о смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SIESTAHUT.BURNT"
msgid "A preview of the fires of Hell."
msgstr "Предварительное представление адского пламени."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SIESTAHUT.GENERIC"
msgid "A siesta is but a preview of death."
msgstr "Сиеста - всего лишь способ предвкусить смерть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SILK"
msgid "So slippery and fine."
msgstr "Такая скользкая и тонкая."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC"
msgid "I wish I had a song left in my heart to sing."
msgstr "Жаль, что в моём сердце не осталось песни, которую я могла бы спеть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC"
msgid "They are rather pretty..."
msgstr "Они довольно хорошенькие..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC"
msgid "Abigail, do you remember collecting shells on the beach?"
msgstr "Абигейл, ты помнишь как мы собирали ракушки на пляже?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.GENERIC"
msgid "It's a memorial to my sister... but it's so bare..."
msgstr "Это памятник моей сестре... но он такой пустой..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.LOTS_OF_FLOWERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.LOTS_OF_FLOWERS"
msgid "I won't let you fade away, Abigail. Never."
msgstr "Я не позволю тебе завять, Абигейл. Никогда."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM"
msgid "I can almost hear your voice, Abby."
msgstr "Я почти слышу твой голос, сестрёнка."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL"
msgid "These don't make me feel good, but they help Abigail."
msgstr "Мне от них не лучше, но они помогают Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.SOME_FLOWERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.SOME_FLOWERS"
msgid "Abigail always loved flowers..."
msgstr "Абигейл всегда любила цветы..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON"
msgid "I envy your escape."
msgstr "Завидую ему. Он нашёл спасение в смерти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETONHAT"
msgid "A tortured mind dwelled within."
msgstr "Внутри обитал измученный ум."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_NOTPLAYER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_NOTPLAYER"
msgid "All living things share the same fate. Thankfully."
msgstr "Все живые существа разделяют одну и ту же судьбу. К счастью."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_PLAYER.DEFAULT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_PLAYER.DEFAULT"
msgid "I envy you, %s. Maybe I should play with %s?"
msgstr "Я тебе завидую, %s. Может я поиграю с %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_PLAYER.FEMALE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_PLAYER.FEMALE"
msgid "I envy you, %s. Maybe I should play with %s?"
msgstr "Я тебе завидую, %s. Может я поиграю с %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_PLAYER.MALE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_PLAYER.MALE"
msgid "I envy you, %s. Maybe I should play with %s?"
msgstr "Я тебе завидую, %s. Может я поиграю с %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_PLAYER.ROBOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_PLAYER.ROBOT"
msgid "I envy you, %s. Maybe I should play with %s?"
msgstr "Я тебе завидую, %s. Может я поиграю с %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKETCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKETCH"
msgid "I think we could make what's drawn here..."
msgstr "Я думаю, мы можем сделать то, что сказано."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKULLCHEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKULLCHEST"
msgid "It shall contain my memento mori."
msgstr "Тут должно быть моё memento mori."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLEEPBOMB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLEEPBOMB"
msgid "Sickly spores bring such sweet slumber."
msgstr "Больные споры приносят такой сладкий сон."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOT.GENERIC"
msgid "Abigail used to play with one of these."
msgstr "Абигейл нравилось играть с такими."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_CONTAINER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_CONTAINER"
msgid "Grief takes up no space, yet weighs far more."
msgstr "Горе не занимает много места, но весит гораздо больше."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_DREADSTONE"
msgid "Someone could trip and break their neck. Maybe it will be me."
msgstr "Кто-то может споткнуться и сломать свою шею об них. Наверное, этим я сейчас и займусь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_FREEZE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_FREEZE"
msgid "Someone could trip and break their neck. Maybe it will be me."
msgstr "Кто-то может споткнуться и сломать свою шею об них. Наверное, этим я сейчас и займусь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_GELBLOB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_GELBLOB"
msgid "Someone could trip and break their neck. Maybe it will be me."
msgstr "Кто-то может споткнуться и сломать свою шею об них. Наверное, этим я сейчас и займусь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_GOLD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_GOLD"
msgid "Someone could trip and break their neck. Maybe it will be me."
msgstr "Кто-то может споткнуться и сломать свою шею об них. Наверное, этим я сейчас и займусь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_GUNPOWDER"
msgid "Someone could trip and break their neck. Maybe it will be me."
msgstr "Кто-то может споткнуться и сломать свою шею об них. Наверное, этим я сейчас и займусь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_HONEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_HONEY"
msgid "Someone could trip and break their neck. Maybe it will be me."
msgstr "Кто-то может споткнуться и сломать свою шею об них. Наверное, этим я сейчас и займусь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_HORRORFUEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_HORRORFUEL"
msgid "Someone could trip and break their neck. Maybe it will be me."
msgstr "Кто-то может споткнуться и сломать свою шею об них. Наверное, этим я сейчас и займусь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_LUNARPLANTHUSK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_LUNARPLANTHUSK"
msgid "Someone could trip and break their neck. Maybe it will be me."
msgstr "Кто-то может споткнуться и сломать свою шею об них. Наверное, этим я сейчас и займусь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_MARBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_MARBLE"
msgid "Someone could trip and break their neck. Maybe it will be me."
msgstr "Кто-то может споткнуться и сломать свою шею об них. Наверное, этим я сейчас и займусь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_MOONGLASS"
msgid "Someone could trip and break their neck. Pretty though."
msgstr "Кто-то может поскользнуться на них и сломать шею. Хотя они красивые."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_POOP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_POOP"
msgid "I suppose it has its uses."
msgstr "Полагаю, у него свои преимущества."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_PUREBRILLIANCE"
msgid "Someone could trip and break their neck. Maybe it will be me."
msgstr "Кто-то может споткнуться и сломать свою шею об них. Наверное, этим я сейчас и займусь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_ROCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_ROCK"
