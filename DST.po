msgstr "Фу, она мертва."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATED_PENGUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATED_PENGUIN.GENERIC"
