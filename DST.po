msgstr "М-м, свежая рыба."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALMON_COOKED"
