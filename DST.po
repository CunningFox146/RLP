msgstr "Здесь нет никого."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "Something destroyed this town."
msgstr "Что-то разрушило этот город."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
