msgstr "На данный момент он спит."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_PLATE_SILVER"
