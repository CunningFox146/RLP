msgstr "Мерзко!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GENERIC_CORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GENERIC_CORPSE.REVIVING"
