msgid "A cozy abode fashioned after the adorable carrat."
msgstr "Уютная обитель, построенная в виде очаровательной морквокрысы."

#. STRINGS.SKIN_DESCRIPTIONS.rabbithouse_hallowed
msgctxt "STRINGS.SKIN_DESCRIPTIONS.rabbithouse_hallowed"
