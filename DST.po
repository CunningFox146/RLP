msgstr "Такой громкий шёпот. Голова болит."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_CROWN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_CROWN"
