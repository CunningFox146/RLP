msgstr "Луна очень велика!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_NEW"
