msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SKELETON_PLAYER.ROBOT"
msgid "%s's soul is long gone thanks to %s."
msgstr "%s давно лишился души благодаря %s."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SKETCH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SKETCH"
msgid "Would you look at that!"
msgstr "Ты только взгляни что там!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SKULLCHEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SKULLCHEST"
msgid "Let me take a peek inside!"
msgstr "Позволь мне заглянуть внутрь!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLEEPBOMB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLEEPBOMB"
msgid "I'll throw it, then you'll catch some ZZZs!"
msgstr "Если я брошу это штуку, вы сразу же уснёте!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLINGSHOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLINGSHOT.GENERIC"
