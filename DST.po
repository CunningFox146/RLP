msgstr "Для экспертной работы."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "I cannot open it."
msgstr "Не могу открыть."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALMON"
msgid "Foul smelling, but delicious."
msgstr "Пахнет ужасно, но как вкусно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "I do enjoy a good smoked salmon."
msgstr "Люблю хорошо прокопчённого лосося."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT"
msgid "Adding too much is an a-salt on the senses."
msgstr "Пересолить, как и оскорбить - непростительно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "It must be ground down before we use it."
msgstr "Нужно раскрошить перед использованием."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "Any method to improve the food around here is welcome."
msgstr "Здесь любой способ улучшить качество еды приветствуется."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "Ah. It's ready."
msgstr "Готово."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "Just useless sticks until we assemble it."
msgstr "Бесполезные палочки, пока не соберёшь их."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAP"
msgid "I would rather not get that on my gloves."
msgstr "Я бы предпочёл не пачкать в этом свои перчатки."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "It's already sticky."
msgstr "Оно уже липкое."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAPLING"
msgid "I don't have time to watch twigs grow."
msgstr "У меня нет времени смотреть на рост веточек."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "Bittersweet."
msgstr "Горьковато-сладкий."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "Instruments of toil."
msgstr "Инструменты труда."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "I don't mind getting my hands dirty with this."
msgstr "Я не против, запачкать этим руки."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "Spicy."
msgstr "Пряно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "Aromatic."
msgstr "Ароматно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "That's not growing back anytime soon."
msgstr "В ближайшее время он не вырастет."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "That will spice things up."
msgstr "Это сделает всё более пряным."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "A sickly sweet aroma wafts from its branches."
msgstr "От его ветвей доносится слабый сладковатый аромат."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "It won't produce sap now."
msgstr "У него больше нет сока."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "Well it's ruined now."
msgstr "Сейчас оно разрушено."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "It is filling. Ever so slowly."
msgstr "Оно наполняется. О-о-очень медленно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "The sap is ready for collection."
msgstr "Сок к сбору готов."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "This tree has seen better days."
msgstr "Эти деревья видели лучшие дни."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "Don't touch the suit."
msgstr "Не трогай костюм."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "Charmed, I'm sure."
msgstr "Заколдован, я уверен."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "Fast asleep."
msgstr "Крепко спит."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "It could use renovations."
msgstr "Его бы подремонтировать."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "It's been a long time since this stood properly."
msgstr "Прошло много времени с его постройки."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Cooking syrup. Of course."
msgstr "Кулинарный сироп. Конечно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO"
msgid "It's a red, red tomato."
msgstr "Это красный помидор."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "It's a red, red roasted tomato."
msgstr "Это красный жареный помидор."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Должен ли я их посадить?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "Good day to you, sir."
msgstr "Хорошего вам дня, сэр."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "I tip my hat to you sir."
msgstr "Снимаю шляпу перед вами, сэр."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP"
msgid "It's a big, bulbous turnip."
msgstr "Большая луковица."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Hardly improves the taste."
msgstr "Вряд ли улучшает вкус."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Должен ли я их посадить?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_WHEAT"
msgid "This would be more useful as flour."
msgstr "Будет более полезна в качестве муки."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Должен ли я их посадить?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBIT.GENERIC"
msgid "I've been here too long... it actually looks tasty."
msgstr "Я пробыл здесь слишком долго - он уже выглядит аппетитно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBIT.HELD"
msgid "Don't worry, rabbit. Everything is under control."
msgstr "Не волнуйся, кролик. Всё под контролем."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHAT"
msgid "The rabbit goes in the hat, not on it. Preposterous."
msgstr "Кролик должен сидеть в шляпе, а не на ней. Как нелепо."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOLE.GENERIC"
msgid "There's a world going on under there."
msgstr "Под ней целый мир."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOLE.SPRING"
msgid "The entrance has collapsed in on itself."
msgstr "Проход засыпался сам по себе."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOUSE.BURNT"
msgid "Cleverness killed the carrot."
msgstr "Символичность погубила эту морковь."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "Oh, isn't that clever."
msgstr "О, ну разве это не символично?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITKINGHORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITKINGHORN"
msgid "I doubt its reliability."
msgstr "Я сомневаюсь в его надёжности."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITKINGHORN_CHEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITKINGHORN_CHEST"
msgid "You think I'd trust their ilk to hold my things?"
msgstr "Думаете, я бы доверил хранить мои вещи таким, как они?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITKINGMINION_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITKINGMINION_BUNNYMAN"
msgid "Tell scallywag Simon I've got a hat he'll never escape from!"
msgstr "Скажите этому негодяю Саймону, что у меня есть шляпа, из которой он никогда не сбежит!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITKINGSPEAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITKINGSPEAR"
msgid "About all they're good for."
msgstr "Только для такого они и годятся."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITKING_AGGRESSIVE"
msgid "Of course Simon's brute cousin fights his battles for him."
msgstr "Ну конечно же, грубый брат Саймона будет участвовать в драках вместо него."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITKING_LUCKY"
msgid "You've embarassed me for the last time, Simon!"
msgstr "Больше ты не опозоришь меня, Саймон!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITKING_PASSIVE"
msgid "Spare me the token gesture. Simon knows what he did."
msgstr "Избавьте меня от этого символического жеста. Саймон и так знает, что он сделал."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINCOAT"
msgid "Out, out rain!"
msgstr "Прочь, дождь!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINHAT"
msgid "Not the most dapper of hats, but quite necessary."
msgstr "Не от кутюр, конечно, зато необходимо."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINOMETER.BURNT"
msgid "The rain did not come in time."
msgstr "Какая ирония, дождь не поспел вовремя."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINOMETER.GENERIC"
msgid "I could just look up and learn the same thing."
msgstr "Я бы мог просто глянуть наверх, чтобы узнать то же самое."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RATATOUILLE"
msgid "Roughage."
msgstr "Деревенская снедь."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAZOR"
msgid "If only the world had a single neck."
msgstr "О, если бы у мира была одна шея."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD"
msgid "Destroy it!"
msgstr "Уничтожьте это!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_BALATRO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_BALATRO"
msgid "The jovial sound invades my mind. Keep it off."
msgstr "Этот весёлый звук словно вторгается в мой разум. Выключите его."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_CREEPYFOREST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_CREEPYFOREST"
msgid "Forgive me if I've lost my taste for music."
msgstr "Простите, если я потерял вкус к музыке."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_DANGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_DANGER"
msgid "Silence would be preferable."
msgstr "Тишина была бы предпочтительнее."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_DAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_DAWN"
msgid "Forgive me if I've lost my taste for music."
msgstr "Простите, если я потерял вкус к музыке."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_DRSTYLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_DRSTYLE"
msgid "Silence would be preferable."
msgstr "Тишина была бы предпочтительнее."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_DUSK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_DUSK"
msgid "Silence would be preferable."
msgstr "Тишина была бы предпочтительнее."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_EFS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_EFS"
msgid "Silence would be preferable."
msgstr "Тишина была бы предпочтительнее."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_END
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_END"
msgid "Forgive me if I've lost my taste for music."
msgstr "Простите, если я потерял вкус к музыке."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_HALLOWEDNIGHTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_HALLOWEDNIGHTS"
msgid "Ugh, no more."
msgstr "Ох, да хватит уже."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_MAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_MAIN"
msgid "Silence would be preferable."
msgstr "Тишина была бы предпочтительнее."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_WORKTOBEDONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RECORD_WORKTOBEDONE"
msgid "Forgive me if I've lost my taste for music."
msgstr "Простите, если я потерял вкус к музыке."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDGEM"
msgid "Red brings fire."
msgstr "Красный приносит огонь."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDLANTERN"
msgid "Not having a light would certainly be unlucky."
msgstr "Не излучает свет, не повезло, конечно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDMOONEYE"
msgid "Its aura can be felt from anywhere. Quite useful."
msgstr "Я чувствую его ауру отовсюду. Может пригодиться."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDPOUCH"
msgid "A spot of luck."
msgstr "Случай удачи."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_CAP"
msgid "I forget what this one does."
msgstr "Я забыл, что он делает."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_CAP_COOKED"
msgid "Kind of bitter."
msgstr "Довольно горький."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "It's a red mushroom."
msgstr "Это красный гриб."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "It'll have to come back for it."
msgstr "Мне придётся вернуться за ним."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "It's all used up."
msgstr "Больше ничего не осталось."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.BURNING"
msgid "Oops."
msgstr "Упс."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.GENERIC"
msgid "There's wind in them there willows."
msgstr "Там ветер в них, там ивы."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.PICKED"
msgid "No more tubes."
msgstr "Ничего полезного не осталось."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REFINED_DUST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REFINED_DUST"
msgid "It may have some alchemical uses."
msgstr "Он может иметь некоторые алхимические применения."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REFLECTIVEVEST"
msgid "Safety before dapperness."
msgstr "Безопасность превыше стиля. Иногда."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RELIC"
msgid "Remnants of an extinct civilization."
msgstr "Следы древних цивилизаций."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB.BURNT"
msgid "The fire learned how to burn it down."
msgstr "Огонь изучил, как спалить всё дотла."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "I can't believe I forgot how to build those things."
msgstr "Подумать только, и я забыл, как строить эти штуки."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "Flames have swallowed it whole."
msgstr "Пламя проглотило её не жуя."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "It unlocks recipes of middling utility."
msgstr "Она раскрывает секреты средней сложности и необходимости."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "Research complete."
msgstr "Исследование завершено."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "This is where I do my own personal research."
msgstr "Вот тут я и занимаюсь своим собственным исследованием."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "That was its final act."
msgstr "Это была её финальная глава."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "Quite a dapper machine."
msgstr "Вполне стильное устройство."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESKIN_TOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESKIN_TOOL"
msgid "Presto change-o! Ahem... old habit."
msgstr "Вуаля! Кхм... старая привычка."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "No one will be using that any longer."
msgstr "Никто этим больше не воспользуется."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "I'm not above using this."
msgstr "Я не настолько горд, чтобы отказаться от этого."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTONE"
msgid "There's a story behind that..."
msgstr "У него богатая история..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REVIVER"
msgid "I'm not sure I really want to give this up."
msgstr "Вот уж не уверен, что хочу этим делиться."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RHINODRILL"
msgid "Brutish grotesquerie."
msgstr "Брутальные гротески."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROASTTURKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROASTTURKEY"
msgid "I myself will carve this roast beast."
msgstr "Я лично разделаю этого жареного зверя."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN.GENERIC"
msgid "The redbird comes from the fire lands."
msgstr "Огненные птицы живут в Огненных Землях."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN.HELD"
msgid "Silence, bird!"
msgstr "Молчать, птица!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "You're new."
msgstr "А вот это что-то новенькое!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN_WINTER.HELD"
msgid "Nothing up my sleeve..."
msgstr "Ещё живая?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBOT_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBOT_BLUEPRINT"
msgid "Is this the robot's doing?"
msgstr "Неужели это дело рук робота?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBOT_PUPPET"
msgid "Better them than me."
msgstr "Лучше они, чем я."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK"
msgid "It's a rock."
msgstr "Это камень."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCKS"
msgid "Hmmm. Now what do I do with them?"
msgstr "Хм-м-м. Ну и что мне с ними делать?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCKY"
msgid "I banished these guys down here for a reason."
msgstr "Я изгнал этих парней сюда не просто так."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN"
msgid "It is fruitless and useless now."
msgstr "Теперь она бесплодна и бесполезна."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING"
msgid "Well that's a shame."
msgstr "Ну, это позор."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
msgid "It's ill."
msgstr "Он болен."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING"
msgid "I think it's sick or something."
msgstr "Я думаю, что он болен или что-то в этом роде."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
msgid "It labors to make my dinner."
msgstr "Он трудится, чтобы приготовить мне обед."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED"
msgid "What use are you to me if you don't have fruit?"
msgstr "Какая мне от тебя польза, если у тебя нет фруктов?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED"
msgid "It resembles Woodie, does it not?"
msgstr "Он похож на Вуди, не так ли?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_FRUIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_FRUIT"
msgid "I'd rather not shatter my teeth on that."
msgstr "Я бы предпочел не ломать об него зубы."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
msgid "It's ripe enough to eat now."
msgstr "Он уже достаточно созрел, чтобы его съесть."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED"
msgid "It looks almost appetizing."
msgstr "Это выглядит почти аппетитно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT"
msgid "How off-putting. It's grown a sprout."
msgstr "Как отталкивающе. Он уже пророс."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE.GENERIC"
msgid "I could get a chip of ice off the old block."
msgstr "Я могу наскрести пару кусочков льда из этой старой глыбы."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE.MELTED"
msgid "It's just a puddle."
msgstr "Это просто лужа какая-то."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE_MELTED"
msgid "It's just a puddle."
msgstr "Это просто лужа какая-то."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "The top of this lava pit has cooled into a fine crust."
msgstr "Верх этого очага остыл и покрылся равномерной коркой."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.LOW"
msgid "The fires are cooling."
msgstr "Пламя остывает."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "It's hot."
msgstr "Жарко."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.OUT"
msgid "It looks harmless."
msgstr "Выглядит безопасно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_MOON"
msgid "\"Moon\" rock."
msgstr "Лунный камень."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "I think it looks much better this way."
msgstr "Я думаю, так оно смотрится гораздо лучше."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "I think it looks much better this way."
msgstr "Я думаю, так оно смотрится гораздо лучше."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROOK"
msgid "A castle for my home."
msgstr "Башня подошла бы к моему дому."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROOK_NIGHTMARE"
msgid "The builders have left it in a state of abandonment."
msgstr "Создатель окончательно её забросил."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROPE"
msgid "You'd think this would have more uses."
msgstr "Можно подумать, у неё может быть ещё какое-то применение."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROPE_BRIDGE_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROPE_BRIDGE_KIT"
msgid "Ugh. You have to build it?!"
msgstr "Угх. Его ещё и строить?!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROSEGLASSESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROSEGLASSESHAT.GENERIC"
msgid "Are you prepared for what you'll find?"
msgstr "Готова ли она к тому, что её ждёт?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROTTENEGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROTTENEGG.GENERIC"
msgid "Disgusting. Why keep this around?"
msgstr "Омерзительно. Зачем я это с собой таскаю?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROYAL_JELLY"
msgid "Unsettlingly wobbly."
msgstr "Оно немного покачивается."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUBBLE"
msgid "Everything eventually turns to dust."
msgstr "Одни только кусочки да обломки."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINSHAT"
msgid "Fuel must flow."
msgstr "Топливо должно течь."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINS_BAT"
msgid "The fuel runs deep in this."
msgstr "Она впитала топливо до последней капли."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINS_RUBBLE"
msgid "A broken relic."
msgstr "Это... разбитая реликвия."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "A relic best forgotten."
msgstr "Забытая реликия."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "It seems I am to be judged."
msgstr "Кажется, меня осуждают."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLEHORN"
msgid "And I may never put it back on."
msgstr "Ну да, а потом я замучаюсь надевать его снова."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_BASIC"
msgid "But that means I'd have to touch the smelly thing."
msgstr "Это что, значит, что мне придётся прикасаться к этим смердящим созданиям?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_RACE"
msgid "But is it fast enough to escape the judgmental stares?"
msgstr "С ним можно упорхать от всех проблем?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_SHADOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_SHADOW"
msgid "I hate it."
msgstr "Ненавижу."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_WAR"
msgid "At least it affords some dignity to the rider."
msgstr "Как минимум, оно придаёт наезднику величественный вид."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_WATHGRITHR"
msgid "I suppose the beast deserves a bit of protection."
msgstr "Полагаю, зверь тоже заслуживает немного защиты."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALSA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALSA"
msgid "A bit spicy for my delicate palate."
msgstr "Слегка островат для моего деликатного вкуса."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTBOX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTBOX"
msgid "This will extend the life of our supplies somewhat."
msgstr "Это несколько продлит срок службы наших запасов."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTLICK"
msgid "So salty."
msgstr "Солёный."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTLICK_IMPROVED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTLICK_IMPROVED"
msgid "Blech, it's covered in beefalo spit."
msgstr "Фу, он весь в слюнях бифало."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTROCK"
msgid "Am I to be a salt miner now?"
msgstr "Неужели теперь я стану добытчиком соли?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTSTACK.GENERIC"
msgid "Odd..."
msgstr "Странно..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTSTACK.GROWING"
msgid "It seems to be growing back..."
msgstr "Кажется, он снова растет..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTSTACK.MINED_OUT"
msgid "It's been mined down to nothing."
msgstr "Он был добыт почти до нуля."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTY_DOG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTY_DOG"
msgid "Don't you DARE shake seawater all over my suit!"
msgstr "Не смей стряхивать морскую воду на мой костюм!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTY_DOGHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTY_DOGHAT"
msgid "It conveys an air of authority. I think it suits me."
msgstr "Придаёт мне авторитетный вид. Думаю, мне это к лицу."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANDBLOCK"
msgid "Impressive."
msgstr "Впечатляет."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANDSPIKE"
msgid "That was quite impolite."
msgstr "Это было довольно невежливо."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANITYROCK.ACTIVE"
msgid "I can see its true nature now!"
msgstr "Теперь я вижу его истинную природу!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANITYROCK.INACTIVE"
msgid "There are two ways to see that obstacle."
msgstr "Есть два способа увидеть это препятствие."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.BURNING"
msgid "Oops."
msgstr "Упс."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.DISEASED"
msgid "What has brought this blight upon my world?"
msgstr "Как эта зараза попала в мой мир?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.DISEASING"
msgid "Looks a little off, if you ask me."
msgstr "Выглядит как-то не так."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.GENERIC"
msgid "A supple, woody stem."
msgstr "Гибкий древесный ствол."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.PICKED"
msgid "It'll grow back."
msgstr "Вырастет ещё."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.WITHERED"
msgid "Nothing survives in this heat."
msgstr "Ничему не выжить на такой жаре."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCANDATA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCANDATA"
msgid "Well... fine. I suppose that sums it all up, more or less."
msgstr "Что ж... ладно. Полагаю, они подводят итоги."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.BURNING"
msgid "Nothing is safe."
msgstr "Ничто не безопасно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.BURNT"
msgid "The scarecrow has gone to a place where there is no fear."
msgstr "Пугало отправилось в место, где нет страха."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.GENERIC"
msgid "It's an empty shell of a man."
msgstr "Это пустая оболочка человека."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCORCHED_SKELETON"
msgid "At least the fire cut down on the smell."
msgstr "По крайней мере, огонь выжег смрад."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCRAPBOOK_PAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCRAPBOOK_PAGE"
msgid "Curious. It may yield some useful information."
msgstr "Любопытно. В ней может содержаться полезная информация."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCRAPHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCRAPHAT"
msgid "Can you really call that pile of refuse a hat?"
msgstr "Можно ли правда назвать эту кучу отходов шляпой?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCRAP_MONOCLEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCRAP_MONOCLEHAT"
msgid "I don't need glasses! Who told you I need glasses?"
msgstr "Мне не нужны очки! Кто тебе сказал, что мне нужны очки?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "How I've missed the act of creation."
msgstr "Как я пропустил момент создания?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "To sculpt, to carve, no more."
msgstr "Лепить, вырезать, не более."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "A block of marble might suffice."
msgstr "На нём можно разместить мрамор."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "Ah, yes. Not terrible."
msgstr "Ах да. Не страшно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "Hmph. I was never a fan of the Grecian look."
msgstr "Хм-м-м. Я никогда не был последователем греческих взглядов."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "That looks much better."
msgstr "Я думаю, так гораздо лучше."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "We'll get you out in a tick, friend."
msgstr "Мы вытащим тебя, друг."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "Come now! I liked that one."
msgstr "Ну-ка! Мне нравится."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "I've seen that head before... but never in marble."
msgstr "Я видел эту голову раньше... но не из мрамора."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "Waste of good marble if you ask me."
msgstr "Трата хорошего мрамора."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "Back as intended."
msgstr "Готово."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "We'll get you out in a tick, friend."
msgstr "Мы вытащим тебя, друг."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "My creations! How rude."
msgstr "Мои творения! Как грубо."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "That looks... familiar..."
msgstr "Выглядит... знакомо..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "Some truly questionable taste in decor."
msgstr "Некоторые действительно на сомнительный вкус."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "Doesn't that feel better now?"
msgstr "Разве, так не лучше?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "We'll get you out in a tick, friend."
msgstr "Мы вытащим тебя, друг."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "Why would anyone want to cover this up?"
msgstr "Зачем кому-то скрывать это?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "That's quite the schnozz."
msgstr "У неё огромный нос."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "Well, it's useless now."
msgstr "Что ж, теперь он бесполезен."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "Now to see if Higgsbury's ideas hold water."
msgstr "А теперь посмотрим, выдержат ли идеи Хиггсбери критику."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEAFOODGUMBO"
msgid "It looks passable."
msgstr "Это выглядит сносно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEASTACK"
msgid "It would be easy to wreck a vessel on one of those."
msgstr "Об них с лёгкостью можно разбить своё судно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SECURITY_PULSE_CAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SECURITY_PULSE_CAGE"
msgid "It's empty. Someone do something."
msgstr "Там пусто. Кто-нибудь, сделайте что-нибудь."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SECURITY_PULSE_CAGE_FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SECURITY_PULSE_CAGE_FULL"
msgid "It's full. Someone do something."
msgstr "Он полон. Кто-нибудь, сделайте что-нибудь."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEEDPOUCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEEDPOUCH"
msgid "One more thing to lug from place to place."
msgstr "Ещё одна вещь, которую нужно таскать с места на место."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEEDS"
msgid "I suppose these won't plant themselves."
msgstr "Я думаю, сами себя они не посадят."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEEDS_COOKED"
msgid "Broiled the life out of 'em."
msgstr "Я выжег из них жизнь."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SENTRYWARD"
msgid "This is a conduit for strong revelatory magicks."
msgstr "Эта магия прольёт свет на местность."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEWING_KIT"
msgid "A fine and noble endeavor."
msgstr "Достойное, благородное начинание."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEWING_MANNEQUIN.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEWING_MANNEQUIN.BURNT"
msgid "Someone should clean that up."
msgstr "Кто-то должен это убрать."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEWING_MANNEQUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEWING_MANNEQUIN.GENERIC"
msgid "Finally, someone who'll carry my things."
msgstr "Наконец-то появился кто-то, кто будет держать мои вещи."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEWING_TAPE"
msgid "The wilderness is tough on a tailor made suit."
msgstr "В дикой природе тяжело сшить из этого костюм."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWDANCER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWDANCER"
msgid "What have I become."
msgstr "Кем я стал?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWDIGGER"
msgid "I'm a shadow of myself. Ha-ha!"
msgstr "Я — тень самого себя. Ха-ха!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWHEART"
msgid "A pulse of malice and betrayal beats within."
msgstr "Импульс злобы и предательства бьется внутри."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWRIFT_PORTAL"
msgid "Mind the gap."
msgstr "Осторожнее, расщелина."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY"
msgid "It doesn't intimidate me."
msgstr "Меня этим не испугаешь."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED"
msgid "That was too easy."
msgstr "Было слишком легко."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD"
msgid "Yes, I see you."
msgstr "Да, я тебя вижу."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWTHRALL_HANDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWTHRALL_HANDS"
msgid "You think you're the master of sleight of hand?"
msgstr "Думаешь, что ты тут мастер ловкости рук?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWTHRALL_HORNS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWTHRALL_HORNS"
msgid "I'll leave a bitter taste in your mouth, pal."
msgstr "Я оставлю горький привкус у тебя во рту, приятель."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWTHRALL_MOUTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWTHRALL_MOUTH"
msgid "What are you smiling at, pal?"
msgstr "Отчего такая ухмылка, приятель?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWTHRALL_PARASITE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWTHRALL_PARASITE"
msgid "An unwelcome guest."
msgstr "Незваный гость."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWTHRALL_WINGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWTHRALL_WINGS"
msgid "You think you can look down on me?"
msgstr "Думаешь, что можешь смотреть на меня свысока?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOW_BATTLEAXE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOW_BATTLEAXE"
msgid "Lovely."
msgstr "Миленько."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOW_BEEF_BELL"
msgid "This is some decent magic."
msgstr "Неплохая такая магия."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOW_FORGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOW_FORGE"
msgid "What shall I fashion from the shadows?"
msgstr "Что мне вылепить из теней?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOW_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOW_FORGE_KIT"
msgid "There is work to be done."
msgstr "Есть над чем поработать."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOW_HEART_VEIN"
msgid "And yet it offers gifts from below."
msgstr "Из хорошего, оно предлагает дары подземелья."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHALLOW_GRAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHALLOW_GRAVE"
msgid "Fancy..."
msgstr "Шикарно..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHARK"
msgid "What a nasty creature. I wish I'd thought of it."
msgstr "Что за мерзкое создание. Жаль, что я о таком не подумал раньше."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHARKBOI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHARKBOI"
msgid "Who dreamed up this icy abomination?"
msgstr "Кто придумал это ледяное чудище?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELLWEAVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELLWEAVER"
msgid "It may just manage to make something useful."
msgstr "Возможно, из этого получится что-то полезное."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELL_CLUSTER"
msgid "That was not worth the effort."
msgstr "Но это не стоило таких усилий."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHIELDOFTERROR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHIELDOFTERROR"
msgid "At least dealing with that monstrosity was good for something."
msgstr "По крайней мере, иметь дело с этими чудовищами было хоть для чего-то полезно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHOVEL"
msgid "This is some real advanced technology."
msgstr "Вот это и впрямь продвинутая технология."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHOVEL_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHOVEL_LUNARPLANT"
msgid "I'd rather let someone else do my dirty work."
msgstr "Я бы предпочёл, чтобы кто нибудь другой делал за меня грязную работу."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHROOMBAIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHROOMBAIT"
msgid "Wilson should try it."
msgstr "Пусть Уилсон попробует."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHROOMCAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHROOMCAKE"
msgid "I suppose I've eaten worse."
msgstr "Думаю, я ел и похуже."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHROOM_SKIN"
msgid "I hope the warts are not contagious."
msgstr "Я надеюсь, что они не заразны."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SIESTAHUT.BURNT"
msgid "So much for the shade thing."
msgstr "Многовато всего, как для штуки, создававшей тень."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SIESTAHUT.GENERIC"
msgid "Rustic, but excellent shade."
msgstr "Грубоватое, зато надёжное укрытие от зноя."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SILK"
msgid "Despite its origin, it could make some fine garments."
msgstr "Несмотря на её природу, из неё можно сделать неплохую одежду."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC"
msgid "Hm?"
msgstr "Хм?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC"
msgid "No, go on, keep playing that same note. It's not irritating at all."
msgstr "Нет, продолжай играть ту же самую ноту. Это совсем не раздражает."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC"
msgid "I've quite lost my taste for music."
msgstr "Я совсем потерял вкус к музыке."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SISTURN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SISTURN.GENERIC"
msgid "I can't help but wonder... no, it couldn't be."
msgstr "Я не могу не задаться вопросом... нет, этого не может быть."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SISTURN.LOTS_OF_FLOWERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SISTURN.LOTS_OF_FLOWERS"
msgid "It has a strangely calming effect."
msgstr "Он оказывает странное успокаивающее действие."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM"
msgid "What an odd noise."
msgstr "Какой странный звук."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL"
msgid "Stop attacking my mind!"
msgstr "Хватит нападать на мой разум!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SISTURN.SOME_FLOWERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SISTURN.SOME_FLOWERS"
msgid "Perhaps I should pay my respects as well."
msgstr "Наверное, мне тоже стоит проявить уважение."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON"
msgid "Ha! I remember that one."
msgstr "Ха! Я помню этого."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETONHAT"
msgid "A most tragic and unfitting end."
msgstr "Самый трагический и неуместный конец."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_NOTPLAYER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_NOTPLAYER"
msgid "You're not of much use to me now, are you?"
msgstr "От тебя теперь мало пользы, да?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.DEFAULT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.DEFAULT"
msgid "A pity, %s. So ill-prepared for %s."
msgstr "Бедолага %s. Не стоит недооценивать такие вещи, как [def=%s|shenenigans=проявления собственной глупости|hunger=голод|hot=перегрев|cold=холод|fire=огонь]."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.FEMALE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.FEMALE"
msgid "A pity, %s. She was not prepared for %s."
