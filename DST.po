msgstr "Тебе бы не помешало нарастить немного мяса на костях. У тебя же есть кости?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_TOOTH"
msgid "Aw. That's a baby tooth."
msgstr "О. Это детский зубик."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVASPIT.COOL"
msgid "Just a rock, now."
msgstr "Теперь это просто камень."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVASPIT.HOT"
msgid "Woah! Hot potato!"
msgstr "Ой! Горячая картошка!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVA_POND"
msgid "Lava!"
msgstr "Лава!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVA_POND_ROCK"
msgid "That... is a rock."
msgstr "Это... камень."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFLOAF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFLOAF"
msgid "It's hard to pin down the flavor..."
msgstr "Трудно определить вкус..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFYMEATBURGER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFYMEATBURGER"
msgid "It's not like any burger I've ever tried."
msgstr "Это не похоже ни на один бургер, который я когда-либо пробовала."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFYMEATSOUFFLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFYMEATSOUFFLE"
msgid "Well... I guess it's creative."
msgstr "Ну... Я думаю, это творческий подход."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF"
msgid "The trees have eyes!!"
msgstr "У деревьев есть глаза!!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF_IDOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF_IDOL"
msgid "That's some quality carving, there."
msgstr "Довольно качественная работа по дереву."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF_SPARSE"
msgid "Back off, you lumbering lumber!"
msgstr "Отвали ты, лесозаготовка ходячая!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LICHEN"
msgid "Not to my lichen. Ha!"
msgstr "Не для моего лишайника. Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIFEINJECTOR"
msgid "I've never taken a sick day in my life."
msgstr "Я и дня не проболела за всю жизнь."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTBULB"
