msgstr "Теперь это скорее увлажнялка..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "Now we're just watering it."
msgstr "Теперь мы просто поливаем их."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
