msgstr "Волоски на усах Вольфганга встают дыбом!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_STATIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_STATIC"
msgid "Is tiny jumpy spark-thing."
msgstr "Это крошечная прыгучая искра."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_STATIC_CATCHER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_STATIC_CATCHER"
msgid "Wolfgang see nothing inside."
msgstr "Вольфганг не видит ничего внутри."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_STATIC_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_STATIC_ITEM"
msgid "Ha! Tiny spark is too weak to break out!"
msgstr "Ха! Крошечная искра слишком слаба, чтобы вспыхнуть!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_STATIC_ROAMER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_STATIC_ROAMER"
