msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINONA_MACHINEPARTS_1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINONA_MACHINEPARTS_1"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINONA_MACHINEPARTS_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINONA_MACHINEPARTS_2"
