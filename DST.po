msgstr "Вот это крепкое варево!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SOIL_AMENDER.STALE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SOIL_AMENDER.STALE"
