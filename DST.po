msgstr "Ха-ха, ДА! %s!!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORTOX.GENERIC"
