msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_dronedeliverysmall_item_jewelbox"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.wx78_dronedeliverysmall_jewelbox
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_dronedeliverysmall_jewelbox"
msgid "A mechanical overlord's treasures demand delivery in due style."
msgstr "Сокровища механического оверлорда требуют подобающей доставки."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_dronescout_gothic
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_dronescout_gothic"
msgid "It feels at home in the fog and mist of lands unknown."
msgstr "Туман и мгла неизведанных земель ему как дом родной."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_dronescout_jewelbox
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_dronescout_jewelbox"
msgid "Too fancy for exploring, yet explore it must!"
msgstr "Слишком шикарен для разведки, но если надо — разведует!"

#. STRINGS.SKIN_DESCRIPTIONS.wx78_dronezap_gothic
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_dronezap_gothic"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.wx78_dronezap_gothic_overlay
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_dronezap_gothic_overlay"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.wx78_dronezap_jewelbox
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_dronezap_jewelbox"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.wx78_dronezap_jewelbox_overlay
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_dronezap_jewelbox_overlay"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.wx78_dronezapremote_gothic
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_dronezapremote_gothic"
msgid "Let the fleshlings feel watched, then shock them when they least expect it!"
msgstr "Проследи за этими слабаками, а в самый неожиданный момент — шокируй их!"

#. STRINGS.SKIN_DESCRIPTIONS.wx78_dronezapremote_jewelbox
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_dronezapremote_jewelbox"
msgid "An opulent interface befitting a mechanical overlord."
msgstr "Роскошный интерфейс, под стать механическому оверлорду."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_formal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_formal"
msgid "ERROR: DO NOT RECOGNIZE COMMAND \"MOUSTACHE.TWIRL\""
msgstr "ОШИБКА: КОМАНДА \"УСЫ.ЗАКРУТИТЬ\" НЕ РАСПОЗНАНА"

#. STRINGS.SKIN_DESCRIPTIONS.wx78_formalp
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_formalp"
msgid "ERROR: DO NOT RECOGNIZE COMMAND \"MOUSTACHE.TWIRL\""
msgstr "ОШИБКА: КОМАНДА \"УСЫ.ЗАКРУТИТЬ\" НЕ РАСПОЗНАНА"

#. STRINGS.SKIN_DESCRIPTIONS.wx78_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_gladiator"
msgid "WX-78's transformation into an organic killing machine proves all dreams are possible, if you only believe."
msgstr "Преобразование WX-78 в органическую машину для убийства доказывает, что всё возможно, если в это поверить."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_ice"
msgid "This frozen automaton cares for nothing but cold hard logic."
msgstr "Этот заледенелый автоматон не заботится ни о чём, кроме жёсткой холодной логики."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_lunar"
msgid "Cold. Lifeless. Perfect."
msgstr "Холодный. Безжизненный. Идеальный."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_magma"
msgid "WX-78 is big on incineration."
msgstr "WX-78 знает толк в сжигании."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_masquerade
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_masquerade"
msgid "A gleaming testament to WX-78's unchallenged supremacy, and a reminder of their inevitable reign."
msgstr "Сверкающее свидетельство неоспоримого превосходства WX-78."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_moduleremover_gothic
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_moduleremover_gothic"
msgid "A dread instrument for self-surgery."
msgstr "Ужасающий инструмент для самосборки."

#. STRINGS.SKIN_DESCRIPTIONS.wx78_moduleremover_jewelbox
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wx78_moduleremover_jewelbox"
