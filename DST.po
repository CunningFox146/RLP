#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC"
