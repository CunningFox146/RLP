#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_METEOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_METEOR"
msgid "A patch of ground."
msgstr "Кусок земли."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_MONKEY_GROUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_MONKEY_GROUND"
