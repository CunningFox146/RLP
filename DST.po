msgstr "Кусок земли."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_COTL_BRICK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_COTL_BRICK"
