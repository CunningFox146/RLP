msgstr "Давайте готовить!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_POT_SYRUP"
