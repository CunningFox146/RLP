msgid "What is this? Meat for baby man?"
msgstr "Что это такое? Мясо для ребёнка?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLANTMEAT_COOKED"
msgid "Is slightly better now."
msgstr "Теперь оно немного лучше."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLANTREGISTRYHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLANTREGISTRYHAT"
msgid "Is helmet for gardening?"
msgstr "Шлем для садоводства?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "Leafy!"
msgstr "С листьями!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "Is still growing."
msgstr "Всё ещё растёт."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLANT_NORMAL.READY"
msgid "Mmmm. Is tasty now."
msgstr "М-м-м-м. Теперь оно вкусное."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "Is sad and dried plant."
msgstr "Грустное и засохшее растение."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYBILL_THE_DOLL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYBILL_THE_DOLL"
msgid "Is very hard to remember so many words."
msgstr "Очень трудно запомнить так много слов."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYBILL_THE_PRINCESS_YOTH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYBILL_THE_PRINCESS_YOTH"
msgid "A horsey story. Beautiful."
msgstr "Сказка про лошадей. Здорово."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYBILL_THE_VAULT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYBILL_THE_VAULT"
msgid "Is too much for Wolfgang."
msgstr "Это слишком много для Вольфганга."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYBILL_THE_VEIL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYBILL_THE_VEIL"
msgid "Wolfgang not afraid watch, just don't feel like it."
msgstr "Вольфганг вовсе не боится смотреть, просто не хочет."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYER.ATTACKER"
msgid "Does %s want to fight?"
msgstr "%s хочет подраться?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYER.FIRESTARTER"
msgid "%s is lighting burny fires!"
msgstr "%s ярко светится!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYER.GENERIC"
msgid "Is tiny %s! Hello!"
msgstr "Крошечный %s! Привет!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYER.GHOST"
msgid "Wolfgang will get raw pump-y heart for you!"
msgstr "Вольфганг достанет для тебя сердце!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYER.MURDERER"
msgid "%s is killer!"
msgstr "%s - убийца!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYER.REVIVER"
msgid "%s is nice person."
msgstr "%s - хороший человек."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYER_HOSTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYER_HOSTED.GENERIC"
msgid "Hello? Do you remember Wolfgang?"
msgstr "Привет? Ты помнишь Вольфганга?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYER_HOSTED.ME
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYER_HOSTED.ME"
msgid "Poor Wolfgang!"
msgstr "Бедный Вольфганг!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYING_CARD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PLAYING_CARD"
msgid "Don't worry little card, Wolfgang only rip in half full deck."
msgstr "Не волнуйся, маленькая карточка, Вольфганг разрывает только полные колоды."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.POCKETWATCH_DISMANTLER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.POCKETWATCH_DISMANTLER"
msgid "These tools too tiny for Wolfgang's mighty hands!"
msgstr "Эти инструменты слишком крошечные для могучих рук Вольфганга!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.POCKETWATCH_HEAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.POCKETWATCH_HEAL.GENERIC"
msgid "Is just little clock."
msgstr "Просто маленькие часики."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.POCKETWATCH_HEAL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.POCKETWATCH_HEAL.RECHARGING"
msgid "Little clock sleeps now."
msgstr "Сейчас часики спят."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.POCKETWATCH_PARTS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.POCKETWATCH_PARTS"
msgid "Is jumble of tiny clock things."
msgstr "Куча маленьких частей часов."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.POCKETWATCH_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.POCKETWATCH_PORTAL.GENERIC"
