msgstr "Готов к обеденному столу."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALT"
msgid "It's full of salt."
msgstr "Оно очень солёное."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "Salt. The tastiest mineral."
msgstr "Соль. Самый вкусный минерал."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "Science takes time."
msgstr "Наука требует времени."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "Salt has gathered on the rope."
msgstr "Соль собралась на верёвке."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
