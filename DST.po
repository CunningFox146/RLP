msgid "Tenebrous"
msgstr "мрачно"

#. STRINGS.SHADOWTHRALL_PARASITE_CHANT.20
msgctxt "STRINGS.SHADOWTHRALL_PARASITE_CHANT.20"
msgid "No pain"
msgstr "нет боли"

#. STRINGS.SHADOWTHRALL_PARASITE_CHANT.21
msgctxt "STRINGS.SHADOWTHRALL_PARASITE_CHANT.21"
msgid "No feel"
msgstr "нет чувств"

#. STRINGS.SHADOWTHRALL_PARASITE_CHANT.22
msgctxt "STRINGS.SHADOWTHRALL_PARASITE_CHANT.22"
msgid "Forever we"
msgstr "навечно мы"

#. STRINGS.SHADOWTHRALL_PARASITE_CHANT.23
msgctxt "STRINGS.SHADOWTHRALL_PARASITE_CHANT.23"
