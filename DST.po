msgstr "Они определённо ненавидят этих ползучих теней."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GESTALT_GUARD_EVOLVED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GESTALT_GUARD_EVOLVED"
