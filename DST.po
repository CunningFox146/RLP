msgstr "Ха! Попался!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GESTALT_CAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GESTALT_CAGE.GENERIC"
