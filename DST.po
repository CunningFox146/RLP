msgstr "Сделал хороший парус из птичьих перьев!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST_YOTD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST_YOTD"
