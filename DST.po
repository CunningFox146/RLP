msgstr "Ещё один вид дёрна."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_RUINSTILES_GLOW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_RUINSTILES_GLOW"
msgid "Yet another ground type."
msgstr "Ещё один вид дёрна."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_RUINSTRIM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_RUINSTRIM"
