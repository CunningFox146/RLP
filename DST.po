#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC"
