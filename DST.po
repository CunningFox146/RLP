msgstr "Может быть, они захотят торговать."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TURNIP"
