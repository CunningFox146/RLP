msgstr "Оу, сломался!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT"
