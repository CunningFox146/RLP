msgstr "Это начинает наскучивать..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
