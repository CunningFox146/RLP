msgstr "Давай, мясо, сушись уже!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DRYINGINRAIN"
