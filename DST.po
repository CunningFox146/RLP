msgstr "Бедная %s. Она [def=померла, встретившись с %s|shenanigans,hunger=померла от истощения|hot=перегрелась и померла|cold=замёрзла насмерть|fire=сгорела дотла], а?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.MALE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.MALE"
msgid "Poor %s. %s got him, eh?"
msgstr "Бедный %s. Он [def=помер, встретившись с %s|shenanigans,hunger=помер от истощения|hot=перегрелся и помер|cold=замёрз насмерть|fire=сгорел дотла], а?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.ROBOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.ROBOT"
