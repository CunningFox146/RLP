msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "Found you!"
msgstr "Попался!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "There you are!"
msgstr "Вот ты где!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "We found you!"
msgstr "Мы нашли тебя!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "Heehee, gotcha!"
msgstr "Хи-хи, попался!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
