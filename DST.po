msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WINONA_BATTERY_HIGH.BURNING"
msgid "It's on fire!"
msgstr "Оно горит!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WINONA_BATTERY_HIGH.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WINONA_BATTERY_HIGH.BURNT"
msgid "Science couldn't save it."
msgstr "Наука не в силах спасти это."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC"
msgid "Hey! That's not science!"
msgstr "Эй! Это не научно!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER"
