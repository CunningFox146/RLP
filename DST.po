msgstr "Ты настоящий маленький ужас, не так ли?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WURT.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WURT.FIRESTARTER"
msgid "Heh, 'attagirl!"
msgstr "Хех, молодчина!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WURT.GENERIC"
msgid "Hi %s!"
msgstr "Привет, %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WURT.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WURT.GHOST"
