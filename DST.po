msgctxt "STRINGS.UI.USERCOMMANDS.FAILEDFMT"
msgid "You can't run '%s' right now."
msgstr "Вы не можете запустить \"%s\" сейчас."

#. STRINGS.UI.USERCOMMANDS.MISSINGPARAMSFMT
msgctxt "STRINGS.UI.USERCOMMANDS.MISSINGPARAMSFMT"
msgid "Missing parameters! Type /help %s for more info."
